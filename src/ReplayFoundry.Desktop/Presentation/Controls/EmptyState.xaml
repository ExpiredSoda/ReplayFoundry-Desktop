<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.EmptyState"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    MinHeight="150"
    AutomationProperties.Name="Empty state">
    <StackPanel MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Width="44" Height="44" HorizontalAlignment="Center" Background="{DynamicResource Brush.InteractiveSelected}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="7">
            <controls:IconPath
                Width="22"
                Height="22"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IconKey="{Binding IconKey, ElementName=Root}"
                Stroke="{DynamicResource Brush.StatusInfo}"
                StrokeThickness="1.4"
                Stretch="Uniform" />
        </Border>
        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.SectionTitle}" Text="{Binding Title, ElementName=Root}" TextAlignment="Center" />
        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{Binding Description, ElementName=Root}" TextAlignment="Center" />
    </StackPanel>
</UserControl>
