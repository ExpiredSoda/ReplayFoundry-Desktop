<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.EmptyState"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    MinHeight="150"
    AutomationProperties.Name="Empty state">
    <StackPanel MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center">
        <controls:FoundryFrameMark Width="88" Height="76" HorizontalAlignment="Center"
            IconKey="{Binding IconKey, ElementName=Root}" />
        <TextBlock Margin="8,16,8,0" HorizontalAlignment="Center" Style="{DynamicResource Text.SectionTitle}"
            Text="{Binding Title, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Margin="8,8,8,0" HorizontalAlignment="Center" Style="{DynamicResource Text.Body}"
            Text="{Binding Description, ElementName=Root}" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
