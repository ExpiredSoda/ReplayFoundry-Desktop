<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.FoundryPageHeader"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <controls:FoundryFrameMark Width="66" Height="57" Margin="0,0,16,0"
            IconKey="{Binding IconKey, ElementName=Root}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock FontFamily="{DynamicResource Font.Display}" FontSize="26" FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"
                Text="{Binding Title, ElementName=Root}" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}"
                Text="{Binding Description, ElementName=Root}" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
