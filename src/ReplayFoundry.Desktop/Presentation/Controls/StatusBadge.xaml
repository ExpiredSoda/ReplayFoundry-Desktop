<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.StatusBadge"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    AutomationProperties.Name="Status">
    <Border Padding="8,4" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="Transparent" BorderThickness="0" CornerRadius="5">
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" Text="{Binding Text, ElementName=Root}" TextWrapping="Wrap" />
    </Border>
</UserControl>
