<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.UnavailableBanner"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="Unavailable feature">
    <Border Padding="12,10" Background="{DynamicResource Brush.SurfaceInset}" BorderBrush="{DynamicResource Brush.StatusWarning}" BorderThickness="3,0,0,0" CornerRadius="0">
        <StackPanel>
            <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontSize="13" FontWeight="SemiBold" Text="{Binding Title, ElementName=Root}" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}" Text="{Binding Description, ElementName=Root}" />
        </StackPanel>
    </Border>
</UserControl>
