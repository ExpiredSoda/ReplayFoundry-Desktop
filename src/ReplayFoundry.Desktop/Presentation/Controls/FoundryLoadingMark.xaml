<UserControl x:Class="ReplayFoundry.Desktop.Presentation.Controls.FoundryLoadingMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Replay Foundry working">
    <UserControl.Resources>
        <Storyboard x:Key="AssemblyMotion" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoUpperTransform" Storyboard.TargetProperty="X" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-18" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.55" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.45" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-18" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoUpperTransform" Storyboard.TargetProperty="Y" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-14" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.55" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.45" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-14" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLeftTransform" Storyboard.TargetProperty="X" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.8" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.25" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLowerTransform" Storyboard.TargetProperty="X" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.05" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLowerTransform" Storyboard.TargetProperty="Y" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="16" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.05" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="16" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoRightTransform" Storyboard.TargetProperty="X" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.78" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.22" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoRightTransform" Storyboard.TargetProperty="Y" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-14" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.78" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.22" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-14" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoSignal" Storyboard.TargetProperty="Opacity" Duration="0:0:4" RepeatBehavior="Forever">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.32" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="1" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:3.65" Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimation Storyboard.TargetName="OrbitRotation" Storyboard.TargetProperty="Angle"
                From="0" To="360" Duration="0:0:8" RepeatBehavior="Forever" />
        </Storyboard>
    </UserControl.Resources>
    <Viewbox Stretch="Uniform">
        <Grid Width="156" Height="156">
            <Ellipse Width="146" Height="146" Stroke="{DynamicResource Brush.BorderSubtle}" StrokeThickness="1" />
            <Ellipse Width="132" Height="132" Stroke="{DynamicResource Brush.BrandCyan}"
                StrokeThickness="2" StrokeDashArray="2 12" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="OrbitRotation" /></Ellipse.RenderTransform>
            </Ellipse>
            <Border Width="90" Height="90" Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="22">
                <Canvas
                                        Width="56"
                                        Height="56"
                                        AutomationProperties.Name="Replay Foundry logo assembling">
                                        <Border
                                            Width="25"
                                            Height="25"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoUpperTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="25"
                                            Height="24"
                                            Canvas.Left="0"
                                            Canvas.Top="32"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoLeftTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="24"
                                            Height="32"
                                            Canvas.Left="32"
                                            Canvas.Top="24"
                                            Background="{DynamicResource Brush.BrandCyan}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoLowerTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="24"
                                            Height="18"
                                            Canvas.Left="32"
                                            Canvas.Top="0"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoRightTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            x:Name="LogoSignal"
                                            Width="9"
                                            Height="9"
                                            Canvas.Left="9"
                                            Canvas.Top="9"
                                            Background="{DynamicResource Brush.BrandYellow}"
                                            CornerRadius="1"
                                            RenderOptions.EdgeMode="Aliased" />
                                    </Canvas>
            </Border>
        </Grid>
    </Viewbox>
</UserControl>
