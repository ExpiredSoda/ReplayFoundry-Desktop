<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.FoundryFrameMark"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    Focusable="False" IsHitTestVisible="False">
    <Viewbox Stretch="Uniform">
        <Canvas Width="88" Height="76">
            <Rectangle Canvas.Left="21" Canvas.Top="8" Width="54" Height="54"
                RadiusX="9" RadiusY="9" Stroke="{DynamicResource Brush.BorderStrong}" StrokeThickness="1"
                RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform><RotateTransform Angle="9" /></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Canvas.Left="10" Canvas.Top="16" Width="56" Height="54"
                RadiusX="9" RadiusY="9" Fill="{DynamicResource Brush.SurfaceElevated}"
                Stroke="{DynamicResource Brush.BrandCyan}" StrokeThickness="1.2" />
            <Path Data="M 17,31 L 17,23 L 25,23 M 51,62 L 59,62 L 59,54"
                Stroke="{DynamicResource Brush.BrandCyan}" StrokeThickness="1.4" Opacity="0.6" />
            <controls:IconPath Canvas.Left="26" Canvas.Top="31" Width="25" Height="25"
                IconKey="{Binding IconKey, ElementName=Root}" Stroke="{DynamicResource Brush.BrandCyan}"
                StrokeThickness="1.3" />
            <Rectangle Canvas.Left="56" Canvas.Top="24" Width="26" Height="5"
                RadiusX="1" RadiusY="1" Fill="{DynamicResource Brush.BrandYellow}" />
            <Rectangle Canvas.Left="2" Canvas.Top="59" Width="4" Height="4" Fill="{DynamicResource Brush.BrandBlue}" />
            <Rectangle Canvas.Left="2" Canvas.Top="66" Width="4" Height="4" Fill="{DynamicResource Brush.BrandCyan}" />
        </Canvas>
    </Viewbox>
</UserControl>
