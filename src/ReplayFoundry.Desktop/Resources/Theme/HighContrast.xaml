<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Brush.HighContrastWindow" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Brush.HighContrastText" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.HighContrastBorder" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Brush.HighContrastFocus" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
