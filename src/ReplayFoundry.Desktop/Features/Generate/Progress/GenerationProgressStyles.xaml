<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/ReplayFoundry.Desktop;component/Features/Generate/GenerateStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="GenerationProgress.MainPanel" TargetType="Border">
        <Setter Property="MaxWidth" Value="820" />
        <Setter Property="Margin" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfacePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="GenerationProgress.MetaLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GenerationProgress.MetaValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GenerationProgress.ErrorPanel" TargetType="Border">
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="Padding" Value="16,4,0,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusError}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style x:Key="GenerationProgress.CompletionCard" TargetType="Border">
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="Padding" Value="16,4,0,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DockActiveBorder}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
    <Style x:Key="GenerationProgress.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Generate.PrimaryButton}" />
    <Style x:Key="GenerationProgress.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Generate.SecondaryButton}" />
</ResourceDictionary>