<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.Progress.GenerationProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600" d:DesignWidth="980" mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GenerationProgressStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer x:Name="GenerationProgressScrollViewer" CanContentScroll="False"
                  HorizontalContentAlignment="Stretch" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly" VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=GenerationProgressScrollViewer}">
            <Border Style="{StaticResource GenerationProgress.MainPanel}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <controls:FoundryLoadingMark Width="120" Height="120" Margin="0,0,20,0" IsActive="{Binding IsRunning}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="GENERATE" />
                    <TextBlock Margin="0,10,0,0" FontFamily="{DynamicResource Font.Display}" FontSize="26" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Margin="0,10,0,0" FontSize="14" Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding Detail}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource GenerationProgress.MetaValue}" Text="{Binding ModeDisplayName}" Margin="0,0,20,6" />
                        <TextBlock Style="{StaticResource GenerationProgress.MetaLabel}" Text="{Binding SourceSummary}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <ProgressBar Margin="0,18,0,0" AutomationProperties.Name="Generation progress"
                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100"
                                 Style="{DynamicResource Control.ProgressBar.Featured}" Value="{Binding ProgressPercent, Mode=OneWay}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SourceProgressText}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSourceProgress}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Margin="16,0,0,0" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIndeterminate}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Margin="0,14,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="Processing locally on your computer." TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GenerationProgress.ErrorPanel}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFailed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ValidationErrorText}" Text="What happened" />
                            <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource Brush.ValidationErrorText}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                            <Expander Margin="0,12,0,0" Header="More details" Foreground="{DynamicResource Brush.TextSecondary}" Style="{DynamicResource Control.DisclosureExpander}">
                                <TextBox MaxHeight="170" Margin="0,8,0,0" Padding="10"
                                         Background="{DynamicResource Brush.SurfaceCanvas}" BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                         Foreground="{DynamicResource Brush.TextSecondary}" HorizontalScrollBarVisibility="Disabled"
                                         IsReadOnly="True" Text="{Binding TechnicalDetails, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </Expander>
                        </StackPanel>
                    </Border>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GenerationProgress.CompletionCard}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsCancelled}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding CompletionSummary}" TextWrapping="Wrap" />
                    </Border>
                    <WrapPanel Margin="0,24,0,0">
                        <Button Command="{Binding CancelCommand}" Content="{Binding CancelButtonLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GenerationProgress.SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding OpenStudioCommand}" Content="Open in Studio">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GenerationProgress.PrimaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanOpenStudio}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding ReturnToSourceSelectionCommand}" Content="Back to videos">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GenerationProgress.SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanReturnToSourceSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
