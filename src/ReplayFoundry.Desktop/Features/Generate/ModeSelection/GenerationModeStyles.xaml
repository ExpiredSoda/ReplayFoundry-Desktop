<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.GenerationModeSurface" Color="{DynamicResource Color.GenerateModeSurface}" />

    <SolidColorBrush x:Key="Brush.GenerationModeSurfaceHover" Color="{DynamicResource Color.GenerateModeSurfaceHover}" />

    <SolidColorBrush x:Key="Brush.GenerationModeSurfaceSelected" Color="{DynamicResource Color.GenerateModeSurfaceSelected}" />

    <!--  Keyboard-only focus cue.  -->
    <Style x:Key="Generate.ModeKeyboardFocus">

        <Setter Property="Control.Template">
            <Setter.Value>

                <ControlTemplate>

                    <Border
                        Margin="2"
                        BorderBrush="{DynamicResource Brush.DockFocus}"
                        BorderThickness="1"
                        CornerRadius="8"
                        SnapsToDevicePixels="True" />

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <!--
        A RadioButton is used because the two modes are mutually exclusive.
        Its normal circular-radio appearance is replaced with a card template.
    -->
    <Style x:Key="Generate.ModeTabCard" TargetType="{x:Type RadioButton}">

        <Setter Property="MinHeight" Value="88" />

        <Setter Property="Margin" Value="0,0,8,0" />

        <Setter Property="Padding" Value="16,12" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />

        <Setter Property="Background" Value="{StaticResource Brush.GenerationModeSurface}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DockBorder}" />

        <Setter Property="BorderThickness" Value="0" />

        <Setter Property="Cursor" Value="Arrow" />

        <Setter Property="ClipToBounds" Value="False" />

        <Setter Property="HorizontalContentAlignment" Value="Stretch" />

        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Setter Property="FocusVisualStyle" Value="{DynamicResource Generate.ModeKeyboardFocus}" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type RadioButton}">

                    <Grid>

                        <!--  Main card surface.  -->
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        </Border>

                        <Border
                            x:Name="SelectionRail"
                            Width="4"
                            Margin="6,10,0,10"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Brush.DockFocus}"
                            CornerRadius="2"
                            IsHitTestVisible="False"
                            Opacity="0" />

                    </Grid>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.GenerationModeSurfaceHover}" />

                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">

                            <Setter TargetName="Surface" Property="Background" Value="{StaticResource Brush.GenerationModeSurfaceSelected}" />

                            <Setter TargetName="SelectionRail" Property="Opacity" Value="1" />

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Opacity" Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>
