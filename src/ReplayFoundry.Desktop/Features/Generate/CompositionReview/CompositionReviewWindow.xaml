<Window
    x:Class="ReplayFoundry.Desktop.Features.Generate.CompositionReview.CompositionReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Generate.CompositionReview"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Video Layout Review"
    Style="{DynamicResource Control.ThemedWindow}"
    Width="1600"
    Height="900"
    MinWidth="760"
    MinHeight="600"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/ReplayFoundry.Desktop;component/Assets/Icons/Application/ReplayFoundry.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    SizeChanged="CompositionReviewWindow_SizeChanged"
    WindowStyle="None"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="/ReplayFoundry.Desktop;component/Features/Generate/GenerationSetup/GenerationSetupStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="CompositionReview.Panel"
                TargetType="{x:Type Border}">

                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{DynamicResource Brush.CompositionSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />

            </Style>

            <Style
                x:Key="CompositionReview.SmallButton"
                BasedOn="{StaticResource GenerationSetup.SecondaryButton}"
                TargetType="{x:Type Button}">

                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />

            </Style>

            <Style
                x:Key="CompositionReview.IconButton"
                TargetType="{x:Type Button}"
                BasedOn="{StaticResource Control.IconButton}">

                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinWidth" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="IconSurface"
                                Width="28"
                                Height="28"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Brush.InteractiveHover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar
            Grid.Row="0"
            Subtitle="Video Layout Review"
            Status="{Binding ConfirmationSummary}" />

        <Border
            Grid.Row="1"
            Background="{DynamicResource Brush.WindowFallback}"
            CornerRadius="0,0,14,14">
        <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontFamily="{DynamicResource Font.Display}" FontSize="24"
                    FontWeight="SemiBold"
                    Text="Video Layout Review" />

                <TextBlock
                    MaxWidth="900"
                    Margin="0,7,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="13"
                    Text="Show where your game and camera appear. Try a suggested layout, or draw the areas yourself."
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="24,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding ConfirmationSummary}" />

                <TextBlock
                    Margin="0,3,0,0"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    Text="Confirm every video before continuing." />

            </StackPanel>

        </Grid>

        <ScrollViewer
            x:Name="ReviewScrollViewer"
            Grid.Row="1"
            Margin="0,18,0,0"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            PanningMode="HorizontalOnly">
        <Grid x:Name="ReviewPanels" MinWidth="1014">

            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SourcePanel"
                Grid.Column="0"
                Style="{StaticResource CompositionReview.Panel}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Selected videos" />

                    <ListBox
                        Grid.Row="1"
                        MaxHeight="190"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="Videos to review"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Sources}"
                        SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,0,0,7"
                                    Padding="10"
                                    AutomationProperties.Name="{Binding FileName}"
                                    Background="{DynamicResource Brush.GenerateSetupHighlight}"
                                    CornerRadius="9">

                                    <StackPanel>

                                        <TextBlock
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FullPath}" />

                                        <StackPanel
                                            Margin="0,5,0,0"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Foreground="{DynamicResource Brush.CompositionWarning}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Text="{Binding ReferenceLabel}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                FontSize="10"
                                                Text="{Binding DurationText}" />

                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Text="{Binding PreviewStatusText}">

                                            <TextBlock.Style>

                                                <Style TargetType="{x:Type TextBlock}">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{DynamicResource Brush.GenerateAudioWarning}" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsConfirmed}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{DynamicResource Brush.CompositionSuccess}" />

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            Binding="{Binding HasPreviewError}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{DynamicResource Brush.CompositionError}" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,14,0,8"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Areas in this video" />

                    <ListBox
                        Grid.Row="3"
                        AutomationProperties.Name="Areas in current video"
                        ItemsSource="{Binding SelectedSource.Regions}"
                        SelectedItem="{Binding SelectedSource.SelectedRegion, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="{Binding AutomationName, StringFormat=Remove {0}}"
                                        Command="{Binding RemoveCommand}"
                                        Style="{StaticResource CompositionReview.IconButton}"
                                        ToolTip="Remove area">
                                        <controls:IconPath
                                            Width="13"
                                            Height="13"
                                            IconKey="Icon.Trash"
                                            Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            StrokeThickness="1.2" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>

            </Border>

            <Border
                x:Name="PreviewPanel"
                Grid.Column="2"
                Style="{StaticResource CompositionReview.Panel}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedSource.FileName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SelectedSource.FullPath}" />

                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="11"
                                Text="{Binding SelectedSource.PreviewStatusText}" />

                            <ProgressBar
                                Width="180"
                                Margin="0,7,0,0"
                                HorizontalAlignment="Left"
                                AutomationProperties.Name="Loading layout preview"
                                IsIndeterminate="True"
                                Style="{DynamicResource Control.ProgressBar.Compact}"
                                Visibility="{Binding SelectedSource.IsLoadingPreview, Converter={StaticResource BoolToVisibility}}" />

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Load preview image"
                            Command="{Binding RefreshPreviewCommand}"
                            Content="Refresh image"
                            Style="{StaticResource GenerationSetup.SecondaryButton}" />

                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,12,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="11"
                            Text="Preview time" />

                        <Slider
                            Grid.Column="1"
                            Margin="12,0"
                            AutomationProperties.Name="Representative preview timestamp"
                            Maximum="{Binding SelectedSource.MaximumPreviewTimestampSeconds}"
                            Minimum="0"
                            IsMoveToPointEnabled="True"
                            SmallChange="1"
                            Value="{Binding SelectedSource.RequestedTimestampSeconds, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="2"
                            MinWidth="54"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="11"
                            Text="{Binding SelectedSource.RequestedTimestampText}" />

                    </Grid>

                    <local:CompositionRegionEditor
                        Grid.Row="2"
                        AutomationProperties.Name="Video area editor"
                        DataContext="{Binding SelectedSource}"
                        Focusable="True" />

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource Brush.CompositionErrorSurface}"
                        CornerRadius="8">

                        <Border.Style>

                            <Style TargetType="{x:Type Border}">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SelectedSource.HasPreviewError}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <TextBlock
                            Foreground="{DynamicResource Brush.ValidationErrorText}"
                            FontSize="11"
                            Text="{Binding SelectedSource.PreviewError}"
                            TextWrapping="Wrap" />

                    </Border>

                </Grid>

            </Border>

            <Border
                x:Name="AreaPanel"
                Grid.Column="4"
                Style="{StaticResource CompositionReview.Panel}">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly">

                    <StackPanel>

                        <Border Padding="14" Margin="0,0,0,16" Background="{DynamicResource Brush.KineticCanvasPane}" CornerRadius="8">
                            <StackPanel DataContext="{Binding SelectedSource.LayoutAssist}">
                                <controls:FoundryHeading Text="A head start on your layout" FontSize="15" />
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,12"
                                    Style="{DynamicResource Text.Meta}" AutomationProperties.LiveSetting="Polite" />
                                <Button Content="Suggest a layout" Command="{Binding SuggestCommand}" AutomationProperties.Name="Suggest a camera layout"
                                    Style="{DynamicResource GenerationSetup.SecondaryButton}" />
                                <Button Content="Add suggested boxes" Command="{Binding ApplyCommand}" Margin="0,6,0,0"
                                    Visibility="{Binding HasSuggestion, Converter={StaticResource BoolToVisibility}}"
                                    Style="{DynamicResource GenerationSetup.PrimaryButton}" />
                            </StackPanel>
                        </Border>
                        <Grid><Grid.Style><Style TargetType="{x:Type Grid}">

                                    <Setter
                                        Property="IsEnabled"
                                        Value="True" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedSource.HasSelectedRegion}"
                                            Value="False">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <StackPanel>

                                <TextBlock
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Selected area" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    FontSize="11"
                                    Text="Change what an existing box represents. Replay Foundry updates how it uses that area automatically."
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    Margin="0,9,0,10"
                                    AutomationProperties.Name="Selected area type"
                                    ItemsSource="{Binding AvailableRoles}" ItemTemplate="{StaticResource StudioOptionTemplate}"
                                    SelectedItem="{Binding SelectedSource.SelectedRegion.Role, Mode=TwoWay}" />

                                <TextBlock
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    FontSize="10"
                                    Text="Arrow keys move the selected area. Shift+Arrow resizes it. Delete removes it."
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,10" />

                        <TextBlock
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Add an area" />

                        <TextBlock
                            Margin="0,4,0,7"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="10"
                            Text="Choose a starting box, then drag and resize it directly on the preview."
                            TextWrapping="Wrap" />

                        <Button
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Use full frame as gameplay"
                            Command="{Binding FullFrameGameplayCommand}"
                            Content="Full frame is gameplay"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Gameplay Area"
                            Command="{Binding AddGameplayCommand}"
                            Content="+ Gameplay"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Presenter Area"
                            Command="{Binding AddPresenterCommand}"
                            Content="+ Your camera"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Chat or Text Area"
                            Command="{Binding AddChatOrTextCommand}"
                            Content="+ Chat or text"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Overlay Area"
                            Command="{Binding AddOverlayCommand}"
                            Content="+ Logo or overlay"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            Margin="0,6,0,0"
                            AutomationProperties.Name="Confirm this video"
                            Command="{Binding ConfirmCurrentSourceCommand}"
                            Content="Confirm this video"
                            Style="{StaticResource GenerationSetup.PrimaryButton}" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource Brush.CompositionError}"
                            FontSize="10"
                            Text="{Binding SelectedSource.ValidationError}"
                            TextWrapping="Wrap" />

                        <Separator Margin="0,10" />

                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="10"
                            Text="Use this only when the selected videos share the same layout. Replay Foundry copies your boxes exactly and does not guess."
                            TextWrapping="Wrap" />

                        <Button
                            Margin="0,9,0,0"
                            AutomationProperties.Name="Apply current layout to all videos"
                            Command="{Binding ApplyCurrentLayoutCommand}"
                            Content="Apply to all videos"
                            Style="{StaticResource GenerationSetup.SecondaryButton}" />

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>
        </ScrollViewer>

        <Grid
            x:Name="ReviewFooter"
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                AutomationProperties.Name="Cancel Video Layout Review"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Style="{StaticResource GenerationSetup.SecondaryButton}" />

            <TextBlock
                Grid.Column="1"
                Margin="18,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="11"
                Text="Areas may overlap. Every video needs at least one Gameplay area."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                Grid.Column="2"
                AutomationProperties.Name="Continue finding clips"
                Command="{Binding ContinueCommand}"
                Content="Continue"
                Style="{StaticResource GenerationSetup.PrimaryButton}" />

        </Grid>

        </Grid>
        </Border>
    </Grid>

</Window>
