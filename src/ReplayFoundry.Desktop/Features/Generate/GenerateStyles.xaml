<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Generate.ActionButton" TargetType="Button" BasedOn="{StaticResource Control.ThemedButton}">
        <Setter Property="MinWidth" Value="156" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Generate.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Control.PrimaryButton}">
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Generate.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Generate.ActionButton}">
        <Setter Property="MinWidth" Value="132" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="Generate.FileRow" TargetType="Border">
        <Setter Property="Padding" Value="0,12" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="Generate.SetupSummary" TargetType="Border">
        <Setter Property="Margin" Value="0,12,0,0" />
        <Setter Property="Padding" Value="12,2,0,2" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DockActiveBorder}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasGenerationSetup}" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>