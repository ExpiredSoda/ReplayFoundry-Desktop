<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.Audio.AudioStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <TextBlock
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="26"
                FontWeight="SemiBold"
                Text="Audio" />

            <TextBlock
                Margin="0,7,0,20"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="14"
                Text="Choose how the original audio and captions should work in your clips."
                TextWrapping="Wrap" />

            <Border
                Padding="12"
                Background="{DynamicResource Brush.InteractiveSelected}"
                BorderBrush="{DynamicResource Brush.StatusInfo}"
                BorderThickness="1"
                CornerRadius="9">
                <StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        FontWeight="SemiBold"
                        Text="All original audio stays audible" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding SourceAudioPolicyText}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Margin="0,22,0,0"
                Padding="14"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <CheckBox
                        AutomationProperties.Name="Add spoken captions"
                        Content="Add spoken captions"
                        FontWeight="SemiBold"
                        IsChecked="{Binding IsCaptioningEnabled, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding CaptionExplanation}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,14,0,0"
                        IsEnabled="{Binding IsCaptioningEnabled}">
                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="CAPTION STYLE" />
                        <ComboBox
                            Margin="0,5,0,0"
                            AutomationProperties.Name="Caption effect"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding CaptionStyles}"
                            SelectedItem="{Binding SelectedCaptionStyle, Mode=TwoWay}" />

                        <ItemsControl
                            Margin="0,12,0,0"
                            ItemsSource="{Binding CaptionSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{DynamicResource Brush.SurfacePanel}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding SourceName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding AvailabilityText}" />
                                            <TextBlock
                                                Margin="0,0,0,5"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="WORDS SHOWN FROM" />
                                            <ComboBox
                                                AutomationProperties.Name="Recording track whose words should be captioned"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Streams}"
                                                SelectedItem="{Binding SelectedStream, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="0,4,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding SelectedStream.Detail}"
                                                TextWrapping="Wrap" />
                                            <Border
                                                Height="70"
                                                Margin="0,5,0,5"
                                                Padding="9,7"
                                                Background="{DynamicResource Brush.PreviewCanvasDark}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="{DynamicResource Radius.OrganicCard}">
                                                <Grid>
                                                    <controls:AudioSignalWaveform
                                                        AutomationProperties.Name="Audio sample waveform"
                                                        ActiveBrush="{DynamicResource Brush.BrandCyan}"
                                                        InactiveBrush="{DynamicResource Brush.ScrollThumb}"
                                                        IsPlaying="{Binding IsAuditionPlaying}"
                                                        Peaks="{Binding WaveformPeaks}"
                                                        PlayheadBrush="{DynamicResource Brush.BrandPaper}"
                                                        Progress="{Binding AuditionProgress}" />
                                                    <ProgressBar
                                                        AutomationProperties.Name="Preparing audio sample"
                                                        IsIndeterminate="True"
                                                        Style="{DynamicResource Control.ProgressBar.Compact}"
                                                        Visibility="{Binding IsPreparingAudition, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock
                                                        Margin="0,0,3,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        FontSize="10"
                                                        Text="{Binding AuditionProgressText}" />
                                                </Grid>
                                            </Border>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource Text.Meta}"
                                                    Text="{Binding AuditionSampleText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button
                                                        AutomationProperties.Name="Play prepared audio sample"
                                                        Command="{Binding AuditionCommand}"
                                                        Style="{DynamicResource GenerationSetup.TransportButton}"
                                                        ToolTip="Play prepared 30-second sample">
                                                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Play" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                                                    </Button>
                                                    <Button
                                                        Margin="6,0,0,0"
                                                        AutomationProperties.Name="Stop audio sample"
                                                        Command="{Binding StopAuditionCommand}"
                                                        Style="{DynamicResource GenerationSetup.TransportButton}"
                                                        ToolTip="Stop sample">
                                                        <controls:IconPath Width="13" Height="13" IconKey="Icon.Stop" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding AuditionStatus}"
                                                TextWrapping="Wrap" />
                                            <ComboBox
                                                AutomationProperties.Name="Type of speech on this track"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding Roles}"
                                                SelectedItem="{Binding SelectedRole, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="0,5,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding ConfirmationStatus}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,10,0,4"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="SPOKEN LANGUAGE" />
                                            <ComboBox
                                                AutomationProperties.Name="Spoken language to transcribe"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding Languages}"
                                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding SelectedLanguage.Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <Border
            Grid.Column="2"
            Style="{DynamicResource GenerationSetup.SectionCard}">

            <StackPanel>

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Audio summary" />

                <TextBlock
                    Margin="0,20,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="STARTING VIDEO" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding ReferenceSourceName}"
                    TextTrimming="CharacterEllipsis" />

                <TextBlock
                    Margin="0,18,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="FINISHED CLIP" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="All original audio" />

                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="{Binding SourceAudioPolicyText}"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,24,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.GenerateAudioWarningSurface}"
                    CornerRadius="10">

                    <Border.Style>

                        <Style TargetType="{x:Type Border}">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsBatchSetup}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <TextBlock
                        Foreground="{DynamicResource Brush.ValidationWarningText}"
                        FontSize="12"
                        Text="{Binding BatchReferenceMessage}"
                        TextWrapping="Wrap" />

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
