<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.Audio.AudioStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:captionPreviews="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Inspector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Style="{DynamicResource GenerationSetup.MainContent}">

            <controls:FoundryHeading
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontFamily="{DynamicResource Font.Display}" FontSize="23"
                FontWeight="SemiBold"
                Text="Audio" />

            <TextBlock
                Margin="0,7,0,12"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="14"
                Text="Keep the original sound. Add captions from the voices you choose."
                TextWrapping="Wrap" />

            <Border
                Margin="0,0,0,0"
                Padding="14"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                BorderThickness="1"
                CornerRadius="10">
                <StackPanel>
                    <CheckBox
                        AutomationProperties.Name="Add spoken captions"
                        Content="Add spoken captions"
                        FontWeight="SemiBold"
                        IsChecked="{Binding IsCaptioningEnabled, Mode=TwoWay}" />
                    <TextBlock
                        Margin="0,7,0,0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding CaptionExplanation}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,14,0,0"
                        IsEnabled="{Binding IsCaptioningEnabled}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaptioningEnabled}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>


                        <ItemsControl
                            Margin="0,12,0,0"
                            ItemsSource="{Binding CaptionSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="12"
                                        Background="{DynamicResource Brush.SurfacePanel}"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding SourceName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,3,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding AvailabilityText}" />
                                            <TextBlock
                                                Margin="0,0,0,5"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="WORDS SHOWN FROM" />
                                            <Grid>
                                            <ComboBox
                                                AutomationProperties.Name="Recording track whose words should be captioned"
                                                DisplayMemberPath="DisplayName"
                                                ItemsSource="{Binding Streams}"
                                                SelectedItem="{Binding SelectedStream, Mode=TwoWay}" />
                                            <TextBlock Text="Choose a track to listen to…" IsHitTestVisible="False"
                                                Margin="13,0,35,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}">
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding SelectedStream}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger></Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,4,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding SelectedStream.Detail}"
                                                TextWrapping="Wrap" />
                                            <Border
                                                Height="70"
                                                Margin="0,5,0,5"
                                                Padding="9,7"
                                                Background="{DynamicResource Brush.PreviewCanvasDark}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                CornerRadius="{DynamicResource Radius.OrganicCard}">
                                                <Grid>
                                                    <controls:AudioSignalWaveform
                                                        AutomationProperties.Name="Audio sample waveform"
                                                        AutomationProperties.HelpText="Click or drag anywhere on the waveform to seek. Arrow keys move through the sample."
                                                        ActiveBrush="{DynamicResource Brush.BrandCyan}"
                                                        InactiveBrush="{DynamicResource Brush.ScrollThumb}"
                                                        IsPlaying="{Binding IsAuditionPlaying}"
                                                        SeekCommand="{Binding SeekAuditionCommand}"
                                                        Peaks="{Binding WaveformPeaks}"
                                                        PlayheadBrush="{DynamicResource Brush.BrandPaper}"
                                                        Progress="{Binding AuditionProgress}" />
                                                    <TextBlock Text="Choose a track to see its waveform" Style="{DynamicResource Text.Meta}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                                        Visibility="{Binding HasWaveform, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <ProgressBar
                                                        AutomationProperties.Name="Preparing audio sample"
                                                        IsIndeterminate="True"
                                                        Style="{DynamicResource Control.ProgressBar.Compact}"
                                                        Visibility="{Binding IsPreparingAudition, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock
                                                        Margin="0,0,3,2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        FontSize="10"
                                                        IsHitTestVisible="False"
                                                        Text="{Binding AuditionProgressText}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Margin="0,2,0,8" Style="{DynamicResource Text.Meta}"
                                                Text="Click the waveform to seek · drag to explore · press Play to listen" TextWrapping="Wrap" />
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource Text.Meta}"
                                                    Text="{Binding AuditionSampleText}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button
                                                        AutomationProperties.Name="Play prepared audio sample"
                                                        Command="{Binding AuditionCommand}"
                                                        Style="{DynamicResource GenerationSetup.TransportButton}"
                                                        ToolTip="Play prepared 30-second sample">
                                                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Play" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                                                    </Button>
                                                    <Button
                                                        Margin="6,0,0,0"
                                                        AutomationProperties.Name="Stop audio sample"
                                                        Command="{Binding StopAuditionCommand}"
                                                        Style="{DynamicResource GenerationSetup.TransportButton}"
                                                        ToolTip="Stop sample">
                                                        <controls:IconPath Width="13" Height="13" IconKey="Icon.Stop" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,0,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding AuditionStatus}"
                                                TextWrapping="Wrap" />
                                            <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Whose words are on this track?" />
                                            <ListBox
                                                AutomationProperties.Name="Type of speech on this track"
                                                Style="{DynamicResource GenerationSetup.OptionList}"
                                                ItemContainerStyle="{DynamicResource GenerationSetup.ChoiceItem}"
                                                ItemsSource="{Binding Roles}"
                                                SelectedItem="{Binding SelectedRole, Mode=TwoWay}">
                                                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock
                                                Margin="0,5,0,8"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding ConfirmationStatus}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,10,0,4"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="SPOKEN LANGUAGE" />
                                            <ComboBox
                                                AutomationProperties.Name="Spoken language to transcribe"
                                                ToolTip="{Binding LanguageCapabilitySummary}"
                                                DisplayMemberPath="Name"
                                                ItemsSource="{Binding Languages}"
                                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding SelectedLanguage.Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <Border Style="{DynamicResource GenerationSetup.SummaryCard}">

            <StackPanel>

                <controls:FoundryHeading Text="Caption look" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Margin="0,8,0,14" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                    Text="Your clips keep all original audio. Captions add the words you choose on top."
                    Visibility="{Binding IsCaptioningEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                    Text="Turn on spoken captions to choose a style."
                    Visibility="{Binding IsCaptioningEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsCaptioningEnabled, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="Choose a look · hover to preview" />
                        <ListBox
                            Margin="0,5,0,0"
                            AutomationProperties.Name="Caption look"
                            IsEnabled="{Binding IsCaptioningEnabled}"
                            Style="{DynamicResource GenerationSetup.OptionList}"
                            ItemContainerStyle="{DynamicResource GenerationSetup.ChoiceItem}"
                            ItemsSource="{Binding CaptionLooks}"
                            SelectedItem="{Binding SelectedCaptionLook, Mode=TwoWay}">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel MinWidth="66" ToolTip="{Binding Description}">
                                        <captionPreviews:StudioCaptionEffectPreview Height="46" Preset="{Binding Style}" Typography="{Binding Typography}">
                                            <captionPreviews:StudioCaptionEffectPreview.Style>
                                                <Style TargetType="captionPreviews:StudioCaptionEffectPreview">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="IsPreviewActive" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="IsPreviewActive" Value="True" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </captionPreviews:StudioCaptionEffectPreview.Style>
                                        </captionPreviews:StudioCaptionEffectPreview>
                                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" />
                                        <TextBlock Text="Saved" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.BrandCyan}" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" Text="{Binding CaptionLookHint}" />
                </StackPanel>
                <Border
                    Margin="0,24,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.GenerateAudioWarningSurface}"
                    CornerRadius="10">

                    <Border.Style>

                        <Style TargetType="{x:Type Border}">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsBatchSetup}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>

                    <TextBlock
                        Foreground="{DynamicResource Brush.ValidationWarningText}"
                        FontSize="12"
                        Text="{Binding BatchReferenceMessage}"
                        TextWrapping="Wrap" />

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
