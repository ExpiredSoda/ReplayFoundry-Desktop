<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.Detection.DetectionStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Style="{DynamicResource GenerationSetup.MainContent}">

            <TextBlock
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="23"
                FontWeight="SemiBold"
                Text="Scan detail" />

            <TextBlock
                Margin="0,7,0,20"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="14"
                Text="Choose a faster or more detailed scan. Clip amount and quality are set separately."
                TextWrapping="Wrap" />

            <ListBox
                ItemsSource="{Binding Options}"
                ItemContainerStyle="{DynamicResource GenerationSetup.OptionItem}"
                SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                Style="{DynamicResource GenerationSetup.OptionList}">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel>

                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Name}" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="12"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource Brush.GenerateAudioWarning}"
                                FontSize="11"
                                Text="{Binding UnavailableReason}"
                                TextWrapping="Wrap">

                                <TextBlock.Style>

                                    <Style TargetType="{x:Type TextBlock}">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsAvailable}"
                                                Value="False">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

            <TextBlock
                Margin="0,26,0,0"
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="20"
                FontWeight="SemiBold"
                Text="Title writing" />

            <TextBlock
                Margin="0,6,0,12"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="13"
                Text="Local AI is recommended. Choose Simple titles when you prefer not to use AI."
                TextWrapping="Wrap" />

            <TextBlock Text="{Binding GpuReadiness}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" AutomationProperties.LiveSetting="Polite" />
            <Button Content="Refresh GPU readiness" Command="{Binding RefreshGpuReadinessCommand}" HorizontalAlignment="Left" Margin="0,6,0,12" />

            <ListBox
                x:Name="MetadataOptionsList"
                AutomationProperties.Name="Title writing method"
                IsSynchronizedWithCurrentItem="False"
                ItemsSource="{Binding MetadataOptions}"
                ItemContainerStyle="{DynamicResource GenerationSetup.OptionItem}"
                SelectedItem="{Binding SelectedMetadataOption, Mode=TwoWay}"
                Style="{DynamicResource GenerationSetup.OptionList}">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel>

                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding Name}" />

                            <TextBlock
                                Margin="0,5,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="12"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,7,0,0"
                                Foreground="{DynamicResource Brush.GenerateAudioWarning}"
                                FontSize="11"
                                Text="{Binding UnavailableReason}"
                                TextWrapping="Wrap">

                                <TextBlock.Style>

                                    <Style TargetType="{x:Type TextBlock}">

                                        <Setter Property="Visibility" Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">

                                                <Setter Property="Visibility" Value="Visible" />

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </StackPanel>

        <Border Style="{DynamicResource GenerationSetup.SummaryCard}">

            <StackPanel>

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Current choices" />

                <TextBlock
                    Margin="0,20,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="SCAN DETAIL" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding SelectedOption.Name}" />

                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="{Binding SelectedDescription}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,20,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="TITLE WRITING" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedMetadataName}" />

                <TextBlock
                    Margin="0,7,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="{Binding SelectedMetadataDescription}"
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,24,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.GenerateDropHighlight}"
                    CornerRadius="10">

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding OptionalIntelligenceStatus}"
                        TextWrapping="Wrap" />

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
