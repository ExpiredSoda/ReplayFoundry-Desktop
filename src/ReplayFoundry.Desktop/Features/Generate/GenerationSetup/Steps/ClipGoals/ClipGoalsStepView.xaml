<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.ClipGoals.ClipGoalsStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>

        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Style="{DynamicResource GenerationSetup.MainContent}">

            <TextBlock
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="23"
                FontWeight="SemiBold"
                Text="Clip goals" />

            <TextBlock
                Margin="0,7,0,20"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="14"
                Text="Set the amount, length, and kinds of moments you want."
                TextWrapping="Wrap" />

            <Border
                Style="{DynamicResource GenerationSetup.SectionCard}">

                <StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{DynamicResource GenerationSetup.FieldLabel}"
                            Text="{Binding ResultCountLabel}" />

                        <TextBlock
                            Grid.Column="1"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding DesiredResultCountText}" />

                    </Grid>

                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding ResultCountDescription}"
                        TextWrapping="Wrap" />

                    <CheckBox
                        Margin="0,0,0,10"
                        AutomationProperties.Name="Choose clip amount automatically"
                        Content="Choose amount automatically (up to 30 clips)"
                        IsChecked="{Binding IsAutomaticResultCount, Mode=TwoWay}" />

                    <Slider
                        IsEnabled="{Binding IsExactResultCount}"
                        Minimum="1"
                        Maximum="30"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding DesiredResultCount, Mode=TwoWay}" />

                </StackPanel>

            </Border>

            <Border
                Style="{DynamicResource GenerationSetup.SectionCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{DynamicResource GenerationSetup.FieldLabel}"
                            Text="Maximum clip length" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding MaximumClipDurationText}" />
                    </Grid>
                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding MaximumClipDurationDescription}"
                        TextWrapping="Wrap" />
                    <Slider
                        AutomationProperties.Name="Maximum clip length"
                        AutomationProperties.HelpText="Choose ten seconds through three minutes. Complete moments can still end sooner."
                        Minimum="10"
                        Maximum="180"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding MaximumClipDurationSeconds, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Expander Header="Selection and quality" Margin="0,0,0,20" Style="{DynamicResource Control.DisclosureExpander}">
                <StackPanel Margin="0,16,0,0">
            <Border
                Style="{DynamicResource GenerationSetup.SectionCard}">

                <StackPanel>

                    <TextBlock
                        Style="{DynamicResource GenerationSetup.FieldLabel}"
                        Text="If there are not enough strong clips" />

                    <ComboBox
                        IsEnabled="{Binding IsExactResultCount}"
                        ItemsSource="{Binding FulfillmentOptions}"
                        SelectedItem="{Binding SelectedFulfillmentOption, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        Style="{DynamicResource GenerationSetup.ComboBox}" />

                    <TextBlock
                        Margin="0,9,0,0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding SelectedFulfillmentDescription}"
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource Brush.InteractiveSelected}"
                        BorderBrush="{DynamicResource Brush.StatusInfo}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel>
                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontWeight="SemiBold"
                                Text="{Binding CountQualityRelationshipTitle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{DynamicResource Text.Meta}"
                                Text="{Binding CountQualityRelationshipDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>

            <Border
                Style="{DynamicResource GenerationSetup.SectionCard}">

                <StackPanel>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Style="{DynamicResource GenerationSetup.FieldLabel}"
                            Text="{Binding QualityControlLabel}" />

                        <TextBlock
                            Grid.Column="1"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding QualityThresholdText}" />

                    </Grid>

                    <TextBlock
                        Margin="0,0,0,10"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding QualityThresholdDescription}"
                        TextWrapping="Wrap" />

                    <Slider
                        Minimum="0"
                        Maximum="100"
                        TickFrequency="5"
                        IsSnapToTickEnabled="True"
                        Value="{Binding QualityThreshold, Mode=TwoWay}" />

                </StackPanel>

            </Border>

                </StackPanel>
            </Expander>

            <Border
                Style="{DynamicResource GenerationSetup.SectionCard}">

                <StackPanel>

                    <TextBlock
                        Style="{DynamicResource GenerationSetup.FieldLabel}"
                        Text="Content emphasis" />

                    <ComboBox
                        ItemsSource="{Binding EmphasisOptions}"
                        SelectedItem="{Binding SelectedEmphasisOption, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        Style="{DynamicResource GenerationSetup.ComboBox}" />

                    <TextBlock
                        Margin="0,9,0,0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="{Binding SelectedEmphasisDescription}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,18,0,8" Text="Find moments about"
                        Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding IntentOptions}"
                        SelectedItem="{Binding SelectedIntentOption, Mode=TwoWay}"
                        DisplayMemberPath="Name" Style="{DynamicResource GenerationSetup.ComboBox}" />
                    <Expander Header="Search the transcript (optional)" Margin="0,16,0,0">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource Control.DisclosureExpander}">
                                <Setter Property="IsExpanded" Value="True" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding NaturalLanguageQuery}" Value="" />
                                            <Condition Binding="{Binding SpokenSearchTerms}" Value="" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsExpanded" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <StackPanel>
                    <TextBlock Margin="0,12,0,6" Text="Exact spoken phrases (optional)"
                        Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding SpokenSearchTerms, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="240" Padding="8" MinHeight="34" />
                    <TextBlock Margin="0,8,0,0" FontSize="12"
                        Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                        Text="Separate exact phrases with commas. Spoken matches guide review; they do not confirm a game event." />
                    <TextBlock Margin="0,12,0,5" Text="Describe what to find (optional, English)"
                        Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBox Text="{Binding NaturalLanguageQuery, UpdateSourceTrigger=PropertyChanged}" MaxLength="240"
                        TextWrapping="Wrap" MinHeight="48" />
                        </StackPanel>
                    </Expander>
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        Text="Semantic search, comebacks, tutorials and reactions use a Thorough scan and a one-time 22 MiB download. English text is processed on your computer." />
                    <Expander Header="Search limitations" Margin="0,8,0,0" Style="{DynamicResource Control.DisclosureExpander}">
                        <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"
                                   Text="Similarity suggests passages for visual review, not proof. Negation, hypothetical speech and sarcasm can produce false matches. Other languages and unspoken events may be missed." />
                    </Expander>

                </StackPanel>

            </Border>

        </StackPanel>

        <Border Style="{DynamicResource GenerationSetup.SummaryCard}">

            <StackPanel>

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Current goals" />

                <TextBlock
                    Margin="0,20,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="CLIP AMOUNT" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding DesiredResultCountText}" />

                <TextBlock
                    Margin="0,18,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="WHEN SHORT" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding SelectedFulfillmentOption.Name}" />

                <TextBlock
                    Margin="0,18,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="QUALITY LEVEL" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding QualityThresholdText}" />

                <TextBlock
                    Margin="0,18,0,5"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="CONTENT FOCUS" />

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="15"
                    Text="{Binding SelectedEmphasisOption.Name}" />

                <Border
                    Margin="0,24,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.GenerateDropHighlight}"
                    CornerRadius="10">

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="Amount controls how many clips you get; quality controls what makes the cut. Scan detail is chosen separately."
                        TextWrapping="Wrap" />

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
