<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:setup="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup">
    <Style x:Key="GenerationSetup.StepButton" TargetType="Button" BasedOn="{StaticResource Control.ThemedButton}">
        <Setter Property="MinWidth" Value="116" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="GenerationSetup.SectionCard" TargetType="Border">
        <Setter Property="Padding" Value="0,0,0,16" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="GenerationSetup.MainContent" TargetType="StackPanel">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type setup:GenerationSetupWindow}}}" Value="True">
                <Setter Property="Grid.ColumnSpan" Value="3" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GenerationSetup.SummaryCard" TargetType="Border" BasedOn="{StaticResource GenerationSetup.SectionCard}">
        <Setter Property="Grid.Column" Value="2" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type setup:GenerationSetupWindow}}}" Value="True">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.ColumnSpan" Value="3" />
                <Setter Property="Margin" Value="0,20,0,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="GenerationSetup.FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GenerationSetup.ComboBox" TargetType="ComboBox" BasedOn="{StaticResource Control.ThemedComboBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style x:Key="GenerationSetup.OptionList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style x:Key="GenerationSetup.OptionItem" TargetType="ListBoxItem" BasedOn="{StaticResource Control.KeyboardFocus}">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Surface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="SelectionRail" Width="3" Margin="0,8,0,8" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.DockFocus}" CornerRadius="1" IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.InteractiveHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                            <Setter TargetName="SelectionRail" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="GenerationSetup.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Control.ThemedButton}">
        <Setter Property="MinWidth" Value="108" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
    </Style>
    <Style x:Key="GenerationSetup.TransportButton" TargetType="Button" BasedOn="{StaticResource GenerationSetup.SecondaryButton}">
        <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" /><Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="GenerationSetup.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Control.PrimaryButton}">
        <Setter Property="MinWidth" Value="144" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="18,8" />
    </Style>
</ResourceDictionary>