<Window
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.GenerationSetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:audio="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.Audio"
    xmlns:clipGoals="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.ClipGoals"
    xmlns:detection="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.Detection"
    xmlns:gameContext="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.GameContext"
    xmlns:momentGuidance="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.MomentGuidance"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Clip setup"
    Style="{DynamicResource Control.ThemedWindow}"
    Width="1180"
    Height="820"
    MinWidth="760"
    MinHeight="600"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/ReplayFoundry.Desktop;component/Assets/Icons/Application/ReplayFoundry.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    SizeChanged="GenerationSetupWindow_SizeChanged"
    WindowStyle="None"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="GenerationSetupStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <DataTemplate
                DataType="{x:Type detection:DetectionStepViewModel}">

                <detection:DetectionStepView />

            </DataTemplate>

            <DataTemplate
                DataType="{x:Type audio:AudioStepViewModel}">

                <audio:AudioStepView />

            </DataTemplate>

            <DataTemplate
                DataType="{x:Type clipGoals:ClipGoalsStepViewModel}">

                <clipGoals:ClipGoalsStepView />

            </DataTemplate>

            <DataTemplate
                DataType="{x:Type gameContext:GameContextStepViewModel}">

                <gameContext:GameContextStepView />

            </DataTemplate>

            <DataTemplate
                DataType="{x:Type momentGuidance:MomentGuidanceStepViewModel}">

                <momentGuidance:MomentGuidanceStepView />

            </DataTemplate>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar
            Grid.Row="0"
            Subtitle="Clip setup"
            Status="{Binding SourceSummary}" />

        <Border
            Grid.Row="1"
            Background="{DynamicResource Brush.WindowFallback}"
            CornerRadius="0,0,14,14">
        <Grid Margin="16">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:FoundryFrameMark Width="66" Height="57" IconKey="Icon.Spark" HorizontalAlignment="Left" />
            <StackPanel Margin="82,0,0,0">

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontFamily="{DynamicResource Font.Display}" FontSize="24"
                    FontWeight="SemiBold"
                    Text="Clip setup" />

                <StackPanel
                    Margin="0,6,0,0"
                    Orientation="Horizontal">

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="13"
                        Text="{Binding ModeDisplayName}" />

                    <TextBlock
                        Margin="8,0"
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="13"
                        Text="•" />

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="13"
                        Text="{Binding SourceSummary}" />

                </StackPanel>

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right">

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    Text="STARTING VIDEO" />

                <TextBlock
                    Margin="0,4,0,0"
                    MaxWidth="240"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding ReferenceSourceName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Draft.Request.ReferenceSource.FullPath}" />

            </StackPanel>

        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,12,0,0"
            Padding="14,11"
            Background="{DynamicResource Brush.GenerateAudioWarningSurface}"
            BorderBrush="{DynamicResource Brush.GenerateAudioWarning}"
            BorderThickness="1"
            CornerRadius="10">

            <Border.Style>

                <Style TargetType="{x:Type Border}">

                    <Setter
                        Property="Visibility"
                        Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding IsBatchSetup}"
                            Value="False">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Border.Style>

            <TextBlock
                Foreground="{DynamicResource Brush.ValidationWarningText}"
                FontSize="12"
                Text="{Binding BatchWarning}"
                TextWrapping="Wrap" />

        </Border>

        <!-- Clickable Detection, Audio, Clip Goals, Game Context, and Priority Moments navigation. -->
        <ScrollViewer
            Grid.Row="2"
            Margin="0,12,0,10"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled"
            PanningMode="HorizontalOnly">
        <ItemsControl
            MinWidth="620"
            ItemsSource="{Binding Steps}">

            <ItemsControl.ItemsPanel>

                <ItemsPanelTemplate>

                    <UniformGrid
                        Rows="1"
                        Columns="5" />

                </ItemsPanelTemplate>

            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Button
                        AutomationProperties.Name="{Binding Title}"
                        Command="{Binding DataContext.NavigateToStepCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                        CommandParameter="{Binding Step}"
                        IsEnabled="{Binding IsAvailable}"
                        Style="{StaticResource GenerationSetup.StepButton}">

                        <StackPanel
                            x:Name="StepItem"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Opacity="0.35">

                            <Border
                                x:Name="StepBadge"
                                Width="26"
                                Height="26"
                                Background="{DynamicResource Brush.GenerateSetupHighlight}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="4">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    FontWeight="SemiBold"
                                    Text="{Binding Number}" />

                            </Border>

                            <TextBlock
                                Margin="8,0,0,0"
                                MaxWidth="84"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="12"
                                Text="{Binding Title}" />

                        </StackPanel>

                    </Button>

                    <DataTemplate.Triggers>

                        <DataTrigger
                            Binding="{Binding IsAvailable}"
                            Value="True">

                            <Setter
                                TargetName="StepItem"
                                Property="Opacity"
                                Value="1" />

                        </DataTrigger>

                        <DataTrigger
                            Binding="{Binding IsCompleted}"
                            Value="True">

                            <Setter
                                TargetName="StepItem"
                                Property="Opacity"
                                Value="1" />

                            <Setter
                                TargetName="StepBadge"
                                Property="Background"
                                Value="{DynamicResource Brush.InteractiveHover}" />

                        </DataTrigger>

                        <DataTrigger
                            Binding="{Binding IsCurrent}"
                            Value="True">

                            <Setter
                                TargetName="StepItem"
                                Property="Opacity"
                                Value="1" />

                            <Setter
                                TargetName="StepBadge"
                                Property="Background"
                                Value="{DynamicResource Brush.InteractiveSelected}" />

                            <Setter
                                TargetName="StepBadge"
                                Property="BorderBrush"
                                Value="{DynamicResource Brush.DockActiveBorder}" />

                        </DataTrigger>

                    </DataTemplate.Triggers>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>
        </ScrollViewer>

        <!--
            Only the current step scrolls. The heading, step navigation,
            batch warning, and footer remain visible at every window size.
        -->
        <Border
            Grid.Row="3"
            Padding="0"
            Background="{DynamicResource Brush.GenerateSetupPanel}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="10">

            <ScrollViewer
                x:Name="StepScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                CanContentScroll="False"
                PanningMode="VerticalOnly">

                <ContentControl
                    x:Name="StepContent"
                    Margin="18"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding CurrentStepViewModel, NotifyOnTargetUpdated=True}"
                    TargetUpdated="StepContent_TargetUpdated" />

            </ScrollViewer>

        </Border>

        <Grid
            Grid.Row="4"
            Margin="0,12,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Style="{StaticResource GenerationSetup.SecondaryButton}" />

            <TextBlock
                Grid.Column="1"
                Margin="18,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="12"
                Text="{Binding StepPositionText}" />

            <StackPanel
                Grid.Column="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">

                <Button
                    Margin="0,0,10,0"
                    Command="{Binding BackCommand}"
                    Content="Back">

                    <Button.Style>

                        <Style
                            BasedOn="{StaticResource GenerationSetup.SecondaryButton}"
                            TargetType="{x:Type Button}">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsFirstStep}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button
                    Command="{Binding NextCommand}"
                    Content="Next">

                    <Button.Style>

                        <Style
                            BasedOn="{StaticResource GenerationSetup.PrimaryButton}"
                            TargetType="{x:Type Button}">

                            <Setter
                                Property="Visibility"
                                Value="Visible" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsLastStep}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

                <Button
                    Command="{Binding FinishCommand}"
                    Content="Review layouts">

                    <Button.Style>

                        <Style
                            BasedOn="{StaticResource GenerationSetup.PrimaryButton}"
                            TargetType="{x:Type Button}">

                            <Setter
                                Property="Visibility"
                                Value="Collapsed" />

                            <Style.Triggers>

                                <DataTrigger
                                    Binding="{Binding IsLastStep}"
                                    Value="True">

                                    <Setter
                                        Property="Visibility"
                                        Value="Visible" />

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Button.Style>

                </Button>

            </StackPanel>

        </Grid>

        </Grid>
        </Border>
    </Grid>

</Window>
