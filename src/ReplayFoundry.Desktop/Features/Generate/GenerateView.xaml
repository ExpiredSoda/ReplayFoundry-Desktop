<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerateView"
    x:Name="GenerateViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:progress="clr-namespace:ReplayFoundry.Desktop.Features.Generate.Progress"
    xmlns:sourceSelection="clr-namespace:ReplayFoundry.Desktop.Features.Generate.SourceSelection"
    d:DesignHeight="500" d:DesignWidth="980"
    Loaded="GenerateView_Loaded" SizeChanged="GenerateView_SizeChanged" mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <sourceSelection:SourceSelectionView>
                <sourceSelection:SourceSelectionView.Style>
                    <Style TargetType="{x:Type sourceSelection:SourceSelectionView}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSourceSelectionVisible}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </sourceSelection:SourceSelectionView.Style>
            </sourceSelection:SourceSelectionView>
            <progress:GenerationProgressView DataContext="{Binding GenerationProgress}">
                <progress:GenerationProgressView.Style>
                    <Style TargetType="{x:Type progress:GenerationProgressView}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsProgressVisible, ElementName=GenerateViewRoot}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </progress:GenerationProgressView.Style>
            </progress:GenerationProgressView>
        </Grid>
        <!-- Saved work remains reachable in compact windows. -->
        <Border Grid.Row="1" MaxWidth="1120" Margin="24,0,24,12" Padding="0,10,0,0"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
            <Expander Header="Recent projects" Style="{DynamicResource Control.DisclosureExpander}">
                <ScrollViewer MaxHeight="190" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Margin="16,0,0,0" MinWidth="90"
                                    AutomationProperties.Name="Clear all recent Generate projects"
                                    Command="{Binding ClearRecentProjectsCommand}" Content="Clear all"
                                    Style="{DynamicResource Control.DestructiveButton}" />
                            <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Meta}"
                                       Text="Continue a saved Studio project. Its original recording must still be available."
                                       TextWrapping="Wrap"
                                       ToolTip="Keeps your 10 most recent projects. Clearing this list does not remove original recordings, finished Library files, or learned preferences." />
                        </DockPanel>
                        <TextBlock Text="Your saved projects will appear here.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRecentProjects}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding RecentProjects}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel ItemWidth="240" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="232" MinHeight="54" Margin="0,0,8,8" Padding="12,8"
                                            HorizontalContentAlignment="Left"
                                            Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Style="{DynamicResource Control.ThemedButton}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding RecentProjectStatus}"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Border>
    </Grid>
</UserControl>