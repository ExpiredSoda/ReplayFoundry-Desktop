<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.SettingsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:sections="clr-namespace:ReplayFoundry.Desktop.Features.Settings.Sections"
    Background="Transparent">
    <Grid MaxWidth="1400" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:FoundryPageHeader Title="Settings" IconKey="Icon.Settings"
            Description="{Binding PersistenceBannerText}" />

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Find a setting" Style="{DynamicResource Text.FormLabel}" Margin="0,0,0,5" />
                <TextBox x:Name="SettingsSearchBox" AutomationProperties.Name="Search settings"
                    Height="28" MinHeight="28" Padding="10,3" VerticalContentAlignment="Center"
                    ToolTip="Search folders, titles, learning, sharing or updates"
                    Style="{DynamicResource Control.FormTextBox}"
                    Text="{Binding SettingsSearch, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,5">
                <controls:StatusBadge Text="{Binding RuntimeProfileStatus}" Margin="0,0,10,5" />
                <controls:StatusBadge Text="{Binding SharedTraining.ConsentStatus, TargetNullValue=Sharing unavailable, FallbackValue=Sharing unavailable}" Margin="0,0,10,5" />
                <TextBlock Text="{Binding SelectedSectionLabel}" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
            </WrapPanel>
        </Grid>
        <DockPanel Grid.Row="2" LastChildFill="True">
            <Border
                Width="240"
                Margin="0,0,12,0"
                DockPanel.Dock="Left">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Control.CanvasPane}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWideLayout, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Preferences" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,5,0,18"
                        Style="{DynamicResource Text.Meta}"
                        Text="Choose what you want to adjust."
                        TextWrapping="Wrap" />
                    <ListBox
                        Grid.Row="2"
                        AutomationProperties.Name="Settings section selector"
                        ItemsSource="{Binding FilteredSections}"
                        SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                        SelectionChanged="OnSectionSelectionChanged"
                        Style="{DynamicResource Control.SectionList}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconPath Width="16" Height="16" Margin="0,2,8,0" IconKey="{Binding Glyph}" Stroke="{DynamicResource Brush.TextSecondary}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ListBox
                x:Name="CompactSectionSelector"
                Margin="0,0,0,12"
                AutomationProperties.Name="Settings section selector"
                DockPanel.Dock="Top"
                ItemsSource="{Binding FilteredSections}"
                SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectionChanged="OnSectionSelectionChanged">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource Control.SectionList}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsWideLayout, ElementName=Root}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}">
                        <Setter Property="MinHeight" Value="64" />
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <controls:IconPath Width="16" Height="16" Margin="0,0,0,6" HorizontalAlignment="Center"
                                IconKey="{Binding Glyph}" Stroke="{DynamicResource Brush.BrandCyan}" />
                            <TextBlock Text="{Binding Label}" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:WorkspaceScrollViewport x:Name="SectionScrollViewport" CueText="More settings below">
                <StackPanel>
                    <Border Padding="16" Margin="0,0,0,12" Style="{DynamicResource Control.CanvasInsetCard}"
                        Visibility="{Binding HasNoSettingsMatches, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="No matching section. Try titles, folders, sharing or updates, or clear your search."
                            TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <sections:SettingsSectionHostView />
                </StackPanel>
            </controls:WorkspaceScrollViewport>
        </DockPanel>
    </Grid>
</UserControl>
