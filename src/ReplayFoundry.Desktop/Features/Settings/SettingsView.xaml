<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.SettingsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:sections="clr-namespace:ReplayFoundry.Desktop.Features.Settings.Sections"
    Background="Transparent">
    <Grid MaxWidth="1500" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Style="{DynamicResource Text.WorkspaceTitle}" Text="Settings" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Body}" Text="{Binding PersistenceBannerText}" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="True">
            <Border
                Width="240"
                Margin="0,0,12,0"
                DockPanel.Dock="Left">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Control.CanvasPane}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Preferences" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,5,0,18"
                        Style="{DynamicResource Text.Meta}"
                        Text="Your workspace, tools and connections."
                        TextWrapping="Wrap" />
                    <ListBox
                        Grid.Row="2"
                        AutomationProperties.Name="Settings section selector"
                        ItemsSource="{Binding Sections}"
                        SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                        SelectionChanged="OnSectionSelectionChanged"
                        Style="{DynamicResource Control.SectionList}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}" />
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:IconPath Width="16" Height="16" Margin="0,2,8,0" IconKey="{Binding Glyph}" Stroke="{DynamicResource Brush.TextSecondary}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <ComboBox
                x:Name="CompactSectionSelector"
                Margin="0,0,0,12"
                AutomationProperties.Name="Settings section selector"
                DockPanel.Dock="Top"
                ItemsSource="{Binding Sections}"
                SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                SelectionChanged="OnSectionSelectionChanged">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource Control.FormComboBox}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <controls:WorkspaceScrollViewport x:Name="SectionScrollViewport" CueText="More settings below">
                <sections:SettingsSectionHostView />
            </controls:WorkspaceScrollViewport>
        </DockPanel>
    </Grid>
</UserControl>
