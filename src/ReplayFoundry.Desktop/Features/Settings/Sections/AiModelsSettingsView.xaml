<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.AiModelsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border
        Style="{DynamicResource Control.CanvasPane}">
        <StackPanel>
            <TextBlock
                Style="{DynamicResource Text.WorkspaceTitle}"
                Text="Local tools &amp; AI" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{DynamicResource Text.Body}"
                TextWrapping="Wrap"
                Text="Choose how Replay Foundry finds your moments and writes about them. All learning stays on this PC." />
            <Border
                Margin="0,16,0,0"
                Style="{DynamicResource Control.CanvasInsetCard}"
                DataContext="{Binding Learning}">
                <StackPanel>
                    <controls:FoundryHeading
                        Text="Clip selection"
                        Style="{DynamicResource Text.SectionTitle}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="Foundry Taste learns which moments you prefer." />
                    <CheckBox
                        Margin="0,10,0,0"
                        Content="Learn from my clip choices"
                        IsEnabled="{Binding IsAvailable}"
                        IsChecked="{Binding Enabled, Mode=TwoWay}"
                        Style="{DynamicResource Control.FormCheckBox}" />
                    <WrapPanel
                        Margin="0,8,0,0">
                        <TextBlock
                            Text="{Binding State}"
                            Foreground="{DynamicResource Brush.BrandCyan}"
                            FontWeight="SemiBold"
                            Margin="0,0,12,4" />
                        <TextBlock
                            Text="{Binding Summary}"
                            Style="{DynamicResource Text.Meta}"
                            Margin="0,0,0,4" />
                    </WrapPanel>
                    <TextBlock
                        Text="{Binding Status}"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
            <Border
                Margin="0,12,0,0"
                Style="{DynamicResource Control.CanvasInsetCard}">
                <StackPanel>
                    <controls:FoundryHeading
                        Text="Title &amp; description"
                        Style="{DynamicResource Text.SectionTitle}" />
                    <CheckBox
                        Margin="0,10,0,0"
                        Content="Use local AI for rewrites"
                        AutomationProperties.Name="Use local AI when rewriting Studio and Publish titles"
                        IsChecked="{Binding UseLocalAiForEditorialRerolls, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource Control.FormCheckBox}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialRerollPreferenceDetail}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="For new clips, choose the writing method in Generate." />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource Brush.StatusInfo}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialRerollPreferenceNotice}"
                        Visibility="{Binding HasEditorialRerollPreferenceNotice, Converter={StaticResource BoolToVisibility}}" />
                    <Border
                        Margin="0,12,0,12"
                        Height="1"
                        Background="{DynamicResource Brush.BorderSubtle}" />
                    <CheckBox
                        Content="Learn from my wording corrections"
                        AutomationProperties.Name="Learn locally from saved title and description corrections"
                        IsChecked="{Binding IsEditorialMetadataPreferenceLearningEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{DynamicResource Control.FormCheckBox}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="Optional, off by default. Uses wording you save or mark reviewed in Studio. Clip likes do not approve wording." />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource Brush.StatusInfo}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialMetadataPreferenceLearningNotice}"
                        Visibility="{Binding HasEditorialMetadataPreferenceLearningNotice, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
            <Expander
                Margin="0,16,0,0"
                Header="Learning data &amp; model controls"
                Style="{DynamicResource Control.QuietExpander}">
                <StackPanel
                    Margin="0,10,0,0">
                    <StackPanel
                        DataContext="{Binding Learning}">
                        <TextBlock
                            Style="{DynamicResource Text.FormLabel}"
                            Text="Clip learning" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{DynamicResource Text.Meta}"
                            TextWrapping="Wrap"
                            Text="Ratings, finished renders, successful publishes, moments you bring into Studio and cuts you create provide feedback. Neutral is a rating; an untouched clip is not a dislike." />
                        <TextBlock
                            Margin="0,6,0,0"
                            Style="{DynamicResource Text.Meta}"
                            TextWrapping="Wrap"
                            Text="Updates run automatically on the CPU. A personal model affects suggestions only after it passes checks on separate recordings." />
                        <WrapPanel
                            Margin="0,10,0,0">
                            <Button
                                Content="Check for an update"
                                Command="{Binding TrainCommand}"
                                Style="{DynamicResource Control.GhostButton}"
                                Margin="0,0,8,8"
                                ToolTip="An initial training attempt needs eight rated clips and more than one rating choice. Activating a model needs substantially more feedback and successful validation."
                                ToolTipService.ShowOnDisabled="True" />
                            <Button
                                Content="Forget clip preferences"
                                Command="{Binding ResetCommand}"
                                Style="{DynamicResource Control.DestructiveButton}"
                                Margin="0,0,0,8"
                                ToolTip="Clears the personal clip model and its learning history. Your clips and projects stay." />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{DynamicResource Text.FormLabel}"
                        Text="Writing learning" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialMetadataPreferenceLearningDetail}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialMetadataPreferenceLearningPrivacy}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialMetadataPreferenceLearningEnabledAtText}" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialMetadataPreferenceLearningPersistence}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{DynamicResource Text.FormLabel}"
                        Text="Rewrite preference" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="{Binding EditorialRerollPreferencePersistence}" />
                </StackPanel>
            </Expander>
            <Expander
                Margin="0,12,0,0"
                Header="Installed tools &amp; maintenance"
                Style="{DynamicResource Control.QuietExpander}">
                <StackPanel>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{DynamicResource Text.Meta}"
                        TextWrapping="Wrap"
                        Text="These are availability indicators for installed tools. They do not turn learning on or off." />
                    <Border
                        Margin="0,16,0,0"
                        Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource Brush.SurfaceInset}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:FoundryFrameMark
                                Width="70"
                                Height="60"
                                Margin="0,0,18,0"
                                IconKey="Icon.Spark" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Style="{DynamicResource Text.SectionTitle}"
                                    Text="{Binding RuntimeProfileStatus}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Style="{DynamicResource Text.Body}"
                                    Text="{Binding AiStatus}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{DynamicResource Text.Meta}"
                                    Text="{Binding ToolchainStatus}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <controls:FoundryHeading
                        Margin="0,24,0,4"
                        Style="{DynamicResource Text.SectionTitle}"
                        Text="What these tools do" />
                    <ItemsControl
                        Margin="0,8,-16,0"
                        ItemsSource="{Binding AiCapabilities}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid
                                    Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,16,16"
                                    Style="{DynamicResource Control.CanvasInsetCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition
                                                Height="Auto" />
                                            <RowDefinition
                                                Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Capability}"
                                            TextWrapping="Wrap" />
                                        <controls:StatusBadge
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Text="{Binding Status}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,6,0,0"
                                            Style="{DynamicResource Text.Meta}"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <controls:FoundryHeading
                        Margin="0,8,0,0"
                        Style="{DynamicResource Text.SectionTitle}"
                        Text="Manage your tools" />
                    <TextBlock
                        Margin="0,6,0,12"
                        Style="{DynamicResource Text.Meta}"
                        Text="Update for the latest tools, or repair an installation that isn't working."
                        TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button
                            AutomationProperties.Name="Install or update Advanced AI"
                            Command="{Binding AddAdvancedAiCommand}"
                            Content="{Binding AdvancedAiActionLabel}"
                            Margin="0,0,8,8"
                            Style="{DynamicResource Control.PrimaryButton}" />
                        <Button
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Repair local tools"
                            Command="{Binding RepairRuntimePacksCommand}"
                            Content="Repair installed tools"
                            Style="{DynamicResource Control.GhostButton}" />
                        <Button
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Open local tools folder"
                            Command="{Binding OpenRuntimePackFolderCommand}"
                            Content="Open tools folder"
                            Style="{DynamicResource Control.GhostButton}" />
                        <Button
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Remove Advanced AI"
                            Command="{Binding RemoveAdvancedAiCommand}"
                            Content="Remove Advanced AI"
                            Style="{DynamicResource Control.DestructiveButton}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Core clip discovery stays available after Advanced AI is removed. Projects and rendered videos are never removed by these buttons."
                        TextWrapping="Wrap" />
                    <Border
                        Margin="0,12,0,0"
                        Padding="10"
                        Style="{DynamicResource Control.CanvasInsetCard}"
                        Visibility="{Binding HasRuntimePackNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Style="{DynamicResource Text.Body}"
                            Text="{Binding RuntimePackNotice}"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>