<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.PrivacyDiagnosticsSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <StackPanel>
        <Border Style="{DynamicResource Control.CanvasPane}">
            <StackPanel>
                <Grid>
                    <StackPanel>
                        <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="YouTube connection" />
                        <TextBlock
                            Margin="0,4,120,0"
                            Style="{DynamicResource Text.Body}"
                            Text="YouTube is optional and off by default. Allowing access does not connect an account or send anything by itself."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="{Binding YouTubeConnectionPermissionStatus}" />
                </Grid>

                <Border Margin="0,14,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontWeight="SemiBold"
                                Text="Let Publish connect to YouTube" />
                            <TextBlock
                                Margin="0,4,16,0"
                                Style="{DynamicResource Text.Meta}"
                                Text="{Binding YouTubeConnectionPermissionDetail}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,5,16,0"
                                Style="{DynamicResource Text.Meta}"
                                Text="{Binding YouTubeConnectionEnabledAtText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Button
                                AutomationProperties.Name="Enable YouTube connections"
                                Command="{Binding EnableYouTubeConnectionsCommand}"
                                Content="Allow YouTube">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Control.PrimaryButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsYouTubeConnectionEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button
                                AutomationProperties.Name="Disable YouTube connections"
                                Command="{Binding DisableYouTubeConnectionsCommand}"
                                Content="Turn off YouTube &amp; disconnect">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Control.DestructiveButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsYouTubeConnectionEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border
                    Margin="0,12,0,0"
                    Padding="12"
                    Style="{DynamicResource Control.CanvasInsetCard}"
                    Visibility="{Binding HasOnlineConnectionNotice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding OnlineConnectionNotice}"
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasPane}">
            <StackPanel>
                <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Learning on this PC" />
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Body}" TextWrapping="Wrap"
                    Text="Writing corrections and clip preferences have separate local learning switches. Neither enables community sharing." />
                <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{DynamicResource Control.GhostButton}"
                    Content="Manage writing learning →" AutomationProperties.Name="Open local learning settings"
                    Command="{Binding SelectSectionCommand}" CommandParameter="{Binding WritingSection}" />
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasPane}">
            <StackPanel DataContext="{Binding SharedTraining}">
                <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Help improve the writer" />
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Body}" TextWrapping="Wrap">
                    <Run Text="Optional: automatically share future game names, generated titles and descriptions, your saved wording edits," />
                    <Run Text="and the text observations and speech excerpts used to write them with Expired Soda Studios LLC for AI evaluation and training." />
                    <Run Text="Text may contain names or personal information mentioned in your recording. Only contribute content you have permission to share." />
                </TextBlock>
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap">
                    <Run Text="No audio, video, images, recording filenames, local paths, email addresses from your account, or YouTube credentials are uploaded." />
                    <Run Text="Existing feedback is not uploaded retroactively. Records are kept for up to one year." />
                    <Run Text="Turning sharing off clears pending uploads; deleting contributions removes stored records, but cannot undo training already completed." />
                </TextBlock>
                <controls:StatusBadge Margin="0,12,0,0" HorizontalAlignment="Left" Text="{Binding ConsentStatus}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Margin="0,0,8,8" Style="{DynamicResource Control.PrimaryButton}" Content="Agree and share text" Command="{Binding EnableCommand}" />
                    <Button Margin="0,0,8,8" Style="{DynamicResource Control.GhostButton}" Content="Stop sharing" Command="{Binding DisableCommand}" />
                    <Button Margin="0,0,8,8" Style="{DynamicResource Control.GhostButton}" Content="Retry pending uploads" Command="{Binding SendCommand}" />
                    <Button Margin="0,0,8,8" Style="{DynamicResource Control.GhostButton}" Content="Delete my contributions" Command="{Binding DeleteCommand}" />
                </WrapPanel>
                <TextBlock Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" Text="{Binding Status}" />
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasPane}">
            <StackPanel>
                <Grid>
                    <StackPanel Margin="0,0,170,0">
                        <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Optional research sharing" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Body}"
                            Text="Help improve future clip suggestions with anonymous measurements about what you kept or skipped. This is off by default."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="{Binding ResearchParticipationStatus}" />
                </Grid>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding ResearchParticipationDetail}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,7,0,0"
                    Foreground="{DynamicResource Brush.StatusInfo}"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding ResearchDeliveryStatus}"
                    TextWrapping="Wrap" />

                <WrapPanel Margin="0,14,0,0">
                    <Button
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Enable anonymous research contribution"
                        Command="{Binding EnableResearchParticipationCommand}"
                        Content="Opt in">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Control.PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResearchParticipationEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        Margin="0,0,8,0"
                        AutomationProperties.Name="Disable anonymous research contribution"
                        Command="{Binding DisableResearchParticipationCommand}"
                        Content="Turn off research sharing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Control.GhostButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResearchParticipationEnabled}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button
                        AutomationProperties.Name="Delete local research contribution records"
                        Command="{Binding DeleteResearchFeedbackCommand}"
                        Content="Delete local research data"
                        Style="{DynamicResource Control.DestructiveButton}" />
                </WrapPanel>

                <TextBlock
                    Margin="0,12,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="This consent is separate from YouTube. It never authorizes media upload, and changing it does not affect local clip discovery or personalization."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasPane}">
            <StackPanel>
                <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="What stays private" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{DynamicResource Text.Body}"
                    Text="{Binding PrivacySummary}"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="What can leave this PC" />
                <TextBlock
                    Margin="0,5,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding YouTubeDataSummary}"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="What is stored" />
                <TextBlock
                    Margin="0,5,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding YouTubeStorageSummary}"
                    TextWrapping="Wrap" />

                <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="Control remains with you" />
                <TextBlock
                    Margin="0,5,0,0"
                    Style="{DynamicResource Text.Meta}"
                    TextWrapping="Wrap">
                    <Run Text="Enabling YouTube does not perform a connection attempt. Connect, refresh, status check, upload, schedule, thumbnail, and playlist actions remain explicit. " />
                    <Run Text="You can disable access here, disconnect in Publish, clear local publish history, and manage or delete uploaded videos in YouTube Studio." />
                </TextBlock>

                <TextBlock
                    Margin="0,14,0,0"
                    Foreground="{DynamicResource Brush.StatusInfo}"
                    Style="{DynamicResource Text.Meta}"
                    Text="Google OAuth and YouTube actions are governed by Google's privacy policy, YouTube's terms, and the permissions shown in Google's browser consent screen."
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding DiagnosticsStatus}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
