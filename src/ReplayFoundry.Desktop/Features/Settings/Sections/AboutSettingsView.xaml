<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.AboutSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}">
        <StackPanel>
            <TextBlock Style="{DynamicResource Text.WorkspaceTitle}" Text="About &amp; updates" />
            <TextBlock
                Margin="0,10,0,0"
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="16"
                FontWeight="SemiBold"
                Text="{Binding VersionText}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,6,0,0"
                Style="{DynamicResource Text.Body}"
                Text="A free workspace for finding, editing, organizing, and publishing gameplay clips on your PC."
                TextWrapping="Wrap" />
            <Border Margin="0,18,0,0" Style="{DynamicResource Control.CanvasInsetCard}" DataContext="{Binding Updates}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Application updates" />
                    <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                        Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                        AutomationProperties.Name="Check for Replay Foundry updates" />
                    <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Body}"
                        Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <CheckBox Margin="0,14,0,0" Content="Check automatically"
                        IsEnabled="{Binding IsAvailable}" IsChecked="{Binding AutomaticChecksEnabled, Mode=TwoWay}" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}"
                        Text="Checks GitHub for new app versions. Your videos and projects stay on this PC. Downloads and installation wait for your choice."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <controls:StatusBadge
                Margin="0,14,0,0"
                Text="Core creation remains free · support is optional" />
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Margin="0,0,8,0" Style="{DynamicResource Control.CanvasInsetCard}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Application" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Free to use" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="No trial clock or payment needed for core features" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="4,0" Style="{DynamicResource Control.CanvasInsetCard}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Processing" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Local by design" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="Installed tools and local AI stay on this PC" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="8,0,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Creative extras" />
                        <TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Optional content" />
                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="Future stickers, sounds, and templates never unlock core features" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
