<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Library.LibraryView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:ReplayFoundry.Desktop.Features.Library.DesignTime"
    xmlns:categories="clr-namespace:ReplayFoundry.Desktop.Features.Library.Sections"
    xmlns:filters="clr-namespace:ReplayFoundry.Desktop.Features.Library.Sections"
    xmlns:content="clr-namespace:ReplayFoundry.Desktop.Features.Library.Sections"
    xmlns:details="clr-namespace:ReplayFoundry.Desktop.Features.Library.Sections"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:LibraryDesignViewModel, IsDesignTimeCreatable=True}"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:FoundryPageHeader MaxWidth="1600" Title="Your library" IconKey="Icon.Folder"
            Description="Finished clips, ready to revisit or share." />
            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="MinHeight" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                <Setter Property="MinHeight" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid
                    x:Name="WideLayout"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsStandardLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <categories:LibraryCategoryRailView Grid.Column="0" Margin="0,0,12,0" />
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <filters:LibraryFilterBarView />
                        <content:LibraryContentView Grid.Row="1" Margin="0,12,0,0" />
                    </Grid>
                    <details:LibraryDetailsView Grid.Column="2" />
                </Grid>

                <Grid
                    x:Name="StandardLayout"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStandardLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <categories:LibraryCategoryRailView Grid.Column="0" Margin="0,0,12,0" />
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <filters:LibraryFilterBarView />
                        <content:LibraryContentView Grid.Row="1" Margin="0,12,0,0" />
                    </Grid>
                    <details:LibraryDetailsView Grid.Column="2" />
                </Grid>

                <ScrollViewer
                    x:Name="CompactLayout"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel>
                        <categories:LibraryCategoryRailView />
                        <filters:LibraryFilterBarView Margin="0,12,0,0" />
                        <content:LibraryContentView Margin="0,12,0,0" />
                        <details:LibraryDetailsView Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <Border
                    MaxWidth="1600"
                    MinHeight="280"
                    Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.SurfacePanel}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="0"
                    CornerRadius="7"
                    Visibility="{Binding ShouldShowPlaceholder, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:EmptyState AutomationProperties.Name="Library content status" IconKey="Icon.Folder"
                            Title="Your library couldn't load"
                            Description="Close and reopen Replay Foundry to try again. Your video files are still on this PC." />
                    </StackPanel>
                </Border>
            </Grid>
    </Grid>
</UserControl>
