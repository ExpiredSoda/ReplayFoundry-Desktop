<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Library.Sections.LibraryFilterBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border
        Style="{DynamicResource Control.SectionCard}"
        AutomationProperties.Name="Library search and filters">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Find in library" />
                    <TextBlock
                        Margin="0,3,48,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Find a finished clip by title, game or filename."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Width="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="Clear library filters"
                    AutomationProperties.HelpText="Clears search and all library filter selections."
                    Command="{Binding ClearFiltersCommand}"
                    Content="Icon.Close"
                    ContentTemplate="{StaticResource IconButtonContentTemplate}"
                    Style="{DynamicResource Control.IconButton}"
                    ToolTip="Clear filters"
                    Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,12,0,0">
                <TextBox
                    AutomationProperties.Name="Search library"
                    AutomationProperties.HelpText="Search remains in memory and does not index files."
                    Style="{DynamicResource Control.InlineSearchTextBox}"
                    Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Search Library" />
                <TextBlock
                    Margin="14,0"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Text="Search by title, game, format, or file name">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Expander Grid.Row="2" Margin="0,8,0,0" Header="Filters &amp; organization" IsExpanded="False"
                      AutomationProperties.Name="Library filters and organization" Style="{DynamicResource Control.QuietExpander}">
            <WrapPanel Margin="0,4,0,0">
                <StackPanel Width="128" Margin="0,0,10,10">
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Type" />
                    <ComboBox
                        AutomationProperties.Name="Library mode filter"
                        ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding ModeFilter, Mode=TwoWay}"
                        Style="{DynamicResource Control.InlineSelectorComboBox}" />
                </StackPanel>
                <StackPanel Width="118" Margin="0,0,10,10">
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Status" />
                    <ComboBox
                        AutomationProperties.Name="Library status filter"
                        ItemsSource="{Binding Statuses}"
                        SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                        Style="{DynamicResource Control.InlineSelectorComboBox}" />
                </StackPanel>
                <StackPanel Width="116" Margin="0,0,10,10">
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Created" />
                    <ComboBox
                        AutomationProperties.Name="Library date filter"
                        ItemsSource="{Binding Dates}"
                        SelectedItem="{Binding DateFilter, Mode=TwoWay}"
                        Style="{DynamicResource Control.InlineSelectorComboBox}" />
                </StackPanel>
                <StackPanel Width="152" Margin="0,0,10,10">
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Sort" />
                    <ComboBox
                        Width="152"
                        AutomationProperties.Name="Library sort order"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SortBy, Mode=TwoWay}"
                        Style="{DynamicResource Control.InlineSelectorComboBox}" />
                </StackPanel>
                <StackPanel Width="128" Margin="0,0,0,10">
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="Group by" />
                    <ComboBox
                        AutomationProperties.Name="Organize Library by"
                        ItemsSource="{Binding OrganizationOptions}"
                        SelectedValue="{Binding OrganizationMode, Mode=TwoWay}"
                        SelectedValuePath="Key"
                        Style="{DynamicResource Control.InlineSelectorComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>

            </Expander>
            <Border Grid.Row="3" Padding="0,6,0,0" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0">
                <DockPanel LastChildFill="True">
                    <Button
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Refresh known Library entries"
                        Command="{Binding RefreshLibraryCommand}"
                        Content="Refresh"
                        Style="{DynamicResource Control.GhostButton}" />
                    <WrapPanel VerticalAlignment="Center">
                        <controls:IconPath
                            Width="13"
                            Height="13"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center"
                            IconKey="Icon.Filter"
                            Stroke="{DynamicResource Brush.StatusInfo}"
                            StrokeThickness="1.2"
                            Stretch="Uniform" />
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding FilterSummary}" />
                        <TextBlock Margin="8,0,0,0" Style="{DynamicResource Text.Meta}" Text="·" />
                        <TextBlock Margin="8,0,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding OrganizationSummary}" />
                    </WrapPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
