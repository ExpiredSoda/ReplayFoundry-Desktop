<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Library.Sections.LibraryCategoryRailView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:library="clr-namespace:ReplayFoundry.Desktop.Features.Library"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Library categories">
        <Grid>
            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="CATEGORIES" />
            <ListBox
                Margin="0,34,0,0"
                AutomationProperties.Name="Library category selector"
                ItemsSource="{Binding Categories}"
                ItemContainerStyle="{DynamicResource Control.CanvasRailListBoxItem}"
                SelectedValue="{Binding SelectedCategory, Mode=TwoWay}"
                SelectedValuePath="Key"
                >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPath Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IconKey="{Binding Glyph}" Stroke="{DynamicResource Brush.StatusInfo}" StrokeThickness="1.2" Stretch="Uniform" />
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource Control.SectionList}">
                        <Setter Property="Margin" Value="0,34,0,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type library:LibraryView}}}" Value="True">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
                                </Setter>
                                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
