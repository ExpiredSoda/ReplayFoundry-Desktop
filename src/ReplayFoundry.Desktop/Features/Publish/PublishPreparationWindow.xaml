<Window
    x:Class="ReplayFoundry.Desktop.Features.Publish.PublishPreparationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:sections="clr-namespace:ReplayFoundry.Desktop.Features.Publish.Sections"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Prepare YouTube Video"
    Style="{DynamicResource Control.ThemedWindow}"
    Width="1380"
    Height="900"
    MinWidth="760"
    MinHeight="600"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="/ReplayFoundry.Desktop;component/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True"
    KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowTitleBar Subtitle="Prepare for YouTube" Status="Review before upload" />
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ReviewColumn" Width="1.04*" />
                <ColumnDefinition x:Name="GutterColumn" Width="16" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0.96*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TabControl x:Name="CompactReviewTabs" Grid.ColumnSpan="3" Margin="0,0,0,8"
                AutomationProperties.Name="YouTube preparation sections"
                SelectedIndex="0" SelectionChanged="CompactReviewTabs_SelectionChanged" Visibility="Collapsed">
                <TabItem Header="Video preview" AutomationProperties.Name="Show YouTube video preview" />
                <TabItem Header="Details &amp; upload" AutomationProperties.Name="Show YouTube details and upload review" />
            </TabControl>

            <Border x:Name="ReviewPane" Grid.Row="1" Style="{DynamicResource Control.SectionCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Video review" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="Play the finished Studio video, drag the timeline, or use Space and the arrow keys."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="SelectedAssetTitle"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Video being prepared for YouTube"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="{Binding SelectedAsset.Title}"
                            TextTrimming="CharacterEllipsis" />
                        <controls:StatusBadge
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding AssetResolution}" />
                    </Grid>
                    <Border
                        x:Name="PreviewCanvas"
                        Grid.Row="2"
                        MinHeight="240"
                        Background="Black"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        ClipToBounds="True">
                        <Grid>
                            <MediaElement
                                x:Name="PreviewPlayer"
                                LoadedBehavior="Manual"
                                MediaEnded="PreviewPlayer_MediaEnded"
                                MediaFailed="PreviewPlayer_MediaFailed"
                                MediaOpened="PreviewPlayer_MediaOpened"
                                ScrubbingEnabled="True"
                                Stretch="Uniform"
                                UnloadedBehavior="Manual" />
                            <Border
                                x:Name="PreviewStatusSurface"
                                Margin="12"
                                Padding="10,7"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Brush.OverlaySurface}"
                                CornerRadius="7">
                                <StackPanel MinWidth="150">
                                    <TextBlock
                                        x:Name="PreviewStatusText"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        FontSize="11"
                                        Text="Loading preview…"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        x:Name="PreviewLoadingProgress"
                                        Margin="0,7,0,0"
                                        AutomationProperties.Name="Loading publish preview"
                                        IsIndeterminate="True"
                                        Style="{DynamicResource Control.ProgressBar.Compact}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Slider
                        x:Name="PreviewPosition"
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="Video preview position"
                        IsMoveToPointEnabled="True"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="PreviewPosition_ValueChanged" />
                    <Grid Grid.Row="4" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button
                                AutomationProperties.Name="Play or pause preview"
                                Click="PlayPause_Click"
                                Style="{DynamicResource Control.PrimaryIconButton}"
                                ToolTip="Play or pause (Space)">
                                <controls:IconPath x:Name="PlayPauseIcon" Width="15" Height="15" IconKey="Icon.Play" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Rewind five seconds"
                                Click="Back_Click"
                                Style="{DynamicResource Control.IconButton}"
                                ToolTip="Rewind five seconds (Left)">
                                <controls:IconPath Width="15" Height="15" IconKey="Icon.Rewind" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                AutomationProperties.Name="Forward five seconds"
                                Click="Forward_Click"
                                Style="{DynamicResource Control.IconButton}"
                                ToolTip="Forward five seconds (Right)">
                                <controls:IconPath Width="15" Height="15" IconKey="Icon.FastForward" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                            </Button>
                        </StackPanel>
                        <TextBlock
                            x:Name="PreviewTimeText"
                            Grid.Column="1"
                            Margin="14,0"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Text.Meta}"
                            Text="0:00 / 0:00" />
                        <TextBlock
                            Grid.Column="2"
                            MaxWidth="220"
                            VerticalAlignment="Center"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding AssetDetail}"
                            TextAlignment="Right"
                            TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer
                x:Name="DetailsPane"
                Grid.Row="1"
                Grid.Column="2"
                CanContentScroll="False"
                HorizontalScrollBarVisibility="Disabled"
                PanningDeceleration="0.001"
                PanningMode="VerticalOnly"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                    <sections:PublishAssetView />
                    <sections:PublishMetadataView Margin="0,12,0,0" />
                    <sections:PublishOutputSettingsView Margin="0,12,0,0" />
                    <sections:PublishChecklistView Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" Padding="0,12,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MaxWidth="720"
                        VerticalAlignment="Center"
                        Style="{DynamicResource Text.Meta}"
                        Text="Save draft keeps these details only on this PC. The upload action in the review checklist is the only step that sends this video to YouTube."
                        TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button MinWidth="96" Click="Close_Click" Content="Close" Style="{DynamicResource Control.WorkspaceButton}" />
                        <Button
                            MinWidth="112"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Save local YouTube draft"
                            Click="SaveDraft_Click"
                            Command="{Binding SaveDraftCommand}"
                            Content="Save draft"
                            Style="{DynamicResource Control.PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
