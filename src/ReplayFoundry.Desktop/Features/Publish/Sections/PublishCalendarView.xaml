<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishCalendarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Publish.Sections">
    <Border
        AutomationProperties.Name="YouTube schedule calendar"
        Padding="14" Style="{DynamicResource Control.CanvasPane}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button AutomationProperties.Name="Previous month" Command="{Binding PreviousCalendarCommand}"
                        Content="Icon.ChevronLeft" ContentTemplate="{StaticResource IconButtonContentTemplate}"
                        Style="{DynamicResource Control.IconButton}" ToolTip="Previous month" />
                    <Button Margin="4,0" Command="{Binding TodayCalendarCommand}" Content="Today" Style="{DynamicResource Control.GhostButton}" />
                    <Button AutomationProperties.Name="Next month" Command="{Binding NextCalendarCommand}"
                        Content="Icon.ChevronRight" ContentTemplate="{StaticResource IconButtonContentTemplate}"
                        Style="{DynamicResource Control.IconButton}" ToolTip="Next month" />
                </StackPanel>
                <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="{Binding CalendarRangeTitle}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="0,4,0,8" Text="{Binding CalendarTimeZoneLabel}" Style="{DynamicResource Text.Meta}"
                ToolTip="Drag a clip onto a day to prepare its schedule. You will review it before anything uploads." />
            <ItemsControl Grid.Row="2" ItemsSource="{Binding CalendarWeekdayHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Padding="4"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextMuted}"
                            Text="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ListBox
                x:Name="CalendarDaysList"
                Grid.Row="3"
                Height="192"
                Padding="0"
                AutomationProperties.Name="Publishing calendar days"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding CalendarDays}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                SelectedValuePath="Date"
                SelectedValue="{Binding SelectedCalendarDate, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.KeyboardFocus}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AgendaSummary}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            MinHeight="28"
                            Margin="1"
                            Padding="1"
                            AllowDrop="True"
                            CornerRadius="7"
                            DragEnter="Day_DragEnter"
                            DragLeave="Day_DragLeave"
                            DragOver="Day_DragOver"
                            Drop="Day_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.KineticCanvasPane}" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInActiveRange}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCanvas}" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.KineticGlowSoft}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.KineticGlowSoft}" />
                                        </DataTrigger>
                                        <Trigger Property="local:PublishCalendarView.IsDropTargetActive" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusInfo}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                        </Trigger>
                                        <Trigger Property="local:PublishCalendarView.IsDropTargetRejected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Cursor" Value="No" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel ToolTip="{Binding AgendaSummary}">
                                    <DockPanel ToolTip="{Binding AgendaSummary}">
                                        <TextBlock DockPanel.Dock="Right"
                                            Margin="5,0,0,0" FontSize="10" VerticalAlignment="Center"
                                            Foreground="{DynamicResource Brush.StatusWarning}"
                                            Text="{Binding MonthLabel}" />
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DayNumber}" FontSize="12" LineHeight="14" LineStackingStrategy="BlockLineHeight">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInActiveRange}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SlotCountLabel}" FontSize="10" LineHeight="12"
                                            LineStackingStrategy="BlockLineHeight" Style="{DynamicResource Text.Meta}" />
                                        <ItemsControl ItemsSource="{Binding Markers}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <controls:IconPath Width="10" Height="10" Margin="0,1,3,0" IconKey="{Binding Glyph}" Stretch="Uniform" StrokeThickness="1.3">
                                                    <controls:IconPath.Style><Style TargetType="controls:IconPath">
                                                        <Setter Property="Stroke" Value="{DynamicResource Brush.StatusInfo}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Stage}" Value="Public"><Setter Property="Stroke" Value="{DynamicResource Brush.StatusSuccess}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Stage}" Value="Attention"><Setter Property="Stroke" Value="{DynamicResource Brush.StatusWarning}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding Stage}" Value="Unconfirmed"><Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style></controls:IconPath.Style>
                                                </controls:IconPath>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </StackPanel>
                                <Border
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="7,4"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.StatusInfo}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding (local:PublishCalendarView.IsDropTargetActive), RelativeSource={RelativeSource AncestorType=Border}}"
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="DROP HERE" />
                                </Border>
                                <Border
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="7,4"
                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger
                                                    Binding="{Binding (local:PublishCalendarView.IsDropTargetRejected), RelativeSource={RelativeSource AncestorType=Border}}"
                                                    Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.StatusWarning}"
                                        Text="DATE HAS PASSED" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border
                Grid.Row="3"
                Panel.ZIndex="10"
                MaxWidth="380"
                Margin="10"
                Padding="11,9"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.StatusWarning}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Visibility="{Binding HasCalendarDropFeedback, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:IconPath
                        Width="15"
                        Height="15"
                        Margin="0,1,9,0"
                        VerticalAlignment="Top"
                        IconKey="Icon.Warning"
                        Stroke="{DynamicResource Brush.StatusWarning}"
                        StrokeThickness="1.3" />
                    <TextBlock
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Assertive"
                        AutomationProperties.Name="{Binding CalendarDropFeedback}"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Text="{Binding CalendarDropFeedback}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DockPanel Grid.Row="4" Margin="0,10,0,6">
                <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                    AutomationProperties.Name="Prepare selected Library video for selected date"
                    Command="{Binding CreatePlanCommand}" Content="Schedule selected"
                    Style="{DynamicResource Control.GhostButton}" />
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}"
                    Text="{Binding SelectedCalendarDayTitle}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <Grid Grid.Row="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding SelectedCalendarDaySlots}" AutomationProperties.Name="Selected day agenda">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Padding="6,7" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeLabel}" Style="{DynamicResource Text.Meta}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Margin="6,0,10,0" Text="{Binding Title}" ToolTip="{Binding Title}"
                                        Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Status}">
                                        <StackPanel.Style><Style TargetType="StackPanel">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PublicationStage}" Value="Public"><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.StatusSuccess}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding PublicationStage}" Value="Attention"><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.StatusWarning}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding PublicationStage}" Value="Unconfirmed"><Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextMuted}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style></StackPanel.Style>
                                        <controls:IconPath Width="12" Height="12" Margin="0,0,5,0" IconKey="{Binding Glyph}" Stretch="Uniform" StrokeThickness="1.3"
                                            Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=StackPanel}}" />
                                        <TextBlock MaxWidth="156" Text="{Binding Status}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Margin="6,10" Text="{Binding SelectedCalendarDaySummary}" Style="{DynamicResource Text.Meta}"
                    Visibility="{Binding HasSelectedCalendarDaySlots, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
