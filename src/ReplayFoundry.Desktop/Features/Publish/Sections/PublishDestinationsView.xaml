<UserControl x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishDestinationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Grid MinHeight="42" AutomationProperties.Name="YouTube connection">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <controls:FoundryHeading Text="Publish" FontSize="24" VerticalAlignment="Center" Style="{DynamicResource Text.SectionTitle}" />
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <Border Width="25" Height="18" Margin="8,0" Background="{DynamicResource Brush.PlatformYouTube}" CornerRadius="5" VerticalAlignment="Center">
                <Path Width="8" Height="9" Data="M 1,0 L 9,5 L 1,10 Z" Fill="{DynamicResource Brush.PlatformYouTubeGlyph}" Stretch="Fill" />
            </Border>
            <TextBlock MaxWidth="230" Text="{Binding ConnectionTitle}" ToolTip="{Binding ConnectionDetail}"
                TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
            <controls:StatusBadge Margin="10,0" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" />
            <Button Command="{Binding ConnectCommand}" Content="Connect channel"
                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisibility}}" Style="{DynamicResource Control.PrimaryButton}" />
            <Button Content="Channel options" Click="ChannelOptions_Click" Style="{DynamicResource Control.GhostButton}"
                AutomationProperties.Name="YouTube channel options" ToolTip="Connection details, refresh, and disconnect">
                <Button.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{Binding ConnectionTitle}" IsEnabled="False" />
                        <MenuItem Header="Refresh connection" Command="{Binding RefreshYouTubeCommand}" />
                        <MenuItem Header="Disconnect channel" Command="{Binding DisconnectCommand}" />
                        <Separator />
                        <MenuItem StaysOpenOnClick="True" IsEnabled="False">
                            <MenuItem.Header><TextBlock Width="300" TextWrapping="Wrap" Text="{Binding ConnectionDetail}" /></MenuItem.Header>
                        </MenuItem>
                        <MenuItem StaysOpenOnClick="True" IsEnabled="False">
                            <MenuItem.Header><TextBlock Width="300" TextWrapping="Wrap"
                                Text="Connect securely through Google in your browser. Windows protects the saved connection on this PC. Disconnect removes it. Each upload is reviewed before it is sent." />
                                </MenuItem.Header>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </WrapPanel>
    </Grid>
</UserControl>
