<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishDestinationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="YouTube connection">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="YouTube" />
                </StackPanel>
                <controls:StatusBadge
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding ConnectionStatus}" />
            </Grid>

            <Border Margin="0,14,0,0" Style="{DynamicResource Control.CanvasFilterPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="28"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.PlatformYouTube}"
                        CornerRadius="5">
                        <Path
                            Width="9"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 1,0 L 9,5 L 1,10 Z"
                            Fill="{DynamicResource Brush.PlatformYouTubeGlyph}"
                            Stretch="Fill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="{Binding ConnectionTitle}" />
                        <TextBlock Margin="0,4,12,0" Style="{DynamicResource Text.Meta}" Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <Button Command="{Binding ConnectCommand}" Content="Connect channel">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Control.PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Command="{Binding RefreshYouTubeCommand}" Content="Refresh" Style="{DynamicResource Control.GhostButton}"
                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Command="{Binding DisconnectCommand}" Content="Disconnect"
                            Style="{DynamicResource Control.DestructiveButton}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Expander Margin="0,8,0,0" Header="How connecting works" Style="{DynamicResource Control.QuietExpander}">
            <TextBlock
                Margin="0,12,0,0"
                Style="{DynamicResource Text.Meta}"
                TextWrapping="Wrap">
                <Run Text="First allow YouTube in Settings → Privacy &amp; connections, then choose Connect channel. " />
                <Run Text="You'll sign in securely with Google in your browser. Replay Foundry never asks for your Google password. " />
                <Run Text="Windows protects the saved connection on this PC. Disconnect removes it. You'll review each upload before it is sent." />
            </TextBlock>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
