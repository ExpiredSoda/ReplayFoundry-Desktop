<UserControl x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishQueueHistoryView" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Grid>
        <Grid.RowDefinitions><RowDefinition x:Name="PrimaryQueueRow" Height="*" /><RowDefinition x:Name="SecondaryQueueRow" Height="0" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueColumn" Width="0.85*" /><ColumnDefinition x:Name="HistoryColumn" Width="1.15*" /></Grid.ColumnDefinitions>
        <Border x:Name="QueueCard" Margin="0,0,6,0" Padding="14,10" Style="{DynamicResource Control.CanvasPane}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Cancel upload" Command="{Binding CancelPublishCommand}" Style="{DynamicResource Control.GhostButton}"
                        Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="Upload queue" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding OperationTitle}" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Margin="0,6" Height="5" Minimum="0" Maximum="100" Value="{Binding OperationPercentage, Mode=OneWay, TargetNullValue=0}"
                        IsIndeterminate="{Binding IsOperationIndeterminate}" AutomationProperties.Name="YouTube upload progress" />
                    <TextBlock Text="{Binding OperationDetail}" ToolTip="{Binding OperationDetail}" Style="{DynamicResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,12,0,0" Visibility="{Binding IsPublishing, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="No upload in progress" Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Margin="0,3,0,0" Text="Saved drafts stay local until you upload." Style="{DynamicResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
        <Border x:Name="HistoryCard" Grid.Column="1" Margin="6,0,0,0" Padding="14,10" Style="{DynamicResource Control.CanvasPane}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="View all" AutomationProperties.Name="View all YouTube history" Command="{Binding History.OpenCommand}" Style="{DynamicResource Control.GhostButton}" />
                        <Button Content="More" Click="HistoryOptions_Click" Style="{DynamicResource Control.GhostButton}" AutomationProperties.Name="Publishing history options">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Check YouTube status" Command="{Binding ReconcileYouTubeHistoryCommand}" />
                                    <MenuItem Header="Performance observations" Click="Analytics_Click"
                                        Visibility="{Binding Analytics.IsAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    <Separator />
                                    <MenuItem Header="Clear local history" Command="{Binding ClearHistoryCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Recent activity" ToolTip="{Binding History.DashboardSummary}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,5,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding History.RecentItems}" Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid Margin="0,3" ToolTip="{Binding Detail}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Status}" MaxWidth="200" TextTrimming="CharacterEllipsis" FontSize="11">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPublished}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="1" Margin="0,12,0,0" Text="Your uploads and scheduled releases will appear here." TextWrapping="Wrap"
                    Style="{DynamicResource Text.Meta}" Visibility="{Binding History.HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
