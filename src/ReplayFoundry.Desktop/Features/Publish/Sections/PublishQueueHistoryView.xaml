<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishQueueHistoryView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="SecondaryQueueRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="QueueColumn" Width="0.8*" />
            <ColumnDefinition x:Name="HistoryColumn" Width="1.2*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="QueueCard" Margin="0,0,6,0" Style="{DynamicResource Control.SectionCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="UPLOAD QUEUE" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                        Text="One upload runs at a time so progress and cancellation stay clear."
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding StatusText}" />
                </Grid>
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding QueueItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Control.CanvasInsetCard}">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{DynamicResource Text.Meta}"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource Brush.StatusInfo}"
                                        Text="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:EmptyState
                    Margin="0,14,0,0"
                    Description="Saved drafts remain local until you choose an upload action."
                    IconKey="Icon.Queue"
                    Title="No upload in progress"
                    Visibility="{Binding HasQueueItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>
        <Border x:Name="HistoryCard" Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource Control.SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="YOUTUBE HISTORY" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding History.DashboardSummary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="{Binding History.TotalBadge}" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <Button
                        Margin="0,0,8,8"
                        AutomationProperties.Name="View all YouTube history"
                        Command="{Binding History.OpenCommand}"
                        Content="View all history"
                        Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button
                        Margin="0,0,8,8"
                        Command="{Binding ReconcileYouTubeHistoryCommand}"
                        Content="Check YouTube status"
                        Style="{DynamicResource Control.GhostButton}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding ClearHistoryCommand}"
                        Content="Clear local history"
                        Style="{DynamicResource Control.DestructiveButton}" />
                </WrapPanel>
                <ItemsControl
                    Grid.Row="2"
                    Margin="0,7,0,0"
                    ItemsSource="{Binding History.RecentItems}"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Background="{DynamicResource Brush.SurfaceInset}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{DynamicResource Text.Meta}"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPublished}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid
                    Grid.Row="3"
                    Margin="0,7,0,0"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding History.DashboardRangeSummary}" />
                    <Button
                        Grid.Column="1"
                        AutomationProperties.Name="Open searchable YouTube history"
                        Command="{Binding History.OpenCommand}"
                        Content="Search the archive"
                        Style="{DynamicResource Control.GhostButton}"
                        Visibility="{Binding History.HasAdditionalDashboardItems, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
                <controls:EmptyState
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Description="Completed, scheduled, failed, and cancelled uploads appear here."
                    IconKey="Icon.History"
                    Title="No YouTube history yet"
                    Visibility="{Binding History.HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
