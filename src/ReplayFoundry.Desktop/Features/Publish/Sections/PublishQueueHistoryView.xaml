<UserControl x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishQueueHistoryView" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Padding="14" Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Uploads and recent activity">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="*" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="QueueCard" Padding="0,0,0,14" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelPublishCommand}" Style="{DynamicResource Control.GhostButton}"
                            AutomationProperties.Name="Cancel current YouTube upload" Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibility}}" />
                        <controls:FoundryHeading Text="Upload queue" Style="{DynamicResource Text.SectionTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Margin="0,6,0,0" Text="No upload in progress" Style="{DynamicResource Text.Meta}"
                        ToolTip="Saved drafts stay local until you choose to upload."
                        Visibility="{Binding IsPublishing, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel x:Name="ActiveUpload" Visibility="{Binding IsPublishing, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding QueueItems}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                    TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,6,0,0" Text="{Binding OperationTitle}" ToolTip="{Binding OperationTitle}"
                            Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Margin="0,8" Style="{DynamicResource Control.ProgressBar.Standard}" Minimum="0" Maximum="100"
                            Value="{Binding OperationPercentage, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding IsOperationIndeterminate}"
                            AutomationProperties.Name="YouTube upload progress" />
                        <TextBlock Text="{Binding OperationDetail}" ToolTip="{Binding OperationDetail}" Style="{DynamicResource Text.Meta}"
                            TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16" LineStackingStrategy="BlockLineHeight" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,14,0,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="View all" AutomationProperties.Name="View all YouTube history" Command="{Binding History.OpenCommand}" Style="{DynamicResource Control.GhostButton}" />
                        <Button Content="More" Click="HistoryOptions_Click" Style="{DynamicResource Control.GhostButton}" AutomationProperties.Name="Publishing history options">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Check YouTube status" Command="{Binding ReconcileYouTubeHistoryCommand}" />
                                    <MenuItem Header="Performance observations" Click="Analytics_Click"
                                        Visibility="{Binding Analytics.IsAvailable, Converter={StaticResource BoolToVisibility}}" />
                                    <Separator />
                                    <MenuItem Header="Clear local history" Command="{Binding ClearHistoryCommand}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Recent activity" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding History.DashboardRangeSummary}" ToolTip="{Binding History.DashboardSummary}" Style="{DynamicResource Text.Meta}" />
            </StackPanel>
            <Grid Grid.Row="2">
                <ListBox x:Name="ActivityItemsList" ItemsSource="{Binding History.RecentItems}"
                    AutomationProperties.Name="Recent YouTube publishing activity" Style="{DynamicResource Control.SectionList}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.CanContentScroll="False"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.SectionListItem}">
                            <Setter Property="Padding" Value="4,2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,2" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding AccessibilityName}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                                TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding Status}" TextWrapping="Wrap" FontSize="12">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPublished}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="0,3,0,0" Text="{Binding LocalDate, StringFormat={}{0:MMM d, yyyy}}" Style="{DynamicResource Text.Meta}" />
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="0,12,0,0" Text="Your uploads and scheduled releases will appear here." TextWrapping="Wrap"
                    Style="{DynamicResource Text.Meta}" Visibility="{Binding History.HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="{Binding History.DashboardSummary}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </Border>
</UserControl>
