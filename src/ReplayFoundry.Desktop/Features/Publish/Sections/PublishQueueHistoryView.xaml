<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishQueueHistoryView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="SecondaryQueueRow" Height="0" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="QueueColumn" Width="0.8*" />
            <ColumnDefinition x:Name="HistoryColumn" Width="1.2*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="QueueCard" Margin="0,0,6,0" Style="{DynamicResource Control.SectionCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Upload queue" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                        Text="One upload runs at a time so progress and cancellation stay clear."
                        TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Text="{Binding StatusText}" />
                </Grid>
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding QueueItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource Control.CanvasInsetCard}">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{DynamicResource Text.Meta}"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource Brush.StatusInfo}"
                                        Text="{Binding Status}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <controls:EmptyState
                    Margin="0,14,0,0"
                    Description="Saved drafts remain local until you choose an upload action."
                    IconKey="Icon.Queue"
                    Title="No upload in progress"
                    Visibility="{Binding HasQueueItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>
        <Border x:Name="HistoryCard" Grid.Column="1" Margin="6,0,0,0" Style="{DynamicResource Control.SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="YouTube history" />
                        <Expander Margin="0,10,0,0" Header="Performance observations"
                                  Visibility="{Binding Analytics.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                                           Text="Optional read-only analytics for your published clips. Saved results stay on this computer. Title variants are observational; audience, timing and the clip itself also affect results." />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Connect analytics" Command="{Binding Analytics.ConnectCommand}" Margin="0,0,6,0" />
                                    <Button Content="Disconnect analytics on this device" Command="{Binding Analytics.DisconnectCommand}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <DatePicker AutomationProperties.Name="Analytics start date" SelectedDate="{Binding Analytics.From}" Margin="0,0,6,0" />
                                    <DatePicker AutomationProperties.Name="Analytics end date" SelectedDate="{Binding Analytics.To}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Refresh observations" Command="{Binding Analytics.RefreshCommand}" Margin="0,0,6,0" />
                                    <Button Content="Clear saved observations" Command="{Binding Analytics.ClearCommand}" />
                                </WrapPanel>
                                <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" Text="{Binding Analytics.Status}" />
                                <TextBlock Margin="0,8,0,4" Style="{DynamicResource Text.Meta}" Text="Filter game, frame, caption look, or source" />
                                <TextBox Text="{Binding Analytics.ComparisonFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Filter comparable published clips" />
                                <TextBlock Margin="0,8,0,4" Style="{DynamicResource Text.Meta}" Text="Compare with a reference clip" />
                                <ComboBox ItemsSource="{Binding Analytics.ReferenceChoices}"
                                    SelectedValuePath="VideoId"
                                    SelectedValue="{Binding Analytics.ReferenceVideoId}"
                                    AutomationProperties.Name="Reference clip for performance comparison" />
                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox Content="Same game" IsChecked="{Binding Analytics.MatchGame}" Margin="0,0,8,0" />
                                    <CheckBox Content="Same dimensions" IsChecked="{Binding Analytics.MatchFormat}" Margin="0,0,8,0" />
                                    <CheckBox Content="Same channel" IsChecked="{Binding Analytics.MatchChannel}" />
                                    <CheckBox Content="Similar duration (±20% or 3s)" IsChecked="{Binding Analytics.MatchDuration}" Margin="0,0,8,0" />
                                    <CheckBox Content="Same upload-age band" IsChecked="{Binding Analytics.MatchAge}" ToolTip="Age at report end: 0–7, 8–30, 31–90, or over 90 days. Upload age can differ from public release age." />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,4" Text="{Binding Analytics.CohortSummary}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Analytics.Observations}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,10,0,0">
                                                <TextBlock Text="{Binding PublishedTitle}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" />
                                                <TextBlock Text="{Binding ProvenanceSummary}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" />
                                                <TextBlock Text="{Binding CaptionLookSummary}" ToolTip="{Binding CaptionLookDetails}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" />
                                                <TextBlock Text="{Binding SourceCutSummary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceCutSummary}" Style="{DynamicResource Text.Meta}" />
                                                <TextBlock Text="{Binding AgeSummary}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" />
                                                <TextBlock Text="{Binding ReportSummary}" TextWrapping="Wrap" Style="{DynamicResource Text.Meta}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding History.DashboardSummary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:StatusBadge
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="{Binding History.TotalBadge}" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <Button
                        Margin="0,0,8,8"
                        AutomationProperties.Name="View all YouTube history"
                        Command="{Binding History.OpenCommand}"
                        Content="Search all history"
                        Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button
                        Margin="0,0,8,8"
                        Command="{Binding ReconcileYouTubeHistoryCommand}"
                        Content="Check YouTube status"
                        Style="{DynamicResource Control.GhostButton}" />
                    <Button
                        Margin="0,0,0,8"
                        Command="{Binding ClearHistoryCommand}"
                        Content="Clear local history"
                        Style="{DynamicResource Control.DestructiveButton}" />
                </WrapPanel>
                <ItemsControl
                    Grid.Row="2"
                    Margin="0,7,0,0"
                    ItemsSource="{Binding History.RecentItems}"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,4"
                                Background="{DynamicResource Brush.SurfaceInset}"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,0,0,1"
                                Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            Style="{DynamicResource Text.Meta}"
                                            Text="{Binding Detail}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Status}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPublished}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid
                    Grid.Row="3"
                    Margin="0,7,0,0"
                    Visibility="{Binding History.HasItems, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding History.DashboardRangeSummary}" />
                </Grid>
                <controls:EmptyState
                    Grid.Row="4"
                    Margin="0,14,0,0"
                    Description="Completed, scheduled, failed, and cancelled uploads appear here."
                    IconKey="Icon.History"
                    Title="No YouTube history yet"
                    Visibility="{Binding History.HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
