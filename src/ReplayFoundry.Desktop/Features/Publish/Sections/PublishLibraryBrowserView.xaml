<UserControl x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishLibraryBrowserView" x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Padding="14" Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Publish Library videos">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LibraryResultSummary}" Style="{DynamicResource Text.Meta}" VerticalAlignment="Center" />
                <controls:FoundryHeading Text="Your clips" Style="{DynamicResource Text.SectionTitle}" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,10,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="124" /></Grid.ColumnDefinitions>
                    <Grid Margin="0,0,8,0">
                        <TextBox AutomationProperties.Name="Search finished Library videos" Style="{DynamicResource Control.InlineSearchTextBox}"
                            Background="{DynamicResource Brush.SurfaceInset}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                            Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=180}" ToolTip="Search title, filename, or output folder" />
                        <TextBlock Text="Search clips" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding LibrarySearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <ComboBox Grid.Column="1" AutomationProperties.Name="Filter Publish Library by date" ToolTip="When the finished video was added to Library"
                        ItemsSource="{Binding LibraryDateFilters}" SelectedItem="{Binding LibraryDateFilter, Mode=TwoWay}" Style="{DynamicResource Control.InlineSelectorComboBox}" />
                </Grid>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox Margin="0,0,8,0" ItemsSource="{Binding LibraryStatusFilters}" SelectedItem="{Binding LibraryStatusFilter, Mode=TwoWay}"
                        AutomationProperties.Name="Publication status" ToolTip="Show ready, scheduled, published, or all clips" Style="{DynamicResource Control.InlineSelectorComboBox}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LibraryFolderOptions}" SelectedValue="{Binding SelectedLibraryFolder, Mode=TwoWay}" SelectedValuePath="FullPath"
                        DisplayMemberPath="Label" AutomationProperties.Name="Filter Publish Library by folder" Style="{DynamicResource Control.InlineSelectorComboBox}" />
                    <Button Grid.Column="2" Margin="6,0,0,0" Content="Clear" Command="{Binding ClearLibraryFiltersCommand}"
                        AutomationProperties.Name="Clear Publish Library filters" Style="{DynamicResource Control.GhostButton}" />
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2">
                <ListBox x:Name="LibraryItemsList" AutomationProperties.Name="Finished videos ready for YouTube"
                    ItemsSource="{Binding LibraryItems}" SelectedValue="{Binding SelectedAsset, Mode=TwoWay}" SelectedValuePath="Asset"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown" PreviewMouseMove="Items_PreviewMouseMove"
                    Style="{DynamicResource Control.SectionList}">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Margin="0,3" ToolTip="{Binding CollectionDetail}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Height="58" Background="Black" CornerRadius="5" ClipToBounds="True" VerticalAlignment="Center">
                                <Grid>
                                    <controls:LocalThumbnailImage DecodePixelWidth="180" SourcePath="{Binding ThumbnailFullPath}" Stretch="Uniform"
                                        Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                    <controls:IconPath Width="20" Height="20" IconKey="Icon.Media" Stroke="{DynamicResource Brush.StatusInfo}"
                                        Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,2,0">
                                <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,3" Text="{Binding Detail}" Style="{DynamicResource Text.Meta}" TextTrimming="CharacterEllipsis" />
                                <controls:PublicationBadge DataContext="{Binding Publication}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <controls:EmptyState IconKey="Icon.Media" Title="{Binding LibraryEmptyTitle}" Description="{Binding LibraryEmptyDescription}"
                    Visibility="{Binding HasVisibleLibraryItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            <Border Grid.Row="3" Margin="0,8,0,0" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                <Grid>
                    <TextBlock Text="Select a clip to prepare it, or drag it onto a day." TextWrapping="Wrap">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding SelectedItem, ElementName=LibraryItemsList}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <DockPanel DataContext="{Binding SelectedItem, ElementName=LibraryItemsList}">
                        <DockPanel.Style><Style TargetType="DockPanel"><Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style></DockPanel.Style>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Prepare repost" Margin="0,0,6,0" Command="{Binding DataContext.PrepareRepostCommand, ElementName=Root}" CommandParameter="{Binding Asset}"
                                Visibility="{Binding HasRecordedUpload, Converter={StaticResource BoolToVisibility}}" ToolTip="Prepare a separate upload. You will review it before uploading."
                                Style="{DynamicResource Control.GhostButton}" />
                            <Button Content="{Binding ActionLabel}" Command="{Binding DataContext.PrepareAssetCommand, ElementName=Root}" CommandParameter="{Binding Asset}"
                                ToolTip="{Binding Publication.Detail}" Style="{DynamicResource Control.PrimaryButton}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource Text.Meta}" />
                    </DockPanel>
                </Grid>
            </Border>
            <DockPanel Grid.Row="4" Margin="0,8,0,0" Visibility="{Binding HasDrafts, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Command="{Binding PublishAllNowCommand}" Content="Publish all now" Style="{DynamicResource Control.GhostButton}"
                    AutomationProperties.Name="Publish every saved draft immediately" />
                <TextBlock Text="{Binding DraftSummary}" Style="{DynamicResource Text.Meta}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
