<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishLibraryBrowserView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Publish Library videos">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Library" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}" Text="See what still needs publishing. Open a scheduled or uploaded video's existing YouTube page." TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource Brush.StatusInfo}"
                    FontSize="11"
                    Text="{Binding LibraryResultSummary}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <ListBox ItemsSource="{Binding LibraryStatusFilters}" SelectedItem="{Binding LibraryStatusFilter, Mode=TwoWay}"
                AutomationProperties.Name="Publication status" Style="{DynamicResource Control.TabList}" Margin="0,0,0,8">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <WrapPanel VerticalAlignment="Center">
                <Grid Width="180" Margin="0,0,8,8">
                <TextBox
                    AutomationProperties.Name="Search finished Library videos"
                    Style="{DynamicResource Control.InlineSearchTextBox}"
                    Background="{DynamicResource Brush.SurfaceInset}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1"
                    Text="{Binding LibrarySearchQuery, UpdateSourceTrigger=PropertyChanged, Delay=180}"
                    ToolTip="Search title, filename, or output folder" />
                <TextBlock Text="Search videos" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding LibrarySearchQuery}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                </Grid>
                <ComboBox
                    Width="132"
                    Margin="0,0,8,8"
                    AutomationProperties.Name="Filter Publish Library by date"
                    ToolTip="When the finished video was added to Library"
                    ItemsSource="{Binding LibraryDateFilters}"
                    SelectedItem="{Binding LibraryDateFilter, Mode=TwoWay}"
                    Style="{DynamicResource Control.InlineSelectorComboBox}" />
                <ComboBox
                    Width="160"
                    Margin="0,0,8,8"
                    AutomationProperties.Name="Filter Publish Library by folder"
                    DisplayMemberPath="Label"
                    ItemsSource="{Binding LibraryFolderOptions}"
                    SelectedValue="{Binding SelectedLibraryFolder, Mode=TwoWay}"
                    SelectedValuePath="FullPath"
                    Style="{DynamicResource Control.InlineSelectorComboBox}" />
                <Button
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Clear Publish Library filters"
                    Command="{Binding ClearLibraryFiltersCommand}"
                    Content="Clear"
                    Style="{DynamicResource Control.GhostButton}" />
            </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <ListBox
                    x:Name="LibraryItemsList"
                    AutomationProperties.Name="Finished videos ready for YouTube"
                    ItemsSource="{Binding LibraryItems}"
                    SelectedValue="{Binding SelectedAsset, Mode=TwoWay}"
                    SelectedValuePath="Asset"
                    PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="Items_PreviewMouseMove"
                    Style="{DynamicResource Control.SectionList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="98" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="90"
                                        Height="60"
                                        Background="Black"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="{DynamicResource Radius.OrganicCard}"
                                        ClipToBounds="True">
                                        <Grid>
                                            <controls:LocalThumbnailImage
                                                DecodePixelWidth="180"
                                                SourcePath="{Binding ThumbnailFullPath}"
                                                Stretch="Uniform"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />
                                            <controls:IconPath
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IconKey="Icon.Media"
                                                Stroke="{DynamicResource Brush.StatusInfo}"
                                                Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            Text="{Binding Title}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding CollectionDetail}" TextTrimming="CharacterEllipsis" />
                                        <controls:PublicationBadge Margin="0,5,0,0" DataContext="{Binding Publication}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding ActionLabel}"
                                        ToolTip="{Binding Publication.Detail}"
                                        Command="{Binding DataContext.PrepareAssetCommand, ElementName=Root}"
                                        CommandParameter="{Binding Asset}"
                                        Content="{Binding ActionLabel}"
                                        Style="{DynamicResource Control.GhostButton}" />
                                    <Button Margin="0,3,0,0" Content="Prepare repost"
                                        ToolTip="Prepare a separate upload of this video. You will review it before uploading."
                                        Command="{Binding DataContext.PrepareRepostCommand, ElementName=Root}" CommandParameter="{Binding Asset}"
                                        Visibility="{Binding HasRecordedUpload, Converter={StaticResource BoolToVisibility}}"
                                        Style="{DynamicResource Control.GhostButton}" />
                                    </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <controls:EmptyState
                    MinHeight="180"
                    IconKey="Icon.Media"
                    Title="{Binding LibraryEmptyTitle}"
                    Description="{Binding LibraryEmptyDescription}"
                    Visibility="{Binding HasVisibleLibraryItems, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
            <Border
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="12,10"
                Background="{DynamicResource Brush.InteractiveSelected}"
                BorderBrush="{DynamicResource Brush.StatusInfo}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource Text.Body}"
                        Text="{Binding DraftSummary}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Publish every saved draft immediately"
                        Command="{Binding PublishAllNowCommand}"
                        Content="Publish all now"
                        Style="{DynamicResource Control.PrimaryButton}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
