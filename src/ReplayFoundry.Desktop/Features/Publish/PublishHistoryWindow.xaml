<Window
    x:Class="ReplayFoundry.Desktop.Features.Publish.PublishHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="YouTube History"
    Style="{DynamicResource Control.ThemedWindow}"
    Width="1120"
    Height="780"
    MinWidth="820"
    MinHeight="620"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="/ReplayFoundry.Desktop;component/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True"
    KeyDown="Window_KeyDown">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedHistoryItems" Source="{Binding PagedItems}">
            <CollectionViewSource.GroupDescriptions>
                <data:PropertyGroupDescription PropertyName="DateGroup" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowTitleBar
            Subtitle="YouTube history"
            Status="{Binding TotalBadge}" />
        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        Text="Your YouTube release log" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Search every locally recorded upload without trimming older activity. Select a row to inspect it."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="96"
                    VerticalAlignment="Top"
                    Click="Close_Click"
                    Content="Close"
                    IsCancel="True"
                    Style="{DynamicResource Control.WorkspaceButton}" />
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,0" Style="{DynamicResource Control.SectionCard}">
                <WrapPanel>
                    <StackPanel Width="280" Margin="0,0,10,8">
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="SEARCH TITLES" />
                        <TextBox
                            Margin="0,5,0,0"
                            AutomationProperties.Name="Search YouTube history titles"
                            Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,10,8">
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="STATUS" />
                        <ComboBox
                            Margin="0,5,0,0"
                            AutomationProperties.Name="Filter YouTube history by status"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedValue="{Binding SelectedStatusFilter}"
                            SelectedValuePath="Key" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,8">
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="FROM" />
                        <DatePicker
                            Margin="0,5,0,0"
                            AutomationProperties.Name="YouTube history start date"
                            SelectedDate="{Binding FromDate}"
                            Style="{DynamicResource Control.FormDatePicker}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,8">
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="TO" />
                        <DatePicker
                            Margin="0,5,0,0"
                            AutomationProperties.Name="YouTube history end date"
                            SelectedDate="{Binding ToDate}"
                            Style="{DynamicResource Control.FormDatePicker}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,10,8">
                        <TextBlock Style="{DynamicResource Text.FormLabel}" Text="ORDER" />
                        <ComboBox
                            Margin="0,5,0,0"
                            AutomationProperties.Name="Sort YouTube history"
                            ItemsSource="{Binding SortOrders}"
                            SelectedValue="{Binding SelectedSortOrder}"
                            SelectedValuePath="Key" />
                    </StackPanel>
                    <Button
                        Margin="0,20,0,8"
                        Command="{Binding ClearFiltersCommand}"
                        Content="Clear filters"
                        Style="{DynamicResource Control.GhostButton}" />
                </WrapPanel>
            </Border>

            <Border
                Grid.Row="2"
                Margin="0,10,0,0"
                AutomationProperties.LiveSetting="Assertive"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.StatusError}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Visibility="{Binding HasInvalidDateRange, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Foreground="{DynamicResource Brush.StatusError}"
                    Text="Choose an end date on or after the start date."
                    TextWrapping="Wrap" />
            </Border>

            <Border Grid.Row="3" Margin="0,12,0,0" Style="{DynamicResource Control.SectionCard}">
                <Grid>
                    <ListBox
                        AutomationProperties.Name="Filtered YouTube history"
                        ItemsSource="{Binding Source={StaticResource GroupedHistoryItems}}"
                        ScrollViewer.CanContentScroll="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        Visibility="{Binding HasPagedItems, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,14,4,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.BrandCyan}"
                                                Text="{Binding Name}" />
                                            <Border
                                                Grid.Column="1"
                                                Height="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.BorderSubtle}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.Panel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </GroupStyle.Panel>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Control.CanvasRailListBoxItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibilityName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                Text="{Binding Title}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                AutomationProperties.Name="YouTube history record summary"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding Detail}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Status}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPublished}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid x:Name="SelectedDetails" Grid.Row="1" Margin="0,11,0,2" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{DynamicResource Text.FormLabel}" Text="RECORDED ACTIVITY" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Margin="16,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding OpenActionName}"
                                            Command="{Binding DataContext.OpenOnYouTubeCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}"
                                            Content="Open on YouTube"
                                            Style="{DynamicResource Control.WorkspaceButton}"
                                            Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisibility}}" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                        <Setter TargetName="SelectedDetails" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:EmptyState
                        Description="Try a broader title, status, or date range. Your full local history is still here."
                        IconKey="Icon.History"
                        Title="No history matches"
                        Visibility="{Binding HasPagedItems, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Border>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        AutomationProperties.LiveSetting="Polite"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding ResultSummary}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{DynamicResource Brush.StatusError}"
                        Text="{Binding LinkNotice}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasLinkNotice, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Command="{Binding LoadMoreCommand}"
                    Content="{Binding LoadMoreText}"
                    Style="{DynamicResource Control.WorkspaceButton}"
                    Visibility="{Binding HasMoreItems, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
