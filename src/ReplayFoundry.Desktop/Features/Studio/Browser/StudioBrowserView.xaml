<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Browser.StudioBrowserView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <UserControl.Resources>
        <!-- The item owns the complete card hit area. Its template is visually
             transparent so selection still has one tonal card and one rail. -->
        <Style x:Key="StudioBrowser.ClipItem" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource Control.KeyboardFocus}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="AutomationProperties.HelpText" Value="Select this clip to preview and edit it. The buttons inside the card perform their named actions." />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibilityStatus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                    <Setter Property="Cursor" Value="Arrow" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="IsTabStop" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border
        AutomationProperties.Name="Studio clips and graphics browser"
        Style="{DynamicResource Control.CanvasPane}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Project clips" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="Select, edit, then add to export."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListBox
                Grid.Row="1"
                Margin="0,12,0,10"
                AutomationProperties.Name="Studio browser sections"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding ToolSections}"
                SelectedValue="{Binding SelectedTool, Mode=TwoWay}"
                SelectedValuePath="Key"
                Style="{DynamicResource Control.SectionList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPath
                                Width="14"
                                Height="14"
                                Margin="0,0,7,0"
                                IconKey="{Binding Glyph}"
                                Stroke="{DynamicResource Brush.StatusInfo}"
                                StrokeThickness="1.2"
                                Stretch="Uniform" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ListBox
                    x:Name="BrowserItems"
                    Margin="0,2,6,16"
                    AutomationProperties.Name="Studio clips"
                    Background="Transparent"
                    BorderThickness="0"
                    ClipToBounds="False"
                    ItemContainerStyle="{StaticResource StudioBrowser.ClipItem}"
                    ItemsSource="{Binding BrowserPreviewItems}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    SelectedValue="{Binding SelectedAsset.Id, Mode=OneWay}"
                    SelectedValuePath="AssetId"
                    SelectionChanged="BrowserItems_SelectionChanged"
                    SelectionMode="Single"
                    Tag="{Binding SelectBrowserAssetCommand}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                AutomationProperties.Name="{Binding Title}"
                                Style="{DynamicResource Control.StudioClipCard}"
                                ToolTip="{Binding Detail}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Background="{DynamicResource Brush.StatusInfo}"
                                        CornerRadius="3,0,0,3"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                                    <Grid Grid.Column="1" Margin="10,9,10,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid IsHitTestVisible="False">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource Brush.SurfaceElevated}"
                                                    CornerRadius="7">
                                                    <controls:IconPath
                                                        Width="12"
                                                        Height="12"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        IconKey="{Binding Glyph}"
                                                        Stroke="{DynamicResource Brush.StatusInfo}"
                                                        StrokeThickness="1.2"
                                                        Stretch="Uniform" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="6,1,0,0"
                                                    AutomationProperties.Name="Studio Browser clip name"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    LineHeight="16"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Grid>

                                        <WrapPanel Grid.Row="1" Margin="0,7,0,0" Orientation="Horizontal">
                                            <Border
                                                Margin="0,0,7,4"
                                                Padding="7,2"
                                                AutomationProperties.Name="Excluded from Studio and the render queue"
                                                Background="{DynamicResource Brush.SurfaceInset}"
                                                BorderBrush="{DynamicResource Brush.StatusError}"
                                                BorderThickness="1"
                                                CornerRadius="9"
                                                ToolTip="Excluded from Studio and the render queue. Saved edits and source files are kept."
                                                Visibility="{Binding IsExcluded, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock
                                                    FontSize="9"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource Brush.StatusError}"
                                                    Text="EXCLUDED" />
                                            </Border>
                                            <controls:StatusBadge Margin="0,0,7,4" Text="{Binding Status}" />
                                            <TextBlock
                                                Margin="0,3,7,4"
                                                AutomationProperties.Name="Studio Browser clip batch rank"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding BatchRankText}" />
                                            <TextBlock
                                                Margin="0,3,0,4"
                                                AutomationProperties.Name="Studio Browser clip source position"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding SourcePositionText}" />
                                        </WrapPanel>

                                        <Border
                                            Grid.Row="2"
                                            Margin="0,6,0,0"
                                            Padding="0"
                                            Background="Transparent"
                                            Visibility="{Binding HasClipRationale, Converter={StaticResource BoolToVisibility}}">
                                            <Expander Header="Why this clip" IsExpanded="{Binding IsSelected, Mode=OneWay}"
                                                Style="{DynamicResource Control.QuietExpander}">
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                                    Text="{Binding WhyThisClip}"
                                                    TextWrapping="Wrap" />
                                            </Expander>
                                        </Border>

                                        <Grid Grid.Row="3" Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                MinWidth="0"
                                                Padding="6,6"
                                                AutomationProperties.Name="{Binding QueueActionAutomationName}"
                                                AutomationProperties.HelpText="Adds this exact clip with its latest visible edits. Review is optional."
                                                Command="{Binding DataContext.QueueBrowserAssetCommand, ElementName=Root}"
                                                CommandParameter="{Binding AssetId}"
                                                Content="{Binding QueueActionText}"
                                                ToolTip="Uses the edits you can see. If something needs attention, this opens the right place to fix it.">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Control.StudioSecondaryButton}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button
                                                Grid.Column="1"
                                                MinWidth="0"
                                                Padding="6,6"
                                                Margin="7,0,0,0"
                                                AutomationProperties.Name="Remove clip from Studio"
                                                AutomationProperties.HelpText="Moves this clip out of Studio and the render queue without deleting its saved edits."
                                                Command="{Binding DataContext.RemoveBrowserAssetCommand, ElementName=Root}"
                                                CommandParameter="{Binding AssetId}"
                                                Content="Exclude"
                                                ToolTip="Exclude from Studio and the render queue. Saved edits and source files are kept.">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Control.StudioDestructiveButton}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button
                                                Grid.ColumnSpan="2"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="Keep clip in Studio"
                                                AutomationProperties.HelpText="Returns this saved clip to Studio. You can add it to the queue when ready."
                                                Command="{Binding DataContext.RestoreBrowserAssetCommand, ElementName=Root}"
                                                CommandParameter="{Binding AssetId}"
                                                Content="Keep in Studio">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Control.StudioSecondaryButton}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
