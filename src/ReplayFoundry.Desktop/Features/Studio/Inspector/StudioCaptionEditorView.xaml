<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioCaptionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style
            x:Key="Studio.CaptionTimeField"
            BasedOn="{StaticResource Control.ThemedTextBox}"
            TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border
            Margin="0,12,0,8"
            AutomationProperties.Name="Caption effect editor"
            Style="{DynamicResource Control.CanvasInsetCard}"
            Visibility="{Binding IsCaptionStyleEditorVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Caption effect" />
                <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="Choose how captions look. The spoken words and their audio source stay the same." TextWrapping="Wrap" />
                <ComboBox
                    AutomationProperties.Name="Studio caption effect"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding IsProjectDraft}"
                    ItemsSource="{Binding Clip.CaptionStyleOptions}"
                    SelectedItem="{Binding Clip.SelectedCaptionStyle, Mode=TwoWay}" />
                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Caption phrase size" />
                <ComboBox
                    Margin="0,5,0,0"
                    AutomationProperties.Name="Caption phrase size"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding Clip.IsCaptionPhraseSizeEditorEnabled}"
                    ItemsSource="{Binding Clip.CaptionWordLimitOptions}"
                    SelectedItem="{Binding Clip.SelectedCaptionWordLimit, Mode=TwoWay}"
                    Visibility="{Binding Clip.IsCaptionPhraseSizeSelectorVisible, Converter={StaticResource BoolToVisibility}}" />
                <Border
                    Margin="0,5,0,0"
                    Padding="12,9"
                    AutomationProperties.Name="Caption phrase size locked by Pop"
                    Style="{DynamicResource Control.CanvasInsetCard}"
                    Visibility="{Binding Clip.IsPopCaptionPhraseSizeLocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.StatusInfo}"
                        Text="{Binding Clip.PopCaptionPhraseSizeText}" />
                </Border>
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding Clip.SelectedCaptionPhraseSizeDescription}"
                    TextWrapping="Wrap" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Maximum width" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionMaximumWidthText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption maximum width"
                    AutomationProperties.HelpText="Choose how wide captions may appear before wrapping."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="40"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Clip.CaptionMaximumWidthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Text size" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionFontScaleText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption text size"
                    AutomationProperties.HelpText="Make caption text smaller or larger."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="160"
                    Minimum="60"
                    SmallChange="5"
                    TickFrequency="5"
                    Value="{Binding Clip.CaptionFontScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Vertical position" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionVerticalPositionText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption vertical position"
                    AutomationProperties.HelpText="Move captions from the upper safe area to the lower safe area."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="90"
                    Minimum="10"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Clip.CaptionVerticalPositionPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="Changing the look will not change the words or mute any of your audio." TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="The preview matches the captions that will appear in the finished video."
                    TextWrapping="Wrap" />
                <Border
                    Margin="0,10,0,0"
                    Padding="10,8"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding Clip.HasCaptionPresentationWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{DynamicResource Brush.StatusWarning}"
                        Text="{Binding Clip.CaptionPresentationWarning}"
                        TextWrapping="Wrap" />
                </Border>
                <Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Apply caption look to every captioned clip"
                    Command="{Binding Clip.ApplyCaptionLookToAllCommand}"
                    Content="{Binding Clip.ApplyCaptionLookToAllText}"
                    Style="{DynamicResource Control.StudioSecondaryButton}"
                    ToolTip="Copies this caption look to every captioned clip. Each clip keeps its own words and timing." />

                <Border
                    Margin="0,14,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.KineticGlowSoft}"
                    Style="{DynamicResource Control.CanvasGhostZone}">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Caption script" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource Brush.BrandCyan}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="WORDS &amp; TIMING" />
                        <TextBlock
                            Margin="0,8,0,10"
                            Style="{DynamicResource Text.Meta}"
                            Text="Correct what viewers read and when each phrase appears. Times begin at the start of this clip. If word timing is not reliable, animated effects follow the whole phrase instead of guessing."
                            TextWrapping="Wrap" />
                        <ScrollViewer
                            MaxHeight="280"
                            AutomationProperties.Name="Caption script scroll region"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                AutomationProperties.Name="Caption text and timing segments"
                                ItemsSource="{Binding Caption.Segments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            Style="{DynamicResource Control.CanvasInsetCard}">
                                            <StackPanel>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,7,0" Style="{DynamicResource Text.Meta}" Text="Show" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="Caption segment start time"
                                                        IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Studio.CaptionTimeField}"
                                                        Text="{Binding StartSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="to" />
                                                    <TextBox
                                                        Grid.Column="3"
                                                        AutomationProperties.Name="Caption segment end time"
                                                        IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Studio.CaptionTimeField}"
                                                        Text="{Binding EndSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="4" Margin="7,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Meta}" Text="sec" />
                                                </Grid>
                                                <TextBlock Margin="0,9,0,0" Style="{DynamicResource Text.Meta}" Text="Words on screen" />
                                                <TextBox
                                                    MinHeight="58"
                                                    Margin="0,4,0,0"
                                                    Padding="10,8"
                                                    AutomationProperties.Name="Caption segment text"
                                                    IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            Margin="0,8,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding Caption.Status}"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Save caption words and timing"
                            Command="{Binding Caption.SaveCommand}"
                            Content="Save words and timing"
                            Style="{DynamicResource Control.StudioPrimaryButton}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border
            Margin="0,12,0,8"
            Style="{DynamicResource Control.CanvasInsetCard}"
            Visibility="{Binding IsCaptionTrackMissing, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{DynamicResource Text.Meta}" Text="This clip has no captions. Turn on captions and choose which microphone carries your voice when you generate clips." TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
