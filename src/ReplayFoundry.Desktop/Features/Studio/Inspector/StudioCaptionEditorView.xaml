<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioCaptionEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Inspector"
    xmlns:editing="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Editing">
    <UserControl.Resources>
        <Style
            x:Key="Studio.CaptionTimeField"
            BasedOn="{StaticResource Control.ThemedTextBox}"
            TargetType="{x:Type TextBox}">
            <Setter Property="Width" Value="70" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border
            Margin="0,12,0,8"
            AutomationProperties.Name="Caption effect editor"
            Style="{DynamicResource Control.CanvasInsetCard}" Background="Transparent" BorderThickness="0" Padding="0"
            Visibility="{Binding IsCaptionStyleEditorVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8"
                    Style="{DynamicResource Text.Meta}"
                    Text="This clip has no captions yet. Add phrases, import subtitles, or regenerate from its voice track below."
                    TextWrapping="Wrap"
                    Visibility="{Binding IsCaptionTrackMissing, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Caption look" />
                <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="Hover over a look to see it move. Click to use it." TextWrapping="Wrap" />
                <ListBox AutomationProperties.Name="Studio caption look" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding Clip.CaptionLooks.Choices}" SelectedItem="{Binding Clip.CaptionLooks.SelectedChoice, Mode=TwoWay}"
                    IsEnabled="{Binding IsProjectDraft}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ItemContainerStyle="{DynamicResource Control.ChoiceTile}">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel ToolTip="{Binding Description}">
                            <local:StudioCaptionEffectPreview Height="40" Margin="0,0,0,5" Preset="{Binding Style}">
                                <local:StudioCaptionEffectPreview.Style>
                                    <Style TargetType="{x:Type local:StudioCaptionEffectPreview}">
                                        <Setter Property="IsPreviewActive" Value="False" />
                                        <Setter Property="Typography" Value="{Binding DataContext.Clip.CaptionTypography, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True"><Setter Property="Typography" Value="{Binding Typography}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="IsPreviewActive" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="IsPreviewActive" Value="True" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </local:StudioCaptionEffectPreview.Style>
                            </local:StudioCaptionEffectPreview>
                            <TextBlock Text="{Binding Name}" Style="{DynamicResource Text.Meta}" />
                            <TextBlock Text="Saved" FontSize="10" Foreground="{DynamicResource Brush.BrandCyan}" Visibility="{Binding IsSaved, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Margin="0,8,0,6" Text="Highlight color" Style="{DynamicResource Text.Meta}" />
                <ListBox ItemsSource="{Binding Clip.CaptionAccentChoices}" SelectedItem="{Binding Clip.SelectedCaptionAccentChoice}"
                    IsEnabled="{Binding IsProjectDraft}" Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource Control.ChoiceTile}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Caption highlight color">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel>
                        <Ellipse Fill="{Binding Value}" Width="16" Height="16" Margin="0,0,0,5" />
                        <TextBlock Text="{Binding Name}" FontSize="11" TextAlignment="Center" />
                    </StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Margin="0,4,0,12">
                <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Phrase length" />
                <ListBox
                    Margin="0,5,0,0"
                    AutomationProperties.Name="Caption phrase size"
                    DisplayMemberPath="Name" ItemContainerStyle="{DynamicResource Control.ChoiceTile}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    IsEnabled="{Binding Clip.IsCaptionPhraseSizeEditorEnabled}"
                    ItemsSource="{Binding Clip.CaptionWordLimitOptions}"
                    SelectedItem="{Binding Clip.SelectedCaptionWordLimit, Mode=TwoWay}"

                        Visibility="{Binding Clip.IsCaptionPhraseSizeSelectorVisible, Converter={StaticResource BoolToVisibility}}" >
                        <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                        <UniformGrid
                        Columns="2" />
                        </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        </ListBox>
                <Border
                    Margin="0,5,0,0"
                    Padding="12,9"
                    AutomationProperties.Name="Caption phrase size locked by Pop"
                    Style="{DynamicResource Control.CanvasInsetCard}"
                    Visibility="{Binding Clip.IsPopCaptionPhraseSizeLocked, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.StatusInfo}"
                        Text="{Binding Clip.PopCaptionPhraseSizeText}" />
                </Border>
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding Clip.SelectedCaptionPhraseSizeDescription}"
                    TextWrapping="Wrap" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Maximum width" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionMaximumWidthText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption maximum width"
                    AutomationProperties.HelpText="Choose how wide captions may appear before wrapping."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="100"
                    Minimum="40"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Clip.CaptionMaximumWidthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Text size" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionFontScaleText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption text size"
                    AutomationProperties.HelpText="Make caption text smaller or larger."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="160"
                    Minimum="60"
                    SmallChange="5"
                    TickFrequency="5"
                    Value="{Binding Clip.CaptionFontScalePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Move up or down" />
                    <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.CaptionVerticalPositionText}" />
                </Grid>
                <Slider
                    AutomationProperties.Name="Caption vertical position"
                    AutomationProperties.HelpText="Move captions from the upper safe area to the lower safe area."
                    IsEnabled="{Binding IsProjectDraft}"
                    IsSnapToTickEnabled="True"
                    LargeChange="10"
                    Maximum="90"
                    Minimum="10"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Clip.CaptionVerticalPositionPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="Changing the look will not change the words or mute any of your audio." TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="The preview matches the captions that will appear in the finished video."
                    TextWrapping="Wrap" />
                                    </StackPanel>
                <Expander Header="Customize this look" Style="{DynamicResource Control.DisclosureExpander}" IsEnabled="{Binding IsProjectDraft}">
                    <StackPanel Margin="0,8,0,0">
<flair:FoundryHeading Margin="0,16,0,8" Style="{DynamicResource Text.SectionTitle}" Text="Font and colors" />
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Font family" />
                        <ComboBox ItemsSource="{Binding Clip.CaptionFontFamilies}" SelectedItem="{Binding Clip.CaptionFontFamily}" AutomationProperties.Name="Caption font family" />
                        <TextBlock Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding Clip.CaptionFontWarning}"
                            TextWrapping="Wrap"
                            Visibility="{Binding Clip.HasCaptionFontWarning, Converter={StaticResource BoolToVisibility}}" />
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,4,0">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Text" />
<TextBox Text="{Binding Clip.CaptionTextColor, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption text color" />
</StackPanel>
                            <StackPanel Margin="0,0,4,0">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Accent" />
<TextBox Text="{Binding Clip.CaptionAccentColor, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption accent color" />
</StackPanel>
                            <StackPanel>
<TextBlock Style="{DynamicResource Text.Meta}" Text="Outline" />
<TextBox Text="{Binding Clip.CaptionOutlineColor, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption outline color" />
</StackPanel>
                        </UniformGrid>
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="For a custom color, paste its six-character color code." />
                        <WrapPanel Margin="0,8,0,0"><CheckBox Margin="0,0,12,0" IsChecked="{Binding Clip.CaptionBold}" Content="Bold" /><CheckBox IsChecked="{Binding Clip.CaptionRightToLeft}" Content="Right to left" /></WrapPanel>
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Outline thickness" />
                        <Slider Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Clip.CaptionOutlineWidth}" AutomationProperties.Name="Caption outline thickness" />
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="Shadow depth" />
                        <Slider Minimum="0" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Clip.CaptionShadowDepth}" AutomationProperties.Name="Caption shadow depth" />
                        <TextBox Margin="0,8,0,0" Text="{Binding Clip.CaptionLookName}" AutomationProperties.Name="Caption look name" />
                        <Button Margin="0,6,0,0" Content="Save this look" Command="{Binding Clip.SaveNamedCaptionLookCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                    <flair:FoundryHeading Margin="0,16,0,8" Style="{DynamicResource Text.SectionTitle}" Text="Background and motion" />
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Background" />
                        <ComboBox ItemsSource="{Binding Clip.CaptionBackgrounds}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Clip.CaptionBackground}" AutomationProperties.Name="Caption background" />
                        <TextBox Margin="0,4,0,0" Text="{Binding Clip.CaptionBackgroundColor, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption background color" />
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="Background opacity (%)" />
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Clip.CaptionBackgroundOpacityPercent}" AutomationProperties.Name="Caption background opacity" />
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <StackPanel Margin="0,0,6,0">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Alignment" />
<ComboBox ItemTemplate="{DynamicResource StudioOptionTemplate}" ItemsSource="{Binding Clip.CaptionAlignments}" SelectedItem="{Binding Clip.CaptionAlignment}" AutomationProperties.Name="Caption alignment" />
</StackPanel>
                            <StackPanel>
<TextBlock Style="{DynamicResource Text.Meta}" Text="Capital letters" />
<ComboBox ItemTemplate="{DynamicResource StudioOptionTemplate}" ItemsSource="{Binding Clip.CaptionCasings}" SelectedItem="{Binding Clip.CaptionCasing}" AutomationProperties.Name="Caption casing" />
</StackPanel>
                        </UniformGrid>
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Animation motion (%)" />
                        <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Clip.CaptionAnimationIntensityPercent}" AutomationProperties.Name="Caption animation intensity" />
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="At zero, word colors still follow speech; zoom motion is removed." TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Line spacing (%)" />
                        <Slider Minimum="80" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Clip.CaptionLineSpacingPercent}" AutomationProperties.Name="Caption line spacing" />
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="Moves wrapped lines apart while keeping the same letter size." TextWrapping="Wrap" />
                    <flair:FoundryHeading Margin="0,16,0,8" Style="{DynamicResource Text.SectionTitle}" Text="Keep text clear of app buttons" />
                        <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="Platform safe area" />
                        <ComboBox
                            ItemTemplate="{DynamicResource StudioOptionTemplate}"
                            ItemsSource="{Binding Clip.CaptionSafeAreas}"
                            SelectedItem="{Binding Clip.CaptionSafeArea}"
                            AutomationProperties.Name="Keep captions clear of app buttons" />
                        <TextBlock Style="{DynamicResource Text.Meta}"
                            Text="Choose where you will post. The preview marks space to leave clear for buttons and descriptions. Check that captions also avoid your game controls."
                            TextWrapping="Wrap" />
                        <CheckBox Margin="0,6,0,0" Content="Adjust safe-area margins" IsChecked="{Binding Clip.UseCustomCaptionSafeArea}" />
                        <UniformGrid Columns="2" Margin="0,4,0,0" IsEnabled="{Binding Clip.UseCustomCaptionSafeArea}">
                            <StackPanel Margin="0,0,6,4">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Left (%)" />
<TextBox Text="{Binding Clip.CaptionSafeLeftPercent, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption safe area left margin" />
</StackPanel>
                            <StackPanel Margin="0,0,0,4">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Right (%)" />
<TextBox Text="{Binding Clip.CaptionSafeRightPercent, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption safe area right margin" />
</StackPanel>
                            <StackPanel Margin="0,0,6,0">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Top (%)" />
<TextBox Text="{Binding Clip.CaptionSafeTopPercent, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption safe area top margin" />
</StackPanel>
                            <StackPanel>
<TextBlock Style="{DynamicResource Text.Meta}" Text="Bottom (%)" />
<TextBox Text="{Binding Clip.CaptionSafeBottomPercent, ValidatesOnExceptions=True}" AutomationProperties.Name="Caption safe area bottom margin" />
</StackPanel>
                        </UniformGrid>
                        <TextBlock
                            Style="{DynamicResource Text.Meta}"
                            Text="Margins accept 0ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â€šÂ¬Ã…â€œ45%. Custom margins stay with this named look; turn adjustment off to use platform defaults."
                            TextWrapping="Wrap" />

                    </StackPanel>
                </Expander>
                <Border
                    Margin="0,10,0,0"
                    Padding="10,8"
                    Background="{DynamicResource Brush.SurfaceElevated}"
                    BorderBrush="{DynamicResource Brush.StatusWarning}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="{Binding Clip.HasCaptionPresentationWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Foreground="{DynamicResource Brush.StatusWarning}"
                        Text="{Binding Clip.CaptionPresentationWarning}"
                        TextWrapping="Wrap" />
                </Border>
                <Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Apply caption look to every captioned clip"
                    Command="{Binding Clip.ApplyCaptionLookToAllCommand}"
                    Content="{Binding Clip.ApplyCaptionLookToAllText}"
                    Style="{DynamicResource Control.StudioSecondaryButton}"
                    ToolTip="Copies this caption look to every captioned clip. Each clip keeps its own words and timing." />

                <Border
                    Margin="0,14,0,0"
                    Padding="0,16,0,0"
                    Background="Transparent" BorderThickness="0"
                    Style="{DynamicResource Control.CanvasGhostZone}">
                    <StackPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Words &amp; timing" />
                        <TextBlock
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource Brush.BrandCyan}"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Text="Follow the words as you listen" />
                        <TextBlock
                            Margin="0,8,0,10"
                            Style="{DynamicResource Text.Meta}"
                            Text="Fix a word here, or choose Match words to speech to time the corrected phrase to your audio."
                            TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="Spoken language" />
                                <ComboBox ItemsSource="{Binding Caption.LanguageOptions}"
                                    DisplayMemberPath="Name"
                                    SelectedValuePath="Value"
                                    SelectedValue="{Binding Caption.SelectedLanguage}"
                                    AutomationProperties.Name="Caption regeneration language" />
                        <TextBlock Margin="0,5,0,10" Text="{Binding Caption.AlignmentAvailability}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Add phrase" Command="{Binding Caption.AddCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,4" />
                            <Button Content="Undo" Command="{Binding Caption.UndoCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,4" />
                            <Button Content="Redo" Command="{Binding Caption.RedoCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,4" />
                            <Button Content="Import subtitles" Command="{Binding Caption.ImportCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,4" />
                            <Button Content="Export subtitles" Command="{Binding Caption.ExportCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,4" />
                        </WrapPanel>
                        <ScrollViewer
                            MaxHeight="240"
                            AutomationProperties.Name="Caption script scroll region"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl
                                AutomationProperties.Name="Caption text and timing segments"
                                ItemsSource="{Binding Caption.Segments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="10"
                                            Style="{DynamicResource Control.CanvasInsetCard}">
                                            <StackPanel>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="78" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,7,0" Style="{DynamicResource Text.Meta}" Text="Show" />
                                                    <TextBox
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="Caption segment start time"
                                                        IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Studio.CaptionTimeField}"
                                                        Text="{Binding StartSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" Text="to" />
                                                    <TextBox
                                                        Grid.Column="3"
                                                        AutomationProperties.Name="Caption segment end time"
                                                        IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Style="{StaticResource Studio.CaptionTimeField}"
                                                        Text="{Binding EndSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="4" Margin="7,0,0,0" VerticalAlignment="Center" Style="{DynamicResource Text.Meta}" Text="sec" />
                                                </Grid>
                                                <TextBlock Margin="0,9,0,0" Style="{DynamicResource Text.Meta}" Text="Words on screen" />
                                                <TextBox
                                                    MinHeight="58"
                                                    Margin="0,4,0,0"
                                                    Padding="10,8"
                                                    AutomationProperties.Name="Caption segment text"
                                                    IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    TextWrapping="Wrap" />
                                                <Expander Header="Speaker &amp; second language" Margin="0,8,0,0" Style="{DynamicResource Control.DisclosureExpander}">
                                                    <StackPanel>
                                                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="Speaker (optional)" />
                                                <TextBox Text="{Binding Speaker, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Caption speaker name"
                                                    IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="Secondary language (optional)" />
                                                <TextBox MinHeight="40"
                                                    TextWrapping="Wrap"
                                                    Text="{Binding SecondaryText, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="Caption secondary language text"
                                                    IsReadOnly="{Binding DataContext.IsProjectFinalized, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                    </StackPanel>
                                                </Expander>
                                                <TextBlock Margin="0,5,0,0" Text="{Binding TimingHint}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding ReadabilitySummary}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,3,0,0" Text="{Binding ReadabilityWarning}" Foreground="{DynamicResource Brush.StatusWarning}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0,5,0,0" Text="{Binding AlignmentSummary}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                                <Expander Header="How this timing was made"
                                                    Margin="0,3,0,0"
                                                    Visibility="{Binding HasAlignmentProvenance, Converter={StaticResource BoolToVisibility}}"
                                                    Style="{DynamicResource Control.DisclosureExpander}">
                                                    <TextBlock Text="{Binding AlignmentDetails}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                                </Expander>
                                                <Expander Header="Fine-tune each word" Margin="0,6,0,0" Style="{DynamicResource Control.DisclosureExpander}">
                                                    <ItemsControl ItemsSource="{Binding Words}" IsEnabled="{Binding DataContext.IsProjectDraft, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="0,5,0,5">
                                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caption word text" />
                                                                    <WrapPanel Margin="0,3,0,0">
                                                                        <TextBox Width="65" Text="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caption word start time" />
                                                                        <TextBlock Text=" to " VerticalAlignment="Center" Style="{DynamicResource Text.Meta}" />
                                                                        <TextBox Width="65" Text="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Caption word end time" />
                                                                        <CheckBox Margin="8,0,0,0" IsChecked="{Binding IsEmphasized}" Content="Emphasize" VerticalAlignment="Center" />
                                                                    </WrapPanel>
                                                                    <editing:StudioCaptionWordTimingHandles Word="{Binding}" Margin="0,3,0,0" />
                                                                    <TextBlock Text="{Binding AcousticReview}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Content="Match words to speech"
                                                        Command="{Binding DataContext.Caption.AlignCorrectedTextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Control.StudioSecondaryButton}"
                                                        Margin="0,0,4,4" />
                                                    <Button Content="Edit as separate words"
                                                        Command="{Binding DataContext.Caption.RebuildWordRowsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Control.StudioSecondaryButton}"
                                                        Margin="0,0,4,4"
                                                        ToolTip="Creates editable word rows from the phrase. New words have blank times for you to align; existing matching times are preserved." />
                                                    <Button Content="Split"
                                                        Command="{Binding DataContext.Caption.SplitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Control.StudioSecondaryButton}"
                                                        Margin="0,0,4,0" />
                                                    <Button Content="Merge next"
                                                        Command="{Binding DataContext.Caption.MergeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Control.StudioSecondaryButton}"
                                                        Margin="0,0,4,0" />
                                                    <Button Content="Delete"
                                                        Command="{Binding DataContext.Caption.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{DynamicResource Control.StudioSecondaryButton}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock
                            Margin="0,8,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding Caption.Status}"
                            TextWrapping="Wrap" />
                        <Button Margin="0,6,0,0"
                            Content="Cancel alignment"
                            Command="{Binding Caption.CancelAlignmentCommand}"
                            Style="{DynamicResource Control.StudioSecondaryButton}"
                            Visibility="{Binding Caption.IsAligning, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Save caption words and timing"
                            Command="{Binding Caption.SaveCommand}"
                            Content="Save words and timing"
                            Style="{DynamicResource Control.StudioPrimaryButton}" />
                        <Expander Header="Create captions again" Margin="0,12,0,0" IsEnabled="{Binding IsProjectDraft}" Style="{DynamicResource Control.DisclosureExpander}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Style="{DynamicResource Text.Meta}" Text="Audio track with your voice" />
                                <ComboBox ItemsSource="{Binding Caption.AudioStreams}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Index"
                                    SelectedValue="{Binding Caption.SelectedAudioStreamIndex}"
                                    AutomationProperties.Name="Caption regeneration audio stream" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="Listen to this track" Command="{Binding Caption.AudioAudition.ListenCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                                    <Button Margin="6,0,0,0" Content="Stop" Command="{Binding Caption.AudioAudition.StopCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                                </WrapPanel>
                                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Caption.AudioAudition.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="{Binding Caption.LanguageModelDescription}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Caption.LanguageUnavailableReason}" Foreground="{DynamicResource Brush.StatusWarning}" TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0"
                                    Style="{DynamicResource Text.Meta}"
                                    Text="Replaces saved words for this cut and restores measured word timing. Save your draft first. Language support depends on the installed model."
                                    TextWrapping="Wrap" />
                                <Button Margin="0,6,0,0" Content="Regenerate captions" Command="{Binding Caption.RegenerateCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                                <Button Margin="0,6,0,0" Content="Add English secondary captions" Command="{Binding Caption.TranslateSecondaryCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                                <TextBlock Text="{Binding Caption.TranslationUnavailableReason}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Help captions spell names correctly" Margin="0,10,0,0" Style="{DynamicResource Control.DisclosureExpander}">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                                    Text="Add unusual names or game terms the captions get wrong, one per line. For example: REANIMAL or a character's name. These spellings help the next time you create captions on this PC." />
                                <TextBlock Margin="0,6,0,8" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap"
                                    Text="Hints do not change existing captions or write titles. To fix captions already on screen, edit the words above or create the captions again." />
                                <TextBox MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Caption.VocabularyText}" AutomationProperties.Name="Caption transcription vocabulary" />
                                <CheckBox Margin="0,6,0,0" IsChecked="{Binding Caption.RememberCorrections}" Content="Also remember spellings I correct" />
                                <Button Margin="0,6,0,0" Content="Save spelling hints" Command="{Binding Caption.SaveVocabularyCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
