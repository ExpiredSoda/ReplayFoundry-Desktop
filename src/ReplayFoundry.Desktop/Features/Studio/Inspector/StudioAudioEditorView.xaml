<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioAudioEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,12,0,8" Style="{DynamicResource Control.CanvasInsetCard}" Background="Transparent" BorderThickness="0" Padding="0"
        AutomationProperties.Name="Audio mix editor"
        Visibility="{Binding IsAudioEditorVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding Output}" IsEnabled="{Binding CanEdit}">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Audio mix" />
            <TextBlock Margin="0,4,0,12" Style="{DynamicResource Text.Meta}" Text="Set the mix heard in preview and export." TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding AudioTracks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Padding="0,0,0,12" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Label}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                    <CheckBox Content="Mute track" VerticalAlignment="Center" AutomationProperties.Name="Mute audio track" IsChecked="{Binding Muted, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Style="{DynamicResource Text.Meta}" Text="Gain · dB" ToolTip="Gain range: −60 to +12 dB" />
                                        <TextBox AutomationProperties.Name="Audio track gain decibels" Text="{Binding GainDecibels, Mode=TwoWay, StringFormat=F1}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Visibility="{Binding HasAudio, Converter={StaticResource BoolToVisibility}}">
                <Expander Header="Make your voice easier to hear" Margin="0,0,0,8" Style="{DynamicResource Control.DisclosureExpander}">
                    <StackPanel Margin="0,8,0,0">
                <TextBlock Style="{DynamicResource Text.Meta}" Text="Which track has your voice?" />
                <ComboBox Margin="0,4,0,8"
                    AutomationProperties.Name="Ducking voice track"
                    ItemsSource="{Binding AudioTracks}"
                    DisplayMemberPath="Label"
                    SelectedValuePath="StreamIndex"
                    SelectedValue="{Binding VoiceAudioStreamIndex, Mode=TwoWay}" />
                <CheckBox Content="Lower other tracks while voice is speaking" AutomationProperties.Name="Duck gameplay under voice" IsChecked="{Binding DuckGameplay, Mode=TwoWay}" />
                    </StackPanel>
                </Expander>
                <Expander Header="Even out the volume" Margin="0,10,0,0" Style="{DynamicResource Control.DisclosureExpander}">
                    <StackPanel Margin="0,7,0,0">
                        <CheckBox Content="Keep the overall volume consistent" IsChecked="{Binding NormalizeLoudness, Mode=TwoWay}" AutomationProperties.Name="Normalize mix loudness" />
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Meta}" Text="Overall volume target (LUFS): −14 is a useful starting point" />
                        <TextBox Text="{Binding IntegratedLufs, Mode=TwoWay, StringFormat=F1}" AutomationProperties.Name="Integrated loudness target LUFS" />
                        <CheckBox Margin="0,8,0,0" Content="Prevent sudden volume spikes" IsChecked="{Binding LimitTruePeak, Mode=TwoWay}" AutomationProperties.Name="Limit mix true peaks" />
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Meta}" Text="Loudest allowed peak (dBTP): −1 leaves a little headroom" />
                        <TextBox Text="{Binding TruePeakDecibels, Mode=TwoWay, StringFormat=F1}" AutomationProperties.Name="True peak ceiling dBTP" />
                        <TextBlock Margin="0,6,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="Even volume also limits sudden peaks. Save changes to the clip length to hear the updated mix. Use Before and After to compare."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <TextBlock Margin="0,12,0,5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Compare this cut" />
                <WrapPanel>
                    <Button Content="Before" Command="{Binding MixAudition.BeforeCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                    <Button Margin="6,0,0,0" Content="After" Command="{Binding MixAudition.AfterCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                    <Button Margin="6,0,0,0" Content="Stop" Command="{Binding MixAudition.StopCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding MixAudition.Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
