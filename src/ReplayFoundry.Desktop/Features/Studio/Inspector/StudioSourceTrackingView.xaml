<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioSourceTrackingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Expander Header="Follow something as it moves" Margin="0,8,0,8" DataContext="{Binding Tracking}" Style="{DynamicResource Control.DisclosureExpander}">
        <StackPanel Margin="0,8,0,0">
            <TextBlock Style="{DynamicResource Text.Meta}"
                Text="Tracks a textured seed at up to 8 fps; stops on cuts, loss or ambiguity. Gameplay moves a viewport within its saved region. HUD moves its source region only. This follows motion, without recognizing people or objects."
                TextWrapping="Wrap" />
            <StackPanel IsEnabled="{Binding CanAdjust}">
                <ComboBox Margin="0,7,0,6" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" AutomationProperties.Name="Source tracking target" />
                <TextBlock Style="{DynamicResource Text.Meta}" Text="Seed in the first source frame (%) · choose a small distinctive texture" TextWrapping="Wrap" />
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,3,4,5"><TextBlock Style="{DynamicResource Text.Meta}" Text="Left" /><TextBox Text="{Binding SeedX, StringFormat=F1}" AutomationProperties.Name="Tracking seed left percent" /></StackPanel>
                    <StackPanel Margin="4,3,0,5"><TextBlock Style="{DynamicResource Text.Meta}" Text="Top" /><TextBox Text="{Binding SeedY, StringFormat=F1}" AutomationProperties.Name="Tracking seed top percent" /></StackPanel>
                    <StackPanel Margin="0,0,4,5"><TextBlock Style="{DynamicResource Text.Meta}" Text="Width" /><TextBox Text="{Binding SeedWidth, StringFormat=F1}" AutomationProperties.Name="Tracking seed width percent" /></StackPanel>
                    <StackPanel Margin="4,0,0,5"><TextBlock Style="{DynamicResource Text.Meta}" Text="Height" /><TextBox Text="{Binding SeedHeight, StringFormat=F1}" AutomationProperties.Name="Tracking seed height percent" /></StackPanel>
                    <StackPanel Margin="0,0,4,5">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Start after cut begins (s)" />
<TextBox Text="{Binding StartOffsetSeconds, StringFormat=F2}" AutomationProperties.Name="Tracking start offset seconds" />
</StackPanel>
                    <StackPanel Margin="4,0,0,5">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Analyze duration (0.25–60s)" />
<TextBox Text="{Binding DurationSeconds, StringFormat=F2}" AutomationProperties.Name="Tracking duration seconds" />
</StackPanel>
                </UniformGrid>
                <TextBlock Style="{DynamicResource Text.Meta}" Text="Gameplay viewport zoom (1–4; HUD retains its source size)" TextWrapping="Wrap" />
                <TextBox Margin="0,3,0,7" Text="{Binding ViewportZoom, StringFormat=F2}" AutomationProperties.Name="Tracked gameplay viewport zoom" />
            </StackPanel>
            <UniformGrid Columns="2">
                <Button Content="Analyze source" Command="{Binding AnalyzeCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,6" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="4,0,0,6" />
            </UniformGrid>
            <ComboBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" AutomationProperties.Name="Review tracking source frame" IsEnabled="{Binding HasReview}" />
            <Viewbox Margin="0,7,0,7" Stretch="Uniform" MaxHeight="260">
                <Canvas Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Background="Black" ClipToBounds="True">
                    <Image Width="{Binding FrameWidth}" Height="{Binding FrameHeight}" Source="{Binding SourceFrame}" />
                    <Rectangle Canvas.Left="{Binding ViewportX}" Canvas.Top="{Binding ViewportY}" Width="{Binding ViewportWidth}" Height="{Binding ViewportHeight}" Stroke="{DynamicResource Brush.StatusSuccess}" StrokeThickness="1.5" />
                    <Rectangle Canvas.Left="{Binding FeatureX}" Canvas.Top="{Binding FeatureY}" Width="{Binding FeatureWidth}" Height="{Binding FeatureHeight}" Stroke="{DynamicResource Brush.AccentCyan}" StrokeThickness="1.5" />
                    <Rectangle Canvas.Left="{Binding DraftSeedX}"
                        Canvas.Top="{Binding DraftSeedY}"
                        Width="{Binding DraftSeedWidth}"
                        Height="{Binding DraftSeedHeight}"
                        Stroke="{DynamicResource Brush.StatusWarning}"
                        StrokeThickness="1"
                        StrokeDashArray="3,2" />
                </Canvas>
            </Viewbox>
            <TextBlock Style="{DynamicResource Text.Meta}"
                Text="Yellow marks the starting area, blue shows the detail being followed, and green is the suggested frame. Review the movement before applying it."
                TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,6" Style="{DynamicResource Text.Meta}" Text="{Binding FrameStatus}" TextWrapping="Wrap" />
            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <UniformGrid Columns="2" Margin="0,7,0,6">
                <Button Content="Apply reviewed motion" Command="{Binding ApplyCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,4,0" />
                <Button Content="Clear saved track" Command="{Binding ClearCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="4,0,0,0" />
            </UniformGrid>
            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding SavedStatus}" TextWrapping="Wrap" />
        </StackPanel>
    </Expander>
</UserControl>
