<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioFrameEditsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Margin="0,4,0,8" Style="{DynamicResource Control.CanvasInsetCard}" Background="Transparent" BorderThickness="0" Padding="0"
        Visibility="{Binding IsClipBoundaryEditorVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel DataContext="{Binding FrameEdits}" IsEnabled="{Binding CanEdit}">
            <Expander Header="Zoom &amp; pan waypoints" Style="{DynamicResource Control.DisclosureExpander}">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{DynamicResource Text.Meta}" Text="Add two or more waypoints for a smooth move across the completed frame. One waypoint sets a fixed zoom." TextWrapping="Wrap" />
                    <ListBox Margin="0,8,0,8" MaxHeight="120" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" DisplayMemberPath="DisplayText" AutomationProperties.Name="Saved framing waypoints" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,4,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Time in clip (s)" />
<TextBox Text="{Binding FrameOffsetSeconds, StringFormat=F2}" AutomationProperties.Name="Waypoint time in clip" />
</StackPanel>
                        <StackPanel Margin="4,0,0,6"><TextBlock Style="{DynamicResource Text.Meta}" Text="Zoom (1–4×)" /><TextBox Text="{Binding Zoom, StringFormat=F2}" AutomationProperties.Name="Waypoint zoom" /></StackPanel>
                        <StackPanel Margin="0,0,4,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Pan left/right (%)" />
<TextBox Text="{Binding PanXPercent, StringFormat=F1}" AutomationProperties.Name="Waypoint horizontal pan" />
</StackPanel>
                        <StackPanel Margin="4,0,0,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Pan top/bottom (%)" />
<TextBox Text="{Binding PanYPercent, StringFormat=F1}" AutomationProperties.Name="Waypoint vertical pan" />
</StackPanel>
                    </UniformGrid>
                    <WrapPanel><Button Margin="0,0,8,0" Content="Save waypoint" Command="{Binding SaveFrameCommand}" /><Button Content="Remove selected" Command="{Binding RemoveFrameCommand}" /></WrapPanel>
                </StackPanel>
            </Expander>
            <Expander Margin="0,14,0,8" Header="Timed text / intro / outro" Style="{DynamicResource Control.DisclosureExpander}">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Style="{DynamicResource Text.Meta}" Text="Place a title, context, or closing message over part of the clip. Text is included in the video preview." TextWrapping="Wrap" />
                    <ListBox Margin="0,8,0,8" MaxHeight="120" ItemsSource="{Binding Texts}" SelectedItem="{Binding SelectedText}" DisplayMemberPath="DisplayText" AutomationProperties.Name="Saved text overlays" />
                    <TextBox Text="{Binding Text}" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="500" AutomationProperties.Name="Overlay text" />
                    <UniformGrid Columns="2" Margin="0,6,0,0">
                        <StackPanel Margin="0,0,4,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Start in clip (s)" />
<TextBox Text="{Binding TextStartSeconds, StringFormat=F2}" AutomationProperties.Name="Text start in clip" />
</StackPanel>
                        <StackPanel Margin="4,0,0,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="End in clip (s)" />
<TextBox Text="{Binding TextEndSeconds, StringFormat=F2}" AutomationProperties.Name="Text end in clip" />
</StackPanel>
                        <StackPanel Margin="0,0,4,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Vertical position (%)" />
<TextBox Text="{Binding TextVerticalPercent, StringFormat=F1}" AutomationProperties.Name="Text vertical position" />
</StackPanel>
                        <StackPanel Margin="4,0,0,6">
<TextBlock Style="{DynamicResource Text.Meta}" Text="Font size (%)" />
<TextBox Text="{Binding TextFontSizePercent, StringFormat=F1}" AutomationProperties.Name="Text font size" />
</StackPanel>
                    </UniformGrid>
                    <WrapPanel><Button Margin="0,0,8,0" Content="Save text" Command="{Binding SaveTextCommand}" /><Button Content="Remove selected" Command="{Binding RemoveTextCommand}" /></WrapPanel>
                </StackPanel>
            </Expander>
            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
