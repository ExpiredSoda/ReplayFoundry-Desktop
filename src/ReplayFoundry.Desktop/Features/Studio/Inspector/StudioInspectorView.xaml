<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:editors="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Inspector">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Studio inspector">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,4,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Edit clip" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Changes stay with the selected clip."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="Studio inspector sections"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding InspectorSections}"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedValue="{Binding SelectedInspector, Mode=TwoWay}"
                    SelectedValuePath="Key"
                    Style="{DynamicResource Control.SectionList}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.StudioNavigationItem}">
                            <Setter Property="Margin" Value="0,0,4,4" />
                            <Setter Property="Padding" Value="6,7" />
                            <Setter Property="AutomationProperties.HelpText" Value="{Binding Description}" />
                            <Setter Property="ToolTip" Value="{Binding Description}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconPath
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    IconKey="{Binding Glyph}"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Brush.TextSecondary}"
                                    StrokeThickness="1.2" />
                                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="2,5,2,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding SelectedInspectorDescription}"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="3"><editors:StudioClipEditorView /><editors:StudioTimelineEditView /><editors:StudioOutputEditorView /><editors:StudioFrameEditsView /></StackPanel>
                <editors:StudioAudioEditorView Grid.Row="4" />
                <editors:StudioCaptionEditorView Grid.Row="5" />
                <editors:StudioEffectEditorView Grid.Row="6" />
                <Border
                    Grid.Row="7"
                    Margin="0,12,0,8"
                    Style="{DynamicResource Control.CanvasInsetCard}"
                    Background="Transparent" BorderThickness="0" Padding="0"
                    Visibility="{Binding IsGraphicsEditorVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Graphics}">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Graphics overlay" />
                        <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}"
                            Text="Move or resize the selected graphic, or drop another image onto the preview."
                            TextWrapping="Wrap" Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}" />
                        <ComboBox
                            AutomationProperties.Name="Graphic on selected clip"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Overlays}"
                            SelectedItem="{Binding SelectedOverlay, Mode=TwoWay}"
                            Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="Horizontal center" />
                            <Slider AutomationProperties.Name="Graphic horizontal position" Minimum="0" Maximum="100" Value="{Binding CenterXPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Meta}" Text="Vertical center" />
                            <Slider AutomationProperties.Name="Graphic vertical position" Minimum="0" Maximum="100" Value="{Binding CenterYPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Meta}" Text="Width" />
                            <Slider AutomationProperties.Name="Graphic width" Minimum="5" Maximum="100" Value="{Binding WidthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PlacementText}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Command="{Binding ApplyPlacementCommand}" Content="Apply placement" Style="{DynamicResource Control.StudioPrimaryButton}" />
                                <Button Margin="8,0,0,0" Command="{Binding RemoveGraphicCommand}" Content="Remove graphic" Style="{DynamicResource Control.StudioDestructiveButton}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,9,0,0" AutomationProperties.LiveSetting="Polite" Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,6,0,0"
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{DynamicResource Brush.StatusError}"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <editors:StudioMetadataEditorView Grid.Row="8" />
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
