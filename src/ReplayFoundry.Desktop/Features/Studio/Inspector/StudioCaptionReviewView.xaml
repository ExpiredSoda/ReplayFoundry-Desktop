<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioCaptionReviewView" x:Name="ReviewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Padding="12" CornerRadius="8" BorderThickness="1"
        BorderBrush="{DynamicResource Brush.StatusWarning}" Background="{DynamicResource Brush.SurfaceElevated}"
        Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}"
        AutomationProperties.Name="Caption timing review">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Review captions" Command="{Binding ReviewFirstCommand}"
                    Style="{DynamicResource Control.StudioSecondaryButton}" Margin="10,0,0,0"
                    Visibility="{Binding IsCompact, ElementName=ReviewRoot, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock DockPanel.Dock="Left" Text="!" FontSize="16" FontWeight="Bold" Margin="0,0,8,0"
                    Foreground="{DynamicResource Brush.StatusWarning}" />
                <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center"
                    TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBlock Margin="0,5,0,8" Text="{Binding Guidance}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsCompact, ElementName=ReviewRoot}" Value="True" />
                                    <Condition Binding="{Binding HasMessage}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding IsCompact, ElementName=ReviewRoot, Converter={StaticResource InverseBoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Issues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.BorderSubtle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.StatusWarning}" />
                                        <TextBlock Text="{Binding Location}" Margin="0,2,0,0" Style="{DynamicResource Text.Meta}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                        <TextBlock Text="{Binding Text}" Margin="0,5,0,0" Foreground="{DynamicResource Brush.TextPrimary}"
                                            TextWrapping="Wrap" MaxHeight="56" ToolTip="{Binding Text}" />
                                        <TextBlock Text="{Binding Reason}" Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Review" VerticalAlignment="Center"
                                        Style="{DynamicResource Control.StudioSecondaryButton}"
                                        Command="{Binding DataContext.ReviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}"
                                        ToolTip="Open this phrase's word controls and move the preview to its start." />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
