<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioEffectEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Margin="0,12,0,8"
        AutomationProperties.Name="Video effect editor"
        Style="{DynamicResource Control.CanvasInsetCard}" Background="Transparent" BorderThickness="0" Padding="0"
        Visibility="{Binding IsVideoEffectEditorVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Color treatment" />
            <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="Choose a look, adjust its strength, then compare it with the original color." TextWrapping="Wrap" />
            <ComboBox
                AutomationProperties.Name="Studio video effect"
                DisplayMemberPath="Name"
                IsEnabled="{Binding IsProjectDraft}"
                ItemsSource="{Binding Clip.VideoEffectOptions}"
                SelectedItem="{Binding Clip.SelectedVideoEffect, Mode=TwoWay}" />
            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Clip.SelectedVideoEffectDescription}" TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Intensity" />
                <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.VideoEffectIntensityText}" />
            </Grid>
            <Slider
                AutomationProperties.Name="Studio video effect intensity"
                IsEnabled="{Binding Clip.Effects.CanAdjust}"
                IsSnapToTickEnabled="True"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                TickFrequency="1"
                Value="{Binding Clip.VideoEffectIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,10,0,0" Content="Compare original color"
                IsChecked="{Binding Clip.Effects.ShowOriginal, Mode=TwoWay}"
                IsEnabled="{Binding Clip.Effects.HasEffect}" />
            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}"
                Text="{Binding Clip.Effects.ComparisonStatus}" TextWrapping="Wrap" />
            <Button Margin="0,10,0,0" HorizontalAlignment="Left"
                Content="Reset effect" Command="{Binding Clip.Effects.ResetCommand}"
                Style="{DynamicResource Control.StudioSecondaryButton}" />
        </StackPanel>
    </Border>
</UserControl>
