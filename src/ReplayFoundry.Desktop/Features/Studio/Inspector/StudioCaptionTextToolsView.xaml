<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioCaptionTextToolsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Find caption text" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,5" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Find next" Command="{Binding NextCommand}" Margin="6,0,0,0"
                Style="{DynamicResource Control.StudioSecondaryButton}" />
            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=180}" MaxLength="200"
                AutomationProperties.Name="Find words in this clip's captions" />
        </DockPanel>
        <WrapPanel Margin="0,5,0,0" Visibility="{Binding HasQuery, Converter={StaticResource BoolToVisibility}}">
            <Button Content="Previous" Command="{Binding PreviousCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,6,4" />
            <Button Content="Replace…" Command="{Binding ToggleReplaceCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,6,4" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Style="{DynamicResource Control.StudioSecondaryButton}" Margin="0,0,6,4" />
            <CheckBox Content="Whole words" IsChecked="{Binding WholeWords}" VerticalAlignment="Center" Margin="0,0,0,4" />
        </WrapPanel>
        <StackPanel Visibility="{Binding ShowReplacement, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
            <TextBlock Text="Replace with" Style="{DynamicResource Text.Meta}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Replacement caption text" />
            <Button Content="{Binding ReplaceButtonText}" Command="{Binding ReplaceAllCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"
                Style="{DynamicResource Control.StudioSecondaryButton}" />
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Style="{DynamicResource Text.Meta}" TextWrapping="Wrap" Margin="0,6,0,0"
            AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
