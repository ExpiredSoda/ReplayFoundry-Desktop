<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.HiddenMoments.StudioHiddenMomentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:preview="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Preview"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    Focusable="True"
    KeyboardNavigation.ControlTabNavigation="Cycle"
    KeyboardNavigation.DirectionalNavigation="Cycle"
    KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.InputBindings>
        <KeyBinding Key="Y" Command="{Binding AcceptCommand}" />
        <KeyBinding Key="N" Command="{Binding SkipCommand}" />
        <KeyBinding Key="A" Command="{Binding AcceptCommand}" />
        <KeyBinding Key="X" Command="{Binding SkipCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousMomentCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextMomentCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseCommand}" />
    </UserControl.InputBindings>
    <Grid
        AutomationProperties.Name="Hidden Moments review"
        Background="{DynamicResource Brush.ModalScrim}">
        <Border
            MaxWidth="1180"
            MaxHeight="800"
            Margin="16"
            Padding="18"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource Brush.SurfacePanel}"
            BorderBrush="{DynamicResource Brush.StatusInfo}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="2,0,2,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock
                            Style="{DynamicResource Text.WorkspaceEyebrow}"
                            Text="HIDDEN MOMENTS / SECOND LOOK" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="Review moments that almost made the cut" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Meta}"
                            Text="Add a promising alternate to Studio, or skip it for this project. These choices do not change your Like, Neutral, or Dislike preference."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontFamily="Consolas"
                            Foreground="{DynamicResource Brush.StatusInfo}"
                            Text="{Binding ProgressText}" />
                        <Button
                            Margin="0,8,0,0"
                            AutomationProperties.HelpText="{Binding CloseButtonHelpText}"
                            AutomationProperties.Name="{Binding CloseButtonAutomationName}"
                            Command="{Binding CloseCommand}"
                            Content="{Binding CloseButtonText}"
                            Style="{DynamicResource Control.WorkspaceButton}" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="ReviewLayout" Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExhausted}" Value="True" />
                                        <Condition Binding="{Binding HasQueueItems}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition x:Name="DetailRow" Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PreviewColumn" Width="2*" />
                        <ColumnDefinition x:Name="DetailColumn" Width="360" />
                    </Grid.ColumnDefinitions>
                    <preview:StudioPreviewView DataContext="{Binding Preview}" />
                    <Border
                        x:Name="DetailPanel"
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        Padding="18"
                        Background="{DynamicResource Brush.SurfaceInset}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer
                                Grid.Row="0"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock
                                        Style="{DynamicResource Text.SectionTitle}"
                                        Text="{Binding MomentTitle}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{DynamicResource Text.Body}"
                                        Text="{Binding MomentDetail}"
                                        TextWrapping="Wrap" />
                                    <Border
                                        Margin="0,14,0,0"
                                        Padding="12"
                                        Background="{DynamicResource Brush.SurfaceElevated}"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.StatusInfo}"
                                                Text="WHY YOU MIGHT WANT IT" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding EvidenceText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Foreground="{DynamicResource Brush.StatusError}"
                                        Style="{DynamicResource Text.Meta}"
                                        Text="{Binding Error}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>

                            <Border
                                Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="0,12,0,0"
                                AutomationProperties.Name="Studio preparation queue"
                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                BorderThickness="0,1,0,0"
                                Visibility="{Binding HasQueueItems, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconPath
                                            Width="14"
                                            Height="14"
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            IconKey="Icon.Queue"
                                            Stroke="{DynamicResource Brush.StatusInfo}"
                                            StrokeThickness="1.2"
                                            Stretch="Uniform" />
                                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource Brush.StatusInfo}"
                                                Text="ADDING TO STUDIO" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                AutomationProperties.LiveSetting="Polite"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding QueueSummaryText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Cancel all Studio preparation"
                                            AutomationProperties.HelpText="Stops every unfinished moment. They remain available to review again."
                                            Command="{Binding CancelAllCommand}"
                                            Content="Cancel all"
                                            Style="{DynamicResource Control.StudioDestructiveButton}" />
                                    </Grid>

                                    <ScrollViewer
                                        Grid.Row="1"
                                        MaxHeight="190"
                                        Margin="0,10,0,0"
                                        CanContentScroll="True"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding QueueItems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,2,10" MinHeight="56">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="3" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border
                                                            Width="2"
                                                            Margin="0,1,0,1"
                                                            HorizontalAlignment="Left"
                                                            CornerRadius="1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource Brush.TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.StatusInfo}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource Brush.StatusError}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="9,0,8,0">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource Brush.TextPrimary}"
                                                                Text="{Binding DisplayName}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding DisplayName}" />
                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                Style="{DynamicResource Text.Meta}"
                                                                Text="{Binding DisplayDetail}"
                                                                TextTrimming="CharacterEllipsis"
                                                                ToolTip="{Binding DisplayDetail}" />
                                                            <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                                                <TextBlock AutomationProperties.LiveSetting="Polite" Text="{Binding StatusText}">
                                                                    <TextBlock.Style>
                                                                        <Style BasedOn="{StaticResource Text.Meta}" TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                                    Style="{DynamicResource Text.Meta}"
                                                                    Text="{Binding LivenessText}"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                            </StackPanel>
                                                            <ProgressBar
                                                                Margin="0,7,0,0"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat={}Preparing {0}}"
                                                                IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                                                Maximum="100"
                                                                Style="{DynamicResource Control.ProgressBar.Compact}"
                                                                Value="{Binding ProgressPercentage, Mode=OneWay}"
                                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                                            <TextBlock
                                                                Margin="0,4,0,0"
                                                                Foreground="{DynamicResource Brush.StatusError}"
                                                                Style="{DynamicResource Text.Meta}"
                                                                Text="{Binding Error}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding HasFailed, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            VerticalAlignment="Center"
                                                            Orientation="Horizontal">
                                                            <Button
                                                                MinWidth="56"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat={}Retry preparing {0}}"
                                                                AutomationProperties.HelpText="Tries preparing this moment again."
                                                                Command="{Binding RetryCommand}"
                                                                Content="Retry"
                                                                Style="{DynamicResource Control.StudioSecondaryButton}"
                                                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                                                            <Button
                                                                Margin="6,0,0,0"
                                                                AutomationProperties.Name="{Binding DisplayName, StringFormat={}Cancel preparing {0}}"
                                                                AutomationProperties.HelpText="Stops this unfinished moment. It remains available to review again."
                                                                Command="{Binding CancelCommand}"
                                                                Style="{DynamicResource Control.StudioDestructiveIconButton}"
                                                                ToolTip="Cancel preparing this moment"
                                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}">
                                                                <controls:IconPath
                                                                    Width="13"
                                                                    Height="13"
                                                                    IconKey="Icon.Close"
                                                                    Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                    StrokeThickness="1.4"
                                                                    Stretch="Uniform" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                    <Button
                                        MinHeight="34"
                                        MinWidth="92"
                                        AutomationProperties.Name="Previous hidden moment"
                                        AutomationProperties.HelpText="Shows the previous alternate without recording a choice."
                                        Command="{Binding PreviousMomentCommand}"
                                        Style="{DynamicResource Control.WorkspaceButton}"
                                        ToolTip="Previous moment (Ctrl+Page Up)">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <controls:IconPath
                                                Width="12"
                                                Height="12"
                                                Margin="0,0,6,0"
                                                IconKey="Icon.ChevronLeft"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.5"
                                                Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" Text="Previous" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        MinHeight="34"
                                        MinWidth="76"
                                        AutomationProperties.Name="Next hidden moment"
                                        AutomationProperties.HelpText="Shows the next alternate without recording a choice."
                                        Command="{Binding NextMomentCommand}"
                                        Style="{DynamicResource Control.WorkspaceButton}"
                                        ToolTip="Next moment (Ctrl+Page Down)">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="Next" />
                                            <controls:IconPath
                                                Width="12"
                                                Height="12"
                                                Margin="6,0,0,0"
                                                IconKey="Icon.ChevronRight"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.5"
                                                Stretch="Uniform" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Margin="0,0,6,0"
                                        MinHeight="48"
                                        AutomationProperties.Name="Skip hidden moment"
                                        AutomationProperties.HelpText="Skips this moment without recording a Dislike."
                                        Command="{Binding SkipCommand}"
                                        Style="{DynamicResource Control.WorkspaceButton}"
                                        ToolTip="Skip this moment (X or N)">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <controls:IconPath
                                                Width="17"
                                                Height="17"
                                                Margin="0,0,7,0"
                                                IconKey="Icon.Close"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.5"
                                                Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" Text="Skip" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        MinHeight="48"
                                        AutomationProperties.Name="Add hidden moment to Studio"
                                        AutomationProperties.HelpText="Adds this moment to the Studio queue so you can keep reviewing, without recording a Like."
                                        Command="{Binding AcceptCommand}"
                                        Style="{DynamicResource Control.PrimaryButton}"
                                        ToolTip="Add this moment to Studio (A or Y)">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <controls:IconPath
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,7,0"
                                                IconKey="Icon.Heart"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.3"
                                                Stretch="Uniform" />
                                            <TextBlock VerticalAlignment="Center" Text="Add to Studio" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    Grid.Row="1"
                    MaxWidth="620"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfaceInset}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsExhausted}" Value="True" />
                                        <Condition Binding="{Binding HasQueueItems}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{DynamicResource Text.SectionTitle}"
                            Text="{Binding MomentTitle}"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Style="{DynamicResource Text.Body}"
                            Text="{Binding MomentDetail}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <Button
                            Margin="0,18,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding CloseCommand}"
                            Content="Return to Studio"
                            Style="{DynamicResource Control.PrimaryButton}" />
                        <Button
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding ReviewSkippedAgainCommand}"
                            Content="Review skipped moments again"
                            Style="{DynamicResource Control.WorkspaceButton}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
