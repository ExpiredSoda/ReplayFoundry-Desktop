<UserControl x:Class="ReplayFoundry.Desktop.Features.Studio.HiddenMoments.StudioMomentFilterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource Control.ThemedToggleButton}">
            <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,4" /><Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>
    <WrapPanel ToolTip="Choose two types to find moments with both. Unclassified moments stay available in All.">
        <ToggleButton Content="All moments" IsChecked="{Binding All}" />
        <ToggleButton Content="Gameplay" IsChecked="{Binding Gameplay}" />
        <ToggleButton Content="Commentary" IsChecked="{Binding Commentary}" />
        <ToggleButton Content="Funny" IsChecked="{Binding Funny}" />
        <ToggleButton Content="Not yet classified" IsChecked="{Binding Unclassified}" />
    </WrapPanel>
</UserControl>
