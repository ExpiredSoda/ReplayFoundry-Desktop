<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Preview.StudioPreviewView"
    x:Name="PreviewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:flair="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Preview"
    AllowDrop="True"
    DragEnter="OnGraphicDragEnter"
    Drop="OnGraphicDrop"
    Focusable="True">
    <UserControl.Resources>
        <local:StudioCaptionPositionMarginConverter x:Key="StudioCaptionPositionMarginConverter" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayCommand}" />
        <KeyBinding Key="Left" Command="{Binding RewindPreviewCommand}" />
        <KeyBinding Key="Right" Command="{Binding ForwardPreviewCommand}" />
        <KeyBinding Key="J" Command="{Binding RewindPreviewCommand}" />
        <KeyBinding Key="L" Command="{Binding ForwardPreviewCommand}" />
        <KeyBinding Key="OemComma" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="OemPeriod" Command="{Binding NextCommand}" />
    </UserControl.InputBindings>
    <Border AutomationProperties.Name="Studio preview and transport">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Control.CanvasPane}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowDetails, ElementName=PreviewRoot}" Value="False"><Setter Property="Padding" Value="0" /></DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Visibility="{Binding ShowHeader, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <flair:FoundryHeading Style="{DynamicResource Text.SectionTitle}" Text="Preview" />
                    <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding SequenceSummary}" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding ModeBadge}" />
                    <TextBlock Margin="0,5,0,0" HorizontalAlignment="Right" Style="{DynamicResource Text.Meta}" Text="{Binding PreviewScaleText}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" MinHeight="0" Background="{DynamicResource Brush.SurfaceInset}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Margin" Value="0,10,0,10" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowDetails, ElementName=PreviewRoot}" Value="False"><Setter Property="Margin" Value="0" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="10,4,10,0" Visibility="{Binding ShowDetails, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PreviewTimecode}" />
                        <TextBlock Margin="5,0" Foreground="{DynamicResource Brush.TextMuted}" Text="/" />
                        <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding PreviewDurationText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10"
                        Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding PreviewFormatText}" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CaptionHelpButton" Grid.Column="2" Width="40" Height="40"
                        Style="{DynamicResource Control.IconButton}" Content="i"
                        FontFamily="Segoe UI" FontWeight="SemiBold"
                        AutomationProperties.Name="Caption help"
                        AutomationProperties.HelpText="{Binding LiveCaptionPresentationWarning}"
                        Click="OnCaptionHelpClick" PreviewKeyDown="OnCaptionHelpKeyDown"
                        LostKeyboardFocus="OnCaptionHelpLostFocus"
                        Visibility="{Binding HasLiveCaptionPresentationWarning, Converter={StaticResource BoolToVisibility}}">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="320" Placement="Bottom">
                                <TextBlock Text="{Binding LiveCaptionPresentationWarning}" TextWrapping="Wrap" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Popup x:Name="CaptionHelpPopup" Grid.Column="2" Placement="Bottom"
                        PlacementTarget="{Binding ElementName=CaptionHelpButton}"
                        StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                        <Border MaxWidth="320" Margin="4" Padding="14"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="About these captions" />
                                <TextBlock Margin="0,8,0,0" Style="{DynamicResource Text.Body}"
                                    Text="{Binding LiveCaptionPresentationWarning}" TextWrapping="Wrap"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Grid x:Name="PreviewViewport" Grid.Row="1" MinHeight="0" Margin="8">
                    <Viewbox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Stretch="Uniform"
                        Visibility="{Binding IsPreviewAvailable, Converter={StaticResource BoolToVisibility}}">
                        <Border
                            Width="{Binding PreviewCanvasWidth}"
                            Height="{Binding PreviewCanvasHeight}"
                            Background="Black"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="{DynamicResource Radius.OrganicCard}">
                            <Grid ClipToBounds="True">
                                <Grid x:Name="PreviewPlayerHost" />
                                <local:StudioCaptionSafeAreaGuide IsHitTestVisible="False" CaptionTypography="{Binding LiveCaptionTypography}" />
                                <local:StudioCaptionPreviewText
                                    Width="{Binding LiveCaptionMaximumWidthPixels}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False"
                                    AccentLength="{Binding LiveCaptionAccentLength}"
                                    AccentProgress="{Binding LiveCaptionAccentProgress}"
                                    AccentStartIndex="{Binding LiveCaptionAccentStartIndex}"
                                    CaptionFontSize="{Binding LiveCaptionFontSizePixels}"
                                    CaptionScale="{Binding LiveCaptionScale}"
                                    CaptionStyle="{Binding LiveCaptionStyle}"
                                    CaptionTypography="{Binding LiveCaptionTypography}"
                                    EmphasisSpans="{Binding LiveCaptionEmphasisSpans}"
                                    CaptionText="{Binding LiveCaptionText}"
                                    SweepLength="{Binding LiveCaptionSweepLength}"
                                    Visibility="{Binding HasLiveCaption, Converter={StaticResource BoolToVisibility}}">
                                    <local:StudioCaptionPreviewText.Margin>
                                        <MultiBinding Converter="{StaticResource StudioCaptionPositionMarginConverter}">
                                            <Binding Path="PreviewCanvasHeight" />
                                            <Binding Path="LiveCaptionVerticalPercent" />
                                            <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
                                        </MultiBinding>
                                    </local:StudioCaptionPreviewText.Margin>
                                </local:StudioCaptionPreviewText>
                                <local:StudioCaptionPreviewText Width="{Binding LiveCaptionMaximumWidthPixels}" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False"
                                    CaptionText="{Binding LiveSecondaryCaptionText}" CaptionFontSize="{Binding LiveSecondaryCaptionFontSizePixels}" CaptionTypography="{Binding LiveCaptionTypography}"
                                    Visibility="{Binding HasLiveSecondaryCaption, Converter={StaticResource BoolToVisibility}}">
                                    <local:StudioCaptionPreviewText.Margin>
                                        <MultiBinding Converter="{StaticResource StudioCaptionPositionMarginConverter}">
                                            <Binding Path="PreviewCanvasHeight" /><Binding Path="LiveSecondaryCaptionVerticalPercent" /><Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
                                        </MultiBinding>
                                    </local:StudioCaptionPreviewText.Margin>
                                </local:StudioCaptionPreviewText>
                                <ProgressBar
                                    Width="96"
                                    Margin="0,12,12,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Loading Studio preview"
                                    IsIndeterminate="True"
                                    Style="{DynamicResource Control.ProgressBar.Compact}"
                                    Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>
                    </Viewbox>

                    <Border
                        Background="{DynamicResource Brush.CompositionCanvas}"
                        Style="{DynamicResource Control.CanvasInsetCard}"
                        Visibility="{Binding IsPreviewAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                        <StackPanel
                            MaxWidth="460"
                            Margin="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Border Width="42" Height="42" HorizontalAlignment="Center" Background="{DynamicResource Brush.InteractiveSelected}" BorderBrush="{DynamicResource Brush.StatusInfo}" BorderThickness="1" CornerRadius="12">
                                <controls:IconPath Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" IconKey="Icon.Edit" Stroke="{DynamicResource Brush.StatusInfo}" StrokeThickness="1.3" Stretch="Uniform" />
                            </Border>
                            <flair:FoundryHeading Margin="0,12,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.SectionTitle}" Text="{Binding ProjectPromptTitle}" TextAlignment="Center" />
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding PreviewStatus}" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,9,0,0"
                                MaxWidth="440"
                                Foreground="{DynamicResource Brush.StatusError}"
                                Style="{DynamicResource Text.Meta}"
                                Text="{Binding PreviewError}"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar
                                Width="220"
                                Margin="0,14,0,0"
                                AutomationProperties.Name="Loading Studio preview"
                                IsIndeterminate="True"
                                Style="{DynamicResource Control.ProgressBar.Compact}"
                                Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                            <Button
                                Margin="0,14,0,0"
                                AutomationProperties.Name="Retry Studio preview"
                                Command="{Binding ReloadPreviewCommand}"
                                Content="Retry preview"
                                Style="{DynamicResource Control.PrimaryButton}"
                                Visibility="{Binding HasPreviewError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="12,0,12,10" Visibility="{Binding ShowDetails, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="InlinePreviewGuidance"
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Stretch"
                        FontSize="10"
                        Foreground="{DynamicResource Brush.TextMuted}"
                        Text="{Binding PreviewStatus}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding UsesSecondaryGuidancePlacement, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Visibility="{Binding ShowPositionSlider, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}">
            <Slider
                x:Name="PreviewPositionSlider"
                Grid.Row="2"
                Margin="2,0,2,10"
                AutomationProperties.Name="Studio preview position"
                IsEnabled="{Binding IsPreviewAvailable}"
                Minimum="{Binding PreviewPositionMinimumSeconds}"
                Maximum="{Binding PreviewPositionMaximumSeconds}"
                Value="{Binding PreviewPositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Visibility="{Binding IsPreviewAvailable, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Grid Grid.Row="3" Visibility="{Binding ShowDetails, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                x:Name="SecondaryPreviewGuidance"
                Grid.Row="3"
                MaxWidth="620"
                Margin="4,0,4,8"
                HorizontalAlignment="Right"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{DynamicResource Brush.TextMuted}"
                Style="{DynamicResource Text.Meta}"
                Text="{Binding PreviewStatus}"
                TextAlignment="Right"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding UsesSecondaryGuidancePlacement, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <Border
                Grid.Row="4"
                Visibility="{Binding ShowDetails, ElementName=PreviewRoot, Converter={StaticResource BoolToVisibility}}"
                Padding="8,6"
                Background="{DynamicResource Brush.KineticGlowSoft}"
                Style="{DynamicResource Control.CanvasGhostZone}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button
                        AutomationProperties.Name="Previous frame"
                        AutomationProperties.HelpText="Moves the preview backward by one frame."
                        Command="{Binding PreviousCommand}"
                        Style="{DynamicResource Control.IconButton}"
                        ToolTip="Previous frame (comma)">
                        <controls:IconPath Width="14" Height="14" IconKey="Icon.SkipBack" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Rewind five seconds"
                        Command="{Binding RewindPreviewCommand}"
                        Style="{DynamicResource Control.IconButton}"
                        ToolTip="Rewind five seconds (Left or J)">
                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Rewind" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Play or pause preview"
                        AutomationProperties.HelpText="Plays or pauses inside the current saved clip boundaries."
                        Command="{Binding PlayCommand}"
                        Style="{DynamicResource Control.PrimaryIconButton}"
                        ToolTip="{Binding PreviewPlayPauseText, StringFormat={}{0} (Space)}">
                        <controls:IconPath Width="15" Height="15" IconKey="{Binding PreviewPlayPauseIconKey}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Forward five seconds"
                        Command="{Binding ForwardPreviewCommand}"
                        Style="{DynamicResource Control.IconButton}"
                        ToolTip="Forward five seconds (Right or L)">
                        <controls:IconPath Width="14" Height="14" IconKey="Icon.FastForward" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                    </Button>
                    <Button
                        Margin="6,0,0,0"
                        AutomationProperties.Name="Next frame"
                        AutomationProperties.HelpText="Moves the preview forward by one frame."
                        Command="{Binding NextCommand}"
                        Style="{DynamicResource Control.IconButton}"
                        ToolTip="Next frame (period)">
                        <controls:IconPath Width="14" Height="14" IconKey="Icon.SkipForward" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal">
                    <Button
                        Width="40"
                        AutomationProperties.Name="{Binding CaptionVisibilityText}"
                        AutomationProperties.HelpText="Shows or hides the actual caption content in the Studio preview. This does not change the final render."
                        Command="{Binding ToggleCaptionVisibilityCommand}"
                        ToolTip="{Binding CaptionVisibilityText}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Control.IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCaptionContentVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusInfo}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPath Width="15" Height="15" IconKey="Icon.Caption" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                        </StackPanel>
                    </Button>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanShowCaptionControls}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
            </Grid>
            </Border>
            <local:StudioClipFeedbackView Grid.Row="5" Margin="4,10,4,0"
                DataContext="{Binding ClipPreference, ElementName=PreviewRoot}">
                <local:StudioClipFeedbackView.Style>
                    <Style TargetType="local:StudioClipFeedbackView">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ClipPreference, ElementName=PreviewRoot}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding ShowDetails, ElementName=PreviewRoot}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:StudioClipFeedbackView.Style>
            </local:StudioClipFeedbackView>
        </Grid>
    </Border>
</UserControl>
