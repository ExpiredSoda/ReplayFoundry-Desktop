<Window
    x:Class="ReplayFoundry.Desktop.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dock="clr-namespace:ReplayFoundry.Desktop.Shell.Dock"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Replay Foundry"
    Style="{DynamicResource Control.ThemedWindow}"
    Width="1280"
    Height="720"
    MinWidth="760"
    MinHeight="600"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="/ReplayFoundry.Desktop;component/Assets/Icons/Application/ReplayFoundry.ico"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    SnapsToDevicePixels="True"
    Topmost="False"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="None"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="Shell.ServiceStatusIndicator" TargetType="{x:Type Label}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="300" />
            <Setter Property="ToolTipService.ShowDuration" Value="12000" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Label}">
                        <Border
                            x:Name="ServiceFrame"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Border
                                    x:Name="ReadySignal"
                                    Margin="3"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="5"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger
                                Binding="{Binding LocalAiServiceState}"
                                Value="{x:Static local:ShellServiceState.Ready}">
                                <Setter TargetName="ReadySignal" Property="Opacity" Value="0.14" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ServiceFrame" Property="Background" Value="{DynamicResource Brush.InteractiveHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                <Setter TargetName="ServiceFrame" Property="Background" Value="{DynamicResource Brush.HighContrastWindow}" />
                                <Setter TargetName="ServiceFrame" Property="BorderBrush" Value="{DynamicResource Brush.HighContrastBorder}" />
                                <Setter TargetName="ReadySignal" Property="Opacity" Value="0" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding LocalAiServiceState}"
                    Value="{x:Static local:ShellServiceState.Ready}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusSuccess}" />
                    <Setter Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusSuccess}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger
                    Binding="{Binding LocalAiServiceState}"
                    Value="{x:Static local:ShellServiceState.Degraded}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusWarning}" />
                    <Setter Property="Opacity" Value="0.82" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.HighContrastText}" />
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenGuideCommand}" />
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding OpenCommandPaletteCommand}" />
        <KeyBinding Key="Oem2" Modifiers="Control" Command="{Binding OpenShortcutReferenceCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseOverlayCommand}" />
    </Window.InputBindings>

    <Grid
        x:Name="ShellSurface"
        Background="{DynamicResource Brush.WindowFallback}">
        <Rectangle
            Panel.ZIndex="0"
            Fill="{DynamicResource Brush.WindowGrid}"
            IsHitTestVisible="False"
            Opacity="0.14" />

        <Border Panel.ZIndex="1" Background="{DynamicResource Brush.WindowOverlay}" IsHitTestVisible="False" />

        <Grid
            Panel.ZIndex="2"
            Margin="12,64,12,72">
            <ContentControl
                x:Name="WorkspaceContent"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{Binding CurrentWorkspace}" />
        </Grid>

        <dock:FloatingDock
            Panel.ZIndex="40"
            Margin="12,0,12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            NavigateCommand="{Binding NavigateCommand}"
            SelectedDestination="{Binding CurrentDestination, Mode=OneWay}" />

        <Border
            x:Name="TitleBar"
            Panel.ZIndex="100"
            Height="56"
            VerticalAlignment="Top"
            Padding="14,0,0,0"
            BorderBrush="{DynamicResource Brush.TitleBarBorder}"
            BorderThickness="0,0,0,1"
            shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.TitleBarActive}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource Brush.TitleBarInactive}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.HighContrastWindow}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighContrastBorder}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Image
                        Width="28"
                        Height="28"
                        Margin="0,0,10,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{DynamicResource Brush.BrandPaper}"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="REPLAY" />
                        <TextBlock
                            Margin="0,-1,0,0"
                            Foreground="{DynamicResource Brush.BrandCyan}"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="FOUNDRY" />
                    </StackPanel>
                    <StackPanel
                        x:Name="ServiceStatusCluster"
                        Margin="12,0,0,0"
                        AutomationProperties.Name="Installed tools"
                        Orientation="Horizontal">
                        <Label
                            x:Name="LocalAiStatusIndicator"
                            AutomationProperties.HelpText="{Binding LocalAiStatusDetail}"
                            AutomationProperties.ItemStatus="{Binding LocalAiAccessibleStatus}"
                            AutomationProperties.LiveSetting="Polite"
                            AutomationProperties.Name="{Binding LocalAiAccessibleName}"
                            Style="{StaticResource Shell.ServiceStatusIndicator}"
                            Tag="{Binding LocalAiServiceState}">
                            <Label.ToolTip>
                                <ToolTip>
                                    <TextBlock
                                        MaxWidth="280"
                                        Text="{Binding PlacementTarget.DataContext.LocalAiStatusDetail, RelativeSource={RelativeSource AncestorType={x:Type ToolTip}}}"
                                        TextWrapping="Wrap" />
                                </ToolTip>
                            </Label.ToolTip>
                            <Grid Width="20" Height="20">
                                <controls:IconPath
                                    x:Name="LocalAiStatusIcon"
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IconKey="{Binding LocalAiStatusIcon}"
                                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"
                                    StrokeThickness="1.35"
                                    Stretch="Uniform" />
                                <Border
                                    Width="10"
                                    Height="10"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource Brush.WindowFallback}"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                    <TextBlock
                                        x:Name="LocalAiStatusMarker"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="7"
                                        FontWeight="Bold"
                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Label}}}"
                                        Text="{Binding LocalAiStatusMarker}" />
                                </Border>
                            </Grid>
                        </Label>
                    </StackPanel>
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="WorkspaceChromeEyebrow"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource Text.TitleBar}"
                        Text="{Binding CurrentWorkspaceChrome.WorkspaceEyebrow}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="WorkspaceChromeDescription"
                        Margin="0,2,0,0"
                        Style="{DynamicResource Text.TitleBarSecondary}"
                        Text="{Binding CurrentWorkspaceChrome.WorkspaceDescription}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Border
                    Grid.Column="4"
                    MaxWidth="160"
                    Margin="0,0,12,0"
                    HorizontalAlignment="Right"
                    Style="{DynamicResource Control.ChromeStatusPill}">
                    <TextBlock
                        Style="{DynamicResource Text.TitleBarStatus}"
                        ToolTip="{Binding CurrentWorkspaceChrome.StatusText}"
                        Text="{Binding CurrentWorkspaceChrome.StatusText}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        x:Name="CaptionHelpButton"
                        Width="40"
                        Height="40"
                        MinWidth="40"
                        Padding="0"
                        AutomationProperties.HelpText="Open the searchable Foundry Guide."
                        AutomationProperties.Name="Open Foundry Guide"
                        Command="{Binding OpenGuideCommand}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{DynamicResource Control.CaptionButton}">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="?" />
                    </Button>
                    <Button
                        x:Name="CaptionMinimizeButton"
                        AutomationProperties.HelpText="Minimize the Replay Foundry window."
                        AutomationProperties.Name="Minimize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{DynamicResource Control.CaptionButton}">
                        <TextBlock Style="{DynamicResource Text.CaptionGlyph}" Text="{StaticResource Icon.Glyph.ChromeMinimize}" />
                    </Button>
                    <Button
                        x:Name="CaptionMaximizeButton"
                        AutomationProperties.HelpText="Maximize or restore the Replay Foundry window."
                        AutomationProperties.Name="Maximize window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{DynamicResource Control.CaptionButton}">
                        <TextBlock x:Name="CaptionMaximizeGlyph" Style="{DynamicResource Text.CaptionGlyph}" Text="{StaticResource Icon.Glyph.ChromeMaximize}" />
                    </Button>
                    <Button
                        x:Name="CaptionCloseButton"
                        AutomationProperties.HelpText="Close Replay Foundry."
                        AutomationProperties.Name="Close window"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Style="{DynamicResource Control.CaptionCloseButton}">
                        <TextBlock Style="{DynamicResource Text.CaptionGlyph}" Text="{StaticResource Icon.Glyph.ChromeClose}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Panel.ZIndex="90"
            Margin="0,56,0,0"
            Background="{DynamicResource Brush.ModalScrim}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveOverlay}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.HighContrastWindow}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.HighContrastBorder}" />
                            <Setter Property="BorderThickness" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentPresenter Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{Binding ActiveOverlay}" />
        </Border>
    </Grid>
</Window>
