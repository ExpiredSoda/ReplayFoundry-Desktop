<UserControl
    x:Class="ReplayFoundry.Desktop.Presentation.Controls.IssuePanel"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    AutomationProperties.LiveSetting="Polite">
    <Grid MaxWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
            <Border
                Width="58"
                Height="58"
                HorizontalAlignment="Center"
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.StatusInfo}"
                BorderThickness="1"
                CornerRadius="8">
                <controls:IconPath
                    Width="26"
                    Height="26"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IconKey="{Binding IconKey, ElementName=Root}"
                    Stroke="{DynamicResource Brush.StatusInfo}"
                    StrokeThickness="1.3"
                    Stretch="Uniform" />
            </Border>
            <Border
                Margin="0,12,0,0"
                Padding="9,4"
                HorizontalAlignment="Center"
                Background="{DynamicResource Brush.InteractiveSelected}"
                CornerRadius="999">
                <TextBlock
                    Foreground="{DynamicResource Brush.StatusInfo}"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding Reference, ElementName=Root}" />
            </Border>
            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="{DynamicResource Brush.TextPrimary}"
                Text="{Binding Summary, ElementName=Root}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                MaxWidth="610"
                HorizontalAlignment="Center"
                Style="{DynamicResource Text.Body}"
                Text="{Binding Suggestion, ElementName=Root}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,24,0,0"
            Padding="18,14"
            Background="{DynamicResource Brush.SurfaceInset}"
            BorderBrush="{DynamicResource Brush.BorderSubtle}"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock HorizontalAlignment="Center" Style="{DynamicResource Text.WorkspaceEyebrow}" Text="01" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{Binding StageOne, ElementName=Root}" TextAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="1" Width="1" Margin="18,0" Background="{DynamicResource Brush.BorderSubtle}" />
                <StackPanel Grid.Column="2">
                    <TextBlock HorizontalAlignment="Center" Style="{DynamicResource Text.WorkspaceEyebrow}" Text="02" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{Binding StageTwo, ElementName=Root}" TextAlignment="Center" />
                </StackPanel>
                <Border Grid.Column="3" Width="1" Margin="18,0" Background="{DynamicResource Brush.BorderSubtle}" />
                <StackPanel Grid.Column="4">
                    <TextBlock HorizontalAlignment="Center" Style="{DynamicResource Text.WorkspaceEyebrow}" Text="03" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" Style="{DynamicResource Text.Body}" Text="{Binding StageThree, ElementName=Root}" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Expander
            Grid.Row="2"
            Margin="0,14,0,0"
            Header="Technical details"
            IsExpanded="False"
            Style="{DynamicResource Control.QuietExpander}">
            <TextBox
                Margin="0,8,0,0"
                MinHeight="72"
                AutomationProperties.HelpText="Details can be selected and copied for support."
                Background="{DynamicResource Brush.SurfaceInset}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                Foreground="{DynamicResource Brush.TextSecondary}"
                IsReadOnly="True"
                Text="{Binding Details, ElementName=Root}"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto" />
        </Expander>
    </Grid>
</UserControl>
