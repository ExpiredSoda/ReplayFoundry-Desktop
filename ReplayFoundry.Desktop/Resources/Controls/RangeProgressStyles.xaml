<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Style x:Key="Control.RangeThumb" TargetType="{x:Type Thumb}">
        <!-- The 20x28 hit target stays easy to acquire; only the painted node is small. -->
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="{DynamicResource Brush.StatusInfo}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Ellipse
                            x:Name="ThumbSurface"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Fill="{TemplateBinding Background}"
                            Stroke="{DynamicResource Brush.TextPrimary}"
                            StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Width" Value="17" />
                            <Setter TargetName="ThumbSurface" Property="Height" Value="17" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Width" Value="18" />
                            <Setter TargetName="ThumbSurface" Property="Height" Value="18" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Slider}}}" Value="True">
                            <Setter TargetName="ThumbSurface" Property="Width" Value="17" />
                            <Setter TargetName="ThumbSurface" Property="Height" Value="17" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Control.RangeTrackButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border
                        Height="4"
                        VerticalAlignment="Center"
                        Background="{TemplateBinding Background}"
                        CornerRadius="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Slider}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Height="28">
                        <Track
                            x:Name="PART_Track"
                            VerticalAlignment="Center"
                            Minimum="{TemplateBinding Minimum}"
                            Maximum="{TemplateBinding Maximum}"
                            Value="{TemplateBinding Value}"
                            IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                            Orientation="{TemplateBinding Orientation}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static Slider.DecreaseLarge}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{TemplateBinding Foreground}"
                                    Style="{StaticResource Control.RangeTrackButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource Control.RangeThumb}" /></Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="{x:Static Slider.IncreaseLarge}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Background="{TemplateBinding Background}"
                                    Style="{StaticResource Control.RangeTrackButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
            <Trigger Property="Validation.HasError" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.StatusError}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ProgressTrack}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="4" />
                            <Border
                                x:Name="IndeterminateSignal"
                                Width="88"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.PrimaryAction}"
                                CornerRadius="4"
                                Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-96" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0" />
                            <Setter TargetName="IndeterminateSignal" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                <Condition Binding="{Binding Source={x:Static system:SystemParameters.ClientAreaAnimation}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="IndeterminateSignal"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                            From="-96"
                                            To="360"
                                            Duration="{StaticResource Motion.Ambient}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Indeterminate}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.48" /></Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
