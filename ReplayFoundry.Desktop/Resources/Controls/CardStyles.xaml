<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework">
    <Style x:Key="Control.SectionCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfacePanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Card}" />
        <Setter Property="Padding" Value="{DynamicResource Space16}" />
    </Style>
    <Style x:Key="Control.InsetCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="{DynamicResource Space12}" />
    </Style>
    <Style x:Key="Control.CanvasPane" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.KineticCanvasPane}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.OrganicPane}" />
        <Setter Property="Padding" Value="{DynamicResource Space16}" />
    </Style>
    <Style x:Key="Control.CanvasFilterPane" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="2,0" />
    </Style>
    <!--
        A quieter inner grouping for dense editors and Settings sections.
        The surface difference provides the boundary; an extra one-pixel box
        is deliberately omitted so nested tools read as one canvas.
    -->
    <Style x:Key="Control.CanvasInsetCard" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.OrganicCard}" />
        <Setter Property="Padding" Value="{DynamicResource Space12}" />
    </Style>
    <Style x:Key="Control.CanvasGhostZone" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.OrganicCard}" />
        <Setter Property="Padding" Value="{DynamicResource Space12}" />
    </Style>
    <Style x:Key="Control.KineticMediaCard" TargetType="{x:Type Border}" BasedOn="{StaticResource Control.InsetCard}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.OrganicCard}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.InteractiveHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.KineticGlow}" />
                <Setter Property="Panel.ZIndex" Value="2" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="10"
                            Color="{DynamicResource Color.AccentCyan}"
                            Opacity="0.18"
                            ShadowDepth="1" />
                    </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                From="1"
                                To="1.012"
                                Duration="{StaticResource Motion.Hover}"
                                EasingFunction="{StaticResource Motion.EaseOut}" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                From="1"
                                To="1.012"
                                Duration="{StaticResource Motion.Hover}"
                                EasingFunction="{StaticResource Motion.EaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                To="1"
                                Duration="{StaticResource Motion.Hover}" />
                            <DoubleAnimation
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                To="1"
                                Duration="{StaticResource Motion.Hover}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    <Condition Binding="{Binding Source={x:Static system:SystemParameters.ClientAreaAnimation}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.012" ScaleY="1.012" />
                    </Setter.Value>
                </Setter>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Control.WorkspaceButton" TargetType="{x:Type Button}" BasedOn="{StaticResource Control.ThemedButton}" />
</ResourceDictionary>
