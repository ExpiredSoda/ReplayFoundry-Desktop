<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Replay Foundry brand system, aligned with replayfoundry.com.
        The palette is deliberately flat: deep ink, warm paper, foundry cyan,
        process blue, signal yellow, and a small set of semantic colors.
    -->
    <Color x:Key="Color.BrandInk">#071014</Color>
    <Color x:Key="Color.BrandInkSoft">#0D1A20</Color>
    <Color x:Key="Color.BrandInkRaised">#10242C</Color>
    <Color x:Key="Color.BrandPaper">#EEF1EC</Color>
    <Color x:Key="Color.BrandCyan">#58D6FF</Color>
    <Color x:Key="Color.BrandBlue">#1599C8</Color>
    <Color x:Key="Color.BrandBlueDeep">#0A83AD</Color>
    <Color x:Key="Color.BrandYellow">#FFC85A</Color>
    <Color x:Key="Color.BrandGreen">#72E097</Color>
    <Color x:Key="Color.PlatformYouTube">#FF0033</Color>
    <Color x:Key="Color.PlatformYouTubeGlyph">#FFFFFF</Color>

    <!--  Live preview remains intentionally darker than the editing chrome.  -->
    <Color x:Key="Color.PreviewCanvasDark">#050B0E</Color>

    <!--  Window and overlays.  -->
    <Color x:Key="Color.WindowFallback">#071014</Color>
    <Color x:Key="Color.WindowOverlay">#06071014</Color>
    <Color x:Key="Color.WindowGridLine">#28263842</Color>
    <Color x:Key="Color.WindowGridMajor">#3D2E4852</Color>
    <Color x:Key="Color.ModalScrim">#C2050B0E</Color>
    <Color x:Key="Color.OverlaySurface">#FF0D1A20</Color>

    <!--  Dock.  -->
    <Color x:Key="Color.DockSurfaceTop">#FA0D1A20</Color>
    <Color x:Key="Color.DockSurfaceBottom">#FA0D1A20</Color>
    <Color x:Key="Color.DockBorder">#FF263842</Color>
    <Color x:Key="Color.DockButtonHover">#FF152B34</Color>
    <Color x:Key="Color.DockFocus">#FF58D6FF</Color>
    <Color x:Key="Color.DockShadow">#02080A</Color>

    <!--  Text.  -->
    <Color x:Key="Color.TextPrimary">#FFEEF1EC</Color>
    <Color x:Key="Color.TextSecondary">#FFA8B6B8</Color>
    <Color x:Key="Color.TextMuted">#FF73898F</Color>
    <Color x:Key="Color.TextDisabled">#8A73898F</Color>
    <Color x:Key="Color.TextOnAccent">#FF071014</Color>

    <!--
        Compatibility keys retain their public resource identity while moving
        every caller onto the new brand colors. AccentViolet is intentionally
        the yellow signal accent; no violet remains in the active system.
    -->
    <Color x:Key="Color.AccentCyan">#FF58D6FF</Color>
    <Color x:Key="Color.AccentBlue">#FF1599C8</Color>
    <Color x:Key="Color.AccentViolet">#FFFFC85A</Color>
    <Color x:Key="Color.AccentCyanTransparent">#0058D6FF</Color>

    <!--  Application surfaces.  -->
    <Color x:Key="Color.SurfaceCanvas">#ED071014</Color>
    <Color x:Key="Color.SurfacePanel">#F70D1A20</Color>
    <Color x:Key="Color.SurfaceElevated">#FF10242C</Color>
    <Color x:Key="Color.SurfaceInset">#FF091318</Color>
    <Color x:Key="Color.BorderSubtle">#FF263842</Color>
    <Color x:Key="Color.BorderStrong">#FF4C6268</Color>
    <Color x:Key="Color.BorderFocus">#FF58D6FF</Color>
    <Color x:Key="Color.InteractiveHover">#FF16323C</Color>
    <Color x:Key="Color.InteractiveSelected">#FF1B3B46</Color>
    <Color x:Key="Color.InteractivePressed">#FF0A83AD</Color>
    <!--
        Kinetic-canvas accents are intentionally translucent and bounded.
        They provide ink-like selection and focus cues without introducing a
        second palette or the heavy blur layers that penalize lower-end PCs.
    -->
    <Color x:Key="Color.KineticGlow">#6658D6FF</Color>
    <Color x:Key="Color.KineticGlowSoft">#2458D6FF</Color>
    <Color x:Key="Color.KineticCanvasPane">#D90D1A20</Color>
    <Color x:Key="Color.StatusSuccess">#FF72E097</Color>
    <Color x:Key="Color.StatusWarning">#FFFFC85A</Color>
    <Color x:Key="Color.StatusError">#FFFF8F8F</Color>
    <Color x:Key="Color.StatusInfo">#FF58D6FF</Color>

    <!--  Window chrome and interaction system.  -->
    <Color x:Key="Color.TitleBarActive">#FF071014</Color>
    <Color x:Key="Color.TitleBarInactive">#F2071014</Color>
    <Color x:Key="Color.TitleBarBorder">#FF263842</Color>
    <Color x:Key="Color.CaptionHover">#FF16323C</Color>
    <Color x:Key="Color.CaptionPressed">#FF0A83AD</Color>
    <Color x:Key="Color.CaptionCloseHover">#FF5B2C32</Color>
    <Color x:Key="Color.CaptionClosePressed">#FF8E3440</Color>
    <Color x:Key="Color.ScrollTrack">#40071014</Color>
    <Color x:Key="Color.ScrollThumb">#FF4C6268</Color>
    <Color x:Key="Color.ScrollThumbHover">#FF58D6FF</Color>
    <Color x:Key="Color.ScrollThumbPressed">#FF1599C8</Color>
    <Color x:Key="Color.ScrollThumbDisabled">#70263842</Color>
    <Color x:Key="Color.ValidationErrorText">#FFFFDADA</Color>
    <Color x:Key="Color.ValidationWarningText">#FFFFE8B5</Color>
    <Color x:Key="Color.ReferenceBadge">#402E839E</Color>
    <Color x:Key="Color.Indeterminate">#8872E097</Color>

    <!--  Generate, progress, and composition surfaces.  -->
    <Color x:Key="Color.ProgressSurface">#FF0D1A20</Color>
    <Color x:Key="Color.ProgressPanel">#FF091318</Color>
    <Color x:Key="Color.ProgressTrack">#FF152B34</Color>
    <Color x:Key="Color.ProgressAccent">#4058D6FF</Color>
    <Color x:Key="Color.GenerateSetupSurface">#FF071014</Color>
    <Color x:Key="Color.GenerateSetupPanel">#FF0D1A20</Color>
    <Color x:Key="Color.GenerateSetupField">#FF091318</Color>
    <Color x:Key="Color.GenerateSetupButton">#FF10242C</Color>
    <Color x:Key="Color.GenerateSetupButtonHover">#FF16323C</Color>
    <Color x:Key="Color.GenerateSetupPrimaryButton">#FF58D6FF</Color>
    <Color x:Key="Color.GenerateModeSurface">#FF0D1A20</Color>
    <Color x:Key="Color.GenerateModeSurfaceHover">#FF16323C</Color>
    <Color x:Key="Color.GenerateModeSurfaceSelected">#FF1B3B46</Color>
    <Color x:Key="Color.CompositionSurface">#FF0D1A20</Color>
    <Color x:Key="Color.CompositionCanvas">#FF050B0E</Color>
    <Color x:Key="Color.CompositionFocus">#FF58D6FF</Color>
    <Color x:Key="Color.CompositionFocusSoft">#3358D6FF</Color>
    <Color x:Key="Color.CompositionWarning">#FFFFC85A</Color>
    <Color x:Key="Color.CompositionSuccess">#FF72E097</Color>
    <Color x:Key="Color.CompositionError">#FFFF8F8F</Color>
    <Color x:Key="Color.CompositionErrorSurface">#445B2C32</Color>
    <Color x:Key="Color.GenerateAudioWarning">#FFFFC85A</Color>
    <Color x:Key="Color.GenerateAudioWarningSurface">#26FFC85A</Color>
    <Color x:Key="Color.GenerateDropHighlight">#2458D6FF</Color>
    <Color x:Key="Color.GenerateSetupHighlight">#FF10242C</Color>
    <Color x:Key="Color.GenerateSetupSelected">#FF1B3B46</Color>
    <Color x:Key="Color.GenerateSetupPressed">#FF0A83AD</Color>
</ResourceDictionary>
