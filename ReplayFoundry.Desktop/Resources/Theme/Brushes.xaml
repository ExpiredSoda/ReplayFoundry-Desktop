    <!--  Flat dock system.  -->
    <SolidColorBrush x:Key="Brush.DockSurface" Color="{DynamicResource Color.DockSurfaceTop}" />
    <SolidColorBrush x:Key="Brush.DockActiveBorder" Color="{DynamicResource Color.BrandCyan}" />

    <!--
        Scalable blueprint grid used by every workspace. It replaces the old
        raster/violet backdrop and remains crisp on every DPI and window size.
    -->
    <DrawingBrush
        x:Key="Brush.WindowGrid"
        TileMode="Tile"
        Viewbox="0,0,80,80"
        ViewboxUnits="Absolute"
        Viewport="0,0,80,80"
        ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 L 80,0 M 0,0 L 0,80">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource Brush.WindowGridLine}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M 0,40 L 80,40 M 40,0 L 40,80">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{DynamicResource Brush.WindowGridMajor}" Thickness="0.65" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
