<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishDestinationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="YouTube connection">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="YOUTUBE" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}" Text="Connect directly in your browser. Replay Foundry never asks for your Google password." TextWrapping="Wrap" />
                </StackPanel>
                <controls:StatusBadge
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Text="{Binding ConnectionStatus}" />
            </Grid>

            <Border Margin="0,14,0,0" Style="{DynamicResource Control.CanvasFilterPane}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="28"
                        Height="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.PlatformYouTube}"
                        CornerRadius="5">
                        <Path
                            Width="9"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Data="M 1,0 L 9,5 L 1,10 Z"
                            Fill="{DynamicResource Brush.PlatformYouTubeGlyph}"
                            Stretch="Fill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="{Binding ConnectionTitle}" />
                        <TextBlock Margin="0,4,12,0" Style="{DynamicResource Text.Meta}" Text="{Binding ConnectionDetail}" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Command="{Binding ConnectCommand}" Content="Connect" Style="{DynamicResource Control.PrimaryButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding RefreshYouTubeCommand}" Content="Refresh" Style="{DynamicResource Control.GhostButton}" />
                        <Button Margin="8,0,0,0" Command="{Binding DisconnectCommand}" Content="Disconnect" Style="{DynamicResource Control.DestructiveButton}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <TextBlock
                Margin="0,12,0,0"
                Style="{DynamicResource Text.Meta}"
                TextWrapping="Wrap">
                <Run Text="YouTube connections must first be enabled under Settings → Privacy &amp; connections. " />
                <Run Text="Enabling permission sends nothing by itself. Google grants access only after Connect; " />
                <Run Text="the refresh credential stays in Windows Credential Manager, and Disconnect removes it from this PC." />
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
