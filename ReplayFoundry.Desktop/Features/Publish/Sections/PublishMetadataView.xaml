<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.Sections.PublishMetadataView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{DynamicResource Control.SectionCard}" AutomationProperties.Name="YouTube metadata">
        <StackPanel>
            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="TITLE &amp; DETAILS" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}" Text="Start with Studio's editorial draft, then make the final wording yours." TextWrapping="Wrap" />

            <Grid Margin="0,14,0,0">
                <TextBox AutomationProperties.Name="YouTube title" MaxLength="100" Style="{DynamicResource Control.FormTextBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource Text.Meta}" Text="{Binding TitleCharacterCount}" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Meta}" Text="A clear title that describes this specific video." />

            <Grid Margin="0,12,0,0">
                <TextBox
                    AutomationProperties.Name="YouTube description"
                    AcceptsReturn="True"
                    MaxLength="5000"
                    MinHeight="110"
                    Padding="10,10,10,28"
                    Style="{DynamicResource Control.FormTextBox}"
                    Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <TextBlock Margin="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{DynamicResource Text.Meta}" Text="{Binding DescriptionCharacterCount}" IsHitTestVisible="False" />
            </Grid>

            <Grid Margin="0,12,0,0">
                <TextBox AutomationProperties.Name="YouTube tags" MaxLength="500" Style="{DynamicResource Control.FormTextBox}" Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="8,0" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource Text.Meta}" Text="{Binding TagsCharacterCount}" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Meta}" Text="Comma-separated search tags. Hashtags can still be written in the title or description." TextWrapping="Wrap" />

            <Border Margin="0,12,0,0" Padding="10" Background="{DynamicResource Brush.SurfaceElevated}" CornerRadius="7">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Want a different take?" />
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="One click creates a new title and description structure from the same saved video context. It does not upload anything."
                        TextWrapping="Wrap" />

                    <Button
                        MinWidth="190"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Left"
                        AutomationProperties.HelpText="{Binding Editorial.AvailabilityText}"
                        AutomationProperties.Name="{Binding Editorial.RerollAutomationName}"
                        Command="{Binding Editorial.RerollCommand}"
                        Content="{Binding Editorial.RerollButtonText}"
                        Style="{DynamicResource Control.PrimaryButton}" />
                    <ProgressBar
                        Height="4"
                        Margin="0,9,0,0"
                        IsIndeterminate="True"
                        Visibility="{Binding Editorial.IsGenerating, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource Brush.StatusInfo}" FontSize="11" Text="{Binding Editorial.Status}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource Brush.StatusInfo}" FontSize="11" Text="{Binding PresentationValidationMessage}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
