<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Publish.PublishView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="clr-namespace:ReplayFoundry.Desktop.Features.Publish.Sections"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    Background="Transparent">
    <controls:WorkspaceScrollViewport CueText="More publishing activity below">
        <Grid MaxWidth="1600" Margin="20" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <sections:PublishDestinationsView />
            <AdornerDecorator Grid.Row="1" Margin="0,12,0,0">
                <Grid>
                    <Grid x:Name="WideLayout">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <sections:PublishLibraryBrowserView Margin="0,0,6,0" />
                        <sections:PublishCalendarView Grid.Column="1" Margin="6,0,0,0" />
                    </Grid>
                    <StackPanel x:Name="CompactLayout">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <sections:PublishLibraryBrowserView />
                        <sections:PublishCalendarView Margin="0,12,0,0" />
                    </StackPanel>
                </Grid>
            </AdornerDecorator>
            <sections:PublishQueueHistoryView Grid.Row="2" Margin="0,12,0,0" />
        </Grid>
    </controls:WorkspaceScrollViewport>
</UserControl>
