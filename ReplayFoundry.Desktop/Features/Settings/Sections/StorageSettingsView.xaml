<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.StorageSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
      <Border Style="{DynamicResource Control.CanvasPane}">
        <StackPanel>
            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="FILES &amp; STORAGE" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource Text.Body}"
                Text="Choose where new projects and finished Studio videos are saved."
                TextWrapping="Wrap" />
            <Border Margin="0,14,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.FormLabel}" Text="SAVE NEW VIDEOS HERE" />
                    <TextBox
                        Margin="0,8,0,0"
                        AutomationProperties.Name="Current output folder"
                        IsReadOnly="True"
                        Style="{DynamicResource Control.FormTextBox}"
                        Text="{Binding OutputRootDirectory, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding OutputRootModeText}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Choose output folder"
                            Command="{Binding ChooseOutputFolderCommand}"
                            Content="Choose folder"
                            Style="{DynamicResource Control.PrimaryButton}" />
                        <Button
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Use default output folder"
                            Command="{Binding UseDefaultOutputFolderCommand}"
                            Content="Restore default" />
                        <Button
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Open output folder"
                            Command="{Binding OpenOutputFolderCommand}"
                            Content="Open folder" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock
                Margin="0,12,0,0"
                Style="{DynamicResource Text.Body}"
                Text="This changes future projects only. Existing Library videos stay where they are. If you move one later, Library can reconnect it."
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,8,0,0"
                Style="{DynamicResource Text.Meta}"
                Text="{Binding StorageStatus}"
                TextWrapping="Wrap" />
            <Border
                Margin="0,12,0,0"
                Style="{DynamicResource Control.CanvasInsetCard}"
                Visibility="{Binding HasStorageNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Style="{DynamicResource Text.Body}"
                    Text="{Binding StorageNotice}"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
      </Border>

      <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasPane}">
        <StackPanel DataContext="{Binding LocalData}">
          <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="LOCAL DATA &amp; STORAGE CLEANUP" />
          <TextBlock
              Margin="0,8,0,0"
              Style="{DynamicResource Text.Body}"
              Text="Delete temporary files Replay Foundry can rebuild, or choose which saved app data to remove on the next start. Finished videos and installed AI tools/models are always kept."
              TextWrapping="Wrap" />

          <Border Margin="0,14,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="Temporary cache" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="Bounded Studio previews, downloaded installer copies, and game-lookup results. They are recreated when needed."
                    TextWrapping="Wrap" />
                <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource Brush.StatusInfo}" Style="{DynamicResource Text.Meta}" Text="{Binding CacheUsage}" />
              </StackPanel>
              <Button
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Clear Replay Foundry derived cache"
                  Command="{Binding ClearCacheCommand}"
                  Content="Delete temporary cache"
                  Style="{DynamicResource Control.DestructiveButton}" />
            </Grid>
          </Border>

          <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasInsetCard}">
            <StackPanel>
              <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="Reset saved app data" />
              <TextBlock
                  Margin="0,4,0,0"
                  Style="{DynamicResource Text.Meta}"
                  Text="Always removed on the next start: app preferences, remembered source choices, recent-project summaries, and local YouTube drafts and history."
                  TextWrapping="Wrap" />
              <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="SemiBold" Text="Include these additional records" />
              <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeDiagnostics}" Content="Diagnostic logs and saved bug reports" />
              <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeLibraryCatalog}" Content="Library catalog entries (finished video files remain on disk)" />
              <CheckBox Margin="0,8,0,0" IsChecked="{Binding IncludeStudioProjects}" Content="Saved Studio project files" />
              <TextBlock Margin="0,12,0,0" Style="{DynamicResource Text.Meta}" Text="Installed tools, AI models, and finished videos are not part of this reset." TextWrapping="Wrap" />
              <Button
                  Margin="0,14,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Schedule Replay Foundry local data reset"
                  Command="{Binding ScheduleResetCommand}"
                  Content="Review data reset"
                  Style="{DynamicResource Control.DestructiveButton}" />
            </StackPanel>
          </Border>

          <Border
              Margin="0,12,0,0"
              Style="{DynamicResource Control.CanvasInsetCard}"
              Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding Notice}" TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
</UserControl>
