<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Settings.SettingsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sections="clr-namespace:ReplayFoundry.Desktop.Features.Settings.Sections"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    Background="Transparent">
    <Grid
        MaxWidth="1500"
        Margin="20"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:UnavailableBanner
            Title="Your choices apply immediately"
            Description="{Binding PersistenceBannerText}" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid x:Name="StandardLayout">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" />
                    <ColumnDefinition Width="*" MinWidth="520" />
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource Control.CanvasPane}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="SETTINGS" />
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,5,0,18"
                            Style="{DynamicResource Text.Meta}"
                            Text="Only controls that work in this build are shown."
                            TextWrapping="Wrap" />
                        <ListBox
                            x:Name="StandardSectionList"
                            Grid.Row="2"
                            AutomationProperties.Name="Settings section selector"
                            ItemsSource="{Binding Sections}"
                            SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                            SelectionChanged="OnSectionSelectionChanged"
                            Style="{DynamicResource Control.SectionList}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}" />
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <controls:IconPath
                                            Width="16"
                                            Height="16"
                                            Margin="0,2,8,0"
                                            IconKey="{Binding Glyph}"
                                            Stroke="{DynamicResource Brush.StatusInfo}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock
                                                Margin="0,3,0,0"
                                                Style="{DynamicResource Text.Meta}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
                <controls:WorkspaceScrollViewport
                    x:Name="StandardSectionScrollViewport"
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    CueText="More settings below">
                    <sections:SettingsSectionHostView MinWidth="520" />
                </controls:WorkspaceScrollViewport>
            </Grid>

            <Grid x:Name="CompactLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ComboBox
                    x:Name="CompactSectionSelector"
                    AutomationProperties.Name="Settings section selector"
                    ItemsSource="{Binding Sections}"
                    SelectedItem="{Binding SelectedSectionItem, Mode=TwoWay}"
                    SelectionChanged="OnSectionSelectionChanged"
                    Style="{DynamicResource Control.FormComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <controls:WorkspaceScrollViewport
                    x:Name="CompactSectionScrollViewport"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    CueText="More settings below">
                    <sections:SettingsSectionHostView />
                </controls:WorkspaceScrollViewport>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
