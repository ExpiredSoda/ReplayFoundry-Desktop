<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Browser.StudioBrowserView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Studio clips and graphics browser">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="BROWSER" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="Choose a generated clip here. Inspector edits always apply to the highlighted clip."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListBox
                Grid.Row="1"
                Margin="0,12,0,10"
                AutomationProperties.Name="Studio browser sections"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding ToolSections}"
                SelectedValue="{Binding SelectedTool, Mode=TwoWay}"
                SelectedValuePath="Key"
                Style="{DynamicResource Control.SectionList}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.CanvasRailListBoxItem}">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <controls:IconPath
                                Width="14"
                                Height="14"
                                Margin="0,0,7,0"
                                IconKey="{Binding Glyph}"
                                Stroke="{DynamicResource Brush.StatusInfo}"
                                StrokeThickness="1.2"
                                Stretch="Uniform" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl Margin="0,0,7,20" ItemsSource="{Binding BrowserPreviewItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Control.KineticMediaCard}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource Brush.KineticGlowSoft}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusInfo}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.ColumnSpan="3"
                                        Padding="8,8"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Title}"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{Binding DataContext.SelectBrowserAssetCommand, ElementName=Root}"
                                        CommandParameter="{Binding AssetId}"
                                        Style="{DynamicResource Control.GhostButton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource Brush.SurfaceElevated}"
                                                BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <controls:IconPath
                                                    Width="12"
                                                    Height="12"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IconKey="{Binding Glyph}"
                                                    Stroke="{DynamicResource Brush.StatusInfo}"
                                                    StrokeThickness="1.2"
                                                    Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock
                                                    AutomationProperties.Name="Studio Browser clip name"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                                    LineHeight="15"
                                                    Text="{Binding Title}"
                                                    TextWrapping="Wrap" />
                                                <controls:StatusBadge
                                                    MaxWidth="180"
                                                    Margin="0,5,0,0"
                                                    Text="{Binding Status}" />
                                                <TextBlock
                                                    Margin="0,6,0,0"
                                                    AutomationProperties.Name="Studio Browser clip source and duration"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource Brush.TextMuted}"
                                                    Text="{Binding Detail}"
                                                    TextWrapping="Wrap"
                                                    ToolTip="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <TextBlock
                                        Grid.Row="1"
                                        Margin="46,0,4,9"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                <Setter Property="Text" Value="Kept · not queued" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsQueued}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusInfo}" />
                                                        <Setter Property="Text" Value="In render queue" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.StatusWarning}" />
                                                        <Setter Property="Text" Value="Excluded · edits saved" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        MinWidth="30"
                                        MinHeight="30"
                                        Padding="7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Add this clip to the render queue"
                                        AutomationProperties.HelpText="Queues this exact Browser clip using its latest saved Studio edits."
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{Binding DataContext.QueueBrowserAssetCommand, ElementName=Root}"
                                        CommandParameter="{Binding AssetId}"
                                        ToolTip="Add to render queue">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Control.IconButton}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Plus" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        MinWidth="30"
                                        MinHeight="30"
                                        Padding="7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Exclude clip from Studio render"
                                        AutomationProperties.HelpText="Removes this clip from the kept set and render queue without deleting its metadata."
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{Binding DataContext.RemoveBrowserAssetCommand, ElementName=Root}"
                                        CommandParameter="{Binding AssetId}"
                                        ToolTip="Exclude clip">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Control.IconButton}">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Trash" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" />
                                    </Button>
                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        MinWidth="30"
                                        MinHeight="30"
                                        Padding="7"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Restore clip to Studio render"
                                        AutomationProperties.HelpText="Returns this retained clip to the kept set. Use Add to render queue when ready."
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        Command="{Binding DataContext.RestoreBrowserAssetCommand, ElementName=Root}"
                                        CommandParameter="{Binding AssetId}"
                                        ToolTip="Keep clip again">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Control.IconButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AssetId}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <controls:IconPath Width="14" Height="14" IconKey="Icon.Plus" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.2" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
