<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.StudioView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="clr-namespace:ReplayFoundry.Desktop.Features.Studio.DesignTime"
    xmlns:browser="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Browser"
    xmlns:preview="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Preview"
    xmlns:inspector="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Inspector"
    xmlns:hidden="clr-namespace:ReplayFoundry.Desktop.Features.Studio.HiddenMoments"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:StudioDesignViewModel, IsDesignTimeCreatable=True}"
    Background="Transparent"
    mc:Ignorable="d">
    <Grid>
    <controls:WorkspaceScrollViewport CueText="More Studio tools below">
        <Grid Margin="20,20,20,84">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                MaxWidth="1600"
                Margin="0,0,0,12"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Studio project controls">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Control.CanvasInsetCard}">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="{DynamicResource Brush.SurfaceElevated}"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <controls:IconPath
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IconKey="Icon.Edit"
                            Stroke="{DynamicResource Brush.StatusInfo}"
                            StrokeThickness="1.2"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,18,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            Text="{Binding ProjectName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ProjectName}" />
                        <WrapPanel Margin="0,3,0,0" Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding Preview.SequenceSummary}" />
                            <TextBlock Margin="7,0" Style="{DynamicResource Text.Meta}" Text="·" />
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding Preview.PreviewFormatText}" />
                        </WrapPanel>
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        MinHeight="36"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Open Hidden Moments"
                        AutomationProperties.HelpText="Review safe alternate moments without changing Like or Dislike feedback."
                        Command="{Binding HiddenMoments.OpenCommand}"
                        Style="{DynamicResource Control.GhostButton}">
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <controls:IconPath
                                Width="15"
                                Height="15"
                                Margin="0,0,7,0"
                                IconKey="Icon.Heart"
                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                StrokeThickness="1.25" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding HiddenMoments.OpenButtonText}" />
                        </StackPanel>
                    </Button>
                    <Border
                        Grid.Column="3"
                        MinWidth="224"
                        Padding="12,0,0,0"
                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                        BorderThickness="1,0,0,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                MinWidth="188"
                                MinHeight="36"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                AutomationProperties.Name="Add selected Studio clip to the render queue"
                                AutomationProperties.HelpText="Adds only the kept clip currently selected in Browser. Rendering starts from the queue below."
                                Command="{Binding FinalRender.AddToQueueCommand}"
                                Style="{DynamicResource Control.PrimaryButton}"
                                ToolTip="Add the selected clip to the render queue">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <controls:IconPath
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        IconKey="Icon.Queue"
                                        Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        StrokeThickness="1.2"
                                        Stretch="Uniform" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{Binding FinalRender.ButtonText}"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                MinHeight="24"
                                Margin="0,4,0,0"
                                Padding="8,2"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="Review requirements for rendering to Library"
                                Command="{Binding ReviewRenderRequirementsCommand}"
                                Content="{Binding FinalRender.ReadinessText}"
                                Style="{DynamicResource Control.WorkspaceButton}"
                                ToolTip="Open the Inspector section that is preventing final rendering"
                                Visibility="{Binding FinalRender.NeedsRenderAttention, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="MinHeight" Value="420" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                <Setter Property="MinHeight" Value="350" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border
                    MaxWidth="1600"
                    MinHeight="350"
                    Padding="24"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Brush.SurfacePanel}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="7">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <controls:IssuePanel
                        Width="720"
                        MaxWidth="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Studio project status"
                        IconKey="Icon.Edit"
                        Reference="RF-STU-001"
                        StageOne="Generate a source"
                        StageTwo="Create a project"
                        StageThree="Shape the cut"
                        Summary="{Binding SurfaceSummary}"
                        Suggestion="{Binding SurfaceSuggestion}"
                        Details="Your project is safe. Return to Generate and finish preparing the source video, then open Studio again." />
                </Border>
                <Grid
                    x:Name="FullLayout"
                    Height="700"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="430" />
                    </Grid.ColumnDefinitions>
                    <browser:StudioBrowserView Grid.Column="0" Margin="0,0,12,0" />
                    <preview:StudioPreviewView Grid.Column="1" Margin="0,0,12,0" DataContext="{Binding Preview}" />
                    <inspector:StudioInspectorView
                        Grid.Column="2"
                        DataContext="{Binding Inspector}" />
                </Grid>

                <TabControl
                    x:Name="CompactLayout"
                    MaxWidth="1600"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Studio compact regions"
                    Background="Transparent"
                    BorderThickness="0">
                    <TabControl.Style>
                        <Style TargetType="TabControl">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompactLayout, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ShouldShowPlaceholder}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Style>
                    <TabItem Header="Browser">
                        <browser:StudioBrowserView />
                    </TabItem>
                    <TabItem Header="Preview">
                        <preview:StudioPreviewView DataContext="{Binding Preview}" />
                    </TabItem>
                    <TabItem Header="Inspector">
                        <inspector:StudioInspectorView
                            DataContext="{Binding Inspector}" />
                    </TabItem>
                </TabControl>

                <Border
                    Margin="12"
                    Padding="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Brush.SurfacePanel}"
                    BorderBrush="{DynamicResource Brush.StatusInfo}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{DynamicResource Text.Body}" Text="{Binding StatusText}" />
                </Border>
            </Grid>

            <Border
                x:Name="RenderQueuePanel"
                Grid.Row="2"
                MaxWidth="1600"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Studio render queue"
                DataContext="{Binding FinalRender}"
                Style="{DynamicResource Control.CanvasPane}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="32"
                            Height="32"
                            Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <controls:IconPath
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IconKey="Icon.Queue"
                                Stroke="{DynamicResource Brush.StatusInfo}"
                                StrokeThickness="1.2" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="RENDER QUEUE" />
                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding QueueSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <controls:StatusBadge
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{Binding QueuedClipCount, StringFormat={}{0} QUEUED}" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        Padding="14"
                        Style="{DynamicResource Control.CanvasGhostZone}"
                        Visibility="{Binding HasQueuedItems, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{DynamicResource Text.Meta}"
                            Text="Nothing is queued yet. Select a kept Browser clip, then use Add selected clip above."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        ItemsSource="{Binding QueueItems}"
                        Visibility="{Binding HasQueuedItems, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="10,8"
                                    Style="{DynamicResource Control.KineticMediaCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <controls:StatusBadge Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Text="{Binding Status}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="32"
                                            Height="32"
                                            MinWidth="32"
                                            MinHeight="32"
                                            Margin="0,0,4,0"
                                            Padding="7"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Render another copy of this clip"
                                            AutomationProperties.HelpText="Keeps the existing Library file and makes this queue item ready to render as a new copy."
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Command="{Binding DataContext.RerenderQueuedItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AssetId}"
                                            Style="{DynamicResource Control.IconButton}"
                                            ToolTip="Render another copy"
                                            Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}}">
                                            <controls:IconPath
                                                Width="14"
                                                Height="14"
                                                IconKey="Icon.History"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.2" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Width="32"
                                            Height="32"
                                            MinWidth="32"
                                            MinHeight="32"
                                            Padding="7"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Remove clip from render queue"
                                            AutomationProperties.HelpText="Removes this item from the pending queue without deleting the Studio clip or its metadata."
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            Command="{Binding DataContext.RemoveQueuedItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding AssetId}"
                                            Style="{DynamicResource Control.IconButton}"
                                            ToolTip="Remove from render queue">
                                            <controls:IconPath
                                                Width="14"
                                                Height="14"
                                                IconKey="Icon.Trash"
                                                Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                StrokeThickness="1.2" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ProgressBar
                        Grid.Row="2"
                        Height="4"
                        Margin="0,8,0,0"
                        Maximum="100"
                        Value="{Binding Percent, Mode=OneWay}"
                        Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}" />

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{DynamicResource Brush.StatusError}"
                                Style="{DynamicResource Text.Meta}"
                                Text="{Binding Error}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            MinHeight="36"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Cancel Studio render queue"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Style="{DynamicResource Control.GhostButton}"
                            Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibility}}" />
                        <Button
                            Grid.Column="2"
                            MinWidth="160"
                            MinHeight="36"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="Render queued clips to Library"
                            AutomationProperties.HelpText="Renders only the clips listed in this queue, in order, then adds the completed files to Library."
                            Command="{Binding RenderQueueCommand}"
                            Content="{Binding RenderQueueButtonText}"
                            Style="{DynamicResource Control.PrimaryButton}" />
                    </Grid>
                </Grid>
            </Border>

        </Grid>
    </controls:WorkspaceScrollViewport>
        <hidden:StudioHiddenMomentsView
            Panel.ZIndex="50"
            DataContext="{Binding HiddenMoments}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
