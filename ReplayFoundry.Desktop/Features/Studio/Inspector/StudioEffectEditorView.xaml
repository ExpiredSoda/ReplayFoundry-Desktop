<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioEffectEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Margin="0,12,0,8"
        AutomationProperties.Name="Video effect editor"
        Style="{DynamicResource Control.CanvasInsetCard}"
        Visibility="{Binding IsVideoEffectEditorVisible, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Color treatment" />
            <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="Choose a look for this clip. Your saved treatment appears here and in the final Library video." TextWrapping="Wrap" />
            <ComboBox
                AutomationProperties.Name="Studio video effect"
                DisplayMemberPath="Name"
                IsEnabled="{Binding IsProjectDraft}"
                ItemsSource="{Binding Clip.VideoEffectOptions}"
                SelectedItem="{Binding Clip.SelectedVideoEffect, Mode=TwoWay}" />
            <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Clip.SelectedVideoEffectDescription}" TextWrapping="Wrap" />
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="Intensity" />
                <TextBlock Grid.Column="1" FontFamily="Consolas" Foreground="{DynamicResource Brush.StatusInfo}" Text="{Binding Clip.VideoEffectIntensityText}" />
            </Grid>
            <Slider
                AutomationProperties.Name="Studio video effect intensity"
                IsEnabled="{Binding IsProjectDraft}"
                IsSnapToTickEnabled="True"
                LargeChange="10"
                Maximum="100"
                Minimum="0"
                SmallChange="1"
                TickFrequency="1"
                Value="{Binding Clip.VideoEffectIntensityPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Save video effect"
                Command="{Binding Clip.ApplyBoundaryEditCommand}"
                Content="Save effect"
                Style="{DynamicResource Control.PrimaryButton}" />
            <Border Margin="0,14,0,0" Padding="10" Style="{DynamicResource Control.CanvasGhostZone}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Transition" />
                    <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}" Text="Clean cut. Montage segments currently join without a fabricated transition or duplicate render pass." TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
