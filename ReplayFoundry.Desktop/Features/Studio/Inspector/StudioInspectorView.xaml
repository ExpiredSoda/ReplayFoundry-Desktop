<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Studio.Inspector.StudioInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:editors="clr-namespace:ReplayFoundry.Desktop.Features.Studio.Inspector">
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Studio inspector">
        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="INSPECTOR" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Choose a section to edit the selected clip."
                        TextWrapping="Wrap" />
                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    AutomationProperties.Name="Studio inspector sections"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding InspectorSections}"
                    ScrollViewer.CanContentScroll="False"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedValue="{Binding SelectedInspector, Mode=TwoWay}"
                    SelectedValuePath="Key"
                    Style="{DynamicResource Control.SectionList}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource Control.StudioNavigationItem}">
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:IconPath
                                    Grid.RowSpan="2"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    IconKey="{Binding Glyph}"
                                    Stretch="Uniform"
                                    Stroke="{DynamicResource Brush.StatusInfo}"
                                    StrokeThickness="1.2" />
                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Description}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="2,5,2,0"
                    Style="{DynamicResource Text.Meta}"
                    Text="{Binding SelectedInspectorDescription}"
                    TextWrapping="Wrap" />

                <editors:StudioClipEditorView Grid.Row="3" />
                <Border
                    Grid.Row="4"
                    Margin="0,12,0,8"
                    Padding="12"
                    Background="{DynamicResource Brush.SurfaceInset}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsAudioEditorVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Source audio" />
                        <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="{Binding AudioMixSummary}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AudioStreams}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7" Padding="9" Background="{DynamicResource Brush.SurfaceElevated}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="7">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding StreamLabel}" />
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Format}" />
                                            <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding MetadataHint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Margin="0,4,0,0" Padding="9" Background="{DynamicResource Brush.InteractiveSelected}" CornerRadius="7">
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="{Binding CaptionAudioSummary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
                <editors:StudioCaptionEditorView Grid.Row="5" />
                <editors:StudioEffectEditorView Grid.Row="6" />
                <Border
                    Grid.Row="7"
                    Margin="0,12,0,8"
                    Style="{DynamicResource Control.CanvasInsetCard}"
                    Visibility="{Binding IsGraphicsEditorVisible, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel DataContext="{Binding Graphics}">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Graphics overlay" />
                        <TextBlock Margin="0,4,0,8" Style="{DynamicResource Text.Meta}" Text="Drag a PNG, JPG, or WebP from Windows onto the preview. Graphics are stored as nondestructive clip edits." TextWrapping="Wrap" />
                        <ComboBox
                            AutomationProperties.Name="Graphic on selected clip"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding Overlays}"
                            SelectedItem="{Binding SelectedOverlay, Mode=TwoWay}"
                            Visibility="{Binding HasOverlays, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{DynamicResource Text.Meta}" Text="Horizontal center" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding CenterXPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Meta}" Text="Vertical center" />
                            <Slider Minimum="0" Maximum="100" Value="{Binding CenterYPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Meta}" Text="Width" />
                            <Slider Minimum="5" Maximum="100" Value="{Binding WidthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="0,5,0,0" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding PlacementText}" />
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <Button Command="{Binding ApplyPlacementCommand}" Content="Apply placement" Style="{DynamicResource Control.PrimaryButton}" />
                                <Button Margin="8,0,0,0" Command="{Binding RemoveGraphicCommand}" Content="Remove graphic" Style="{DynamicResource Control.GhostButton}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Margin="0,9,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding Status}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource Brush.StatusError}"
                            Style="{DynamicResource Text.Meta}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
                <editors:StudioMetadataEditorView Grid.Row="8" />
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
