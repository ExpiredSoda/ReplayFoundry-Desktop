<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.GameContext.GameContextStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock
                Foreground="{DynamicResource Brush.TextPrimary}"
                FontSize="26"
                FontWeight="SemiBold"
                Text="Game Context" />
            <TextBlock
                Margin="0,7,0,20"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="14"
                Text="Confirm the game for each source. Replay Foundry uses this local context for grounded titles, descriptions, and tags."
                TextWrapping="Wrap" />
            <ListBox
                AutomationProperties.Name="Sources requiring game context"
                ItemsSource="{Binding Sources}"
                SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                Style="{DynamicResource GenerationSetup.OptionList}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontWeight="SemiBold"
                                Text="{Binding SourceName}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="11"
                                Text="{Binding GameName}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <Border
            Grid.Column="2"
            Style="{DynamicResource GenerationSetup.SectionCard}">
            <StackPanel>
                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedSource.SourceName}" />
                <TextBlock
                    Margin="0,4,0,20"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="{Binding SelectedSource.OriginText}" />

                <TextBlock
                    Style="{DynamicResource GenerationSetup.FieldLabel}"
                    Text="Game name" />
                <TextBox
                    AutomationProperties.Name="Confirmed game name"
                    MaxLength="120"
                    Style="{DynamicResource Control.FormTextBox}"
                    Text="{Binding SelectedSource.GameName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Margin="0,18,0,0"
                    Style="{DynamicResource GenerationSetup.FieldLabel}"
                    Text="Optional grounding notes" />
                <TextBlock
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="Add a character, mission, mode, or naming convention only when you know it. The model may not invent facts beyond these notes and retained clip evidence."
                    TextWrapping="Wrap" />
                <TextBox
                    AutomationProperties.Name="Game context notes"
                    AcceptsReturn="True"
                    Height="110"
                    MaxLength="1500"
                    Style="{DynamicResource Control.FormTextBox}"
                    Text="{Binding SelectedSource.ContextNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

                <CheckBox
                    Margin="0,16,0,0"
                    AutomationProperties.Name="Use open game knowledge"
                    Content="Use open game knowledge for story-aware metadata"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontWeight="SemiBold"
                    IsChecked="{Binding SelectedSource.UseOpenGameKnowledge, Mode=TwoWay}" />
                <TextBlock
                    Margin="24,5,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="12"
                    Text="Opt-in. Replay Foundry sends only the confirmed game name to Wikimedia, then keeps the licensed snapshot locally. Your recording, path, transcript, notes, and clip evidence never leave this computer."
                    TextWrapping="Wrap" />

                <Border
                    Margin="0,20,0,0"
                    Padding="12"
                    Background="{DynamicResource Brush.GenerateDropHighlight}"
                    CornerRadius="10">
                    <TextBlock
                        Foreground="{DynamicResource Brush.TextSecondary}"
                        FontSize="12"
                        Text="The confirmed value and this preference are remembered locally for the game folder. Retrieved passages retain their source revision, license, attribution, and integrity hash."
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
