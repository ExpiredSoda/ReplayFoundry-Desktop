<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.MomentGuidance.MomentGuidanceStepView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:composition="clr-namespace:ReplayFoundry.Desktop.Features.Generate.CompositionReview"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Generate.GenerationSetup.Steps.MomentGuidance">
    <UserControl.Resources>
        <composition:PreviewFrameImageConverter x:Key="PreviewFrameImageConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Priority moments" />
            <TextBlock
                Margin="0,7,0,18"
                FontSize="14"
                Foreground="{DynamicResource Brush.TextSecondary}"
                Text="Optionally mark exact moments or rough regions that Replay Foundry should inspect before automatic peaks."
                TextWrapping="Wrap" />

            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="SOURCE" />
            <ComboBox Margin="0,6,0,16" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName" />

            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Text="TIMELINE POSITION" />
            <Grid Height="28" Margin="0,8,0,0">
                <Slider
                    x:Name="TimelineSlider"
                    Panel.ZIndex="1"
                    AutomationProperties.HelpText="Scrub the selected source. Priority ticks and ranges are drawn directly on this timeline."
                    AutomationProperties.Name="Priority moment timeline position"
                    Minimum="0"
                    Maximum="{Binding SelectedSource.PreviewMaximumSeconds}"
                    Value="{Binding SelectedSource.CurrentPositionSeconds, Mode=TwoWay}"
                    TickFrequency="1"
                    IsSnapToTickEnabled="False"
                    PreviewMouseLeftButtonDown="TimelineSlider_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="TimelineSlider_MouseLeftButtonUp"
                    LostMouseCapture="TimelineSlider_LostMouseCapture" />
                <local:MomentGuidanceTimelineOverlay
                    x:Name="TimelineGuidanceOverlay"
                    Height="14"
                    Margin="8,0,8,0"
                    Panel.ZIndex="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Priority tick and range markers"
                    DurationSeconds="{Binding SelectedSource.MaximumSeconds}"
                    IsHitTestVisible="False"
                    Items="{Binding SelectedSource.Items}"
                    PointBrush="{DynamicResource Brush.StatusInfo}"
                    RangeBrush="{DynamicResource Brush.StatusWarning}" />
            </Grid>
            <Grid Margin="0,5,0,14">
                <TextBlock FontFamily="Consolas" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding SelectedSource.CurrentPositionText}" />
                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedSource.DurationText}" />
            </Grid>

            <Button HorizontalAlignment="Left" Command="{Binding SelectedSource.AddPointCommand}" Content="Add priority tick" Style="{DynamicResource GenerationSetup.SecondaryButton}" />

            <Border Margin="0,18,0,0" Padding="14" Background="{DynamicResource Brush.SurfaceInset}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Priority range" />
                    <TextBlock Margin="0,5,0,12" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Move the timeline position, capture the start and end, then add the range." TextWrapping="Wrap" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding SelectedSource.CaptureRangeStartCommand}" Content="Set start here" Style="{DynamicResource GenerationSetup.SecondaryButton}" />
                        <Button Grid.Column="2" Command="{Binding SelectedSource.CaptureRangeEndCommand}" Content="Set end here" Style="{DynamicResource GenerationSetup.SecondaryButton}" />
                    </Grid>
                    <TextBlock Margin="0,10,0,0" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding SelectedSource.RangeStartText, StringFormat=Start: {0}}" />
                    <TextBlock Margin="0,3,0,0" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding SelectedSource.RangeEndText, StringFormat=End: {0}}" />
                    <TextBlock Margin="0,3,0,0" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedSource.RangeDurationText, StringFormat=Duration: {0}}" />
                    <TextBlock Margin="0,9,0,10" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding SelectedSource.RangeBehaviorText}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Command="{Binding SelectedSource.AddRangeCommand}" Content="Add priority range" Style="{DynamicResource GenerationSetup.PrimaryButton}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="2" Style="{DynamicResource GenerationSetup.SectionCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="Watch and mark" />
                <Border
                    Grid.Row="1"
                    Margin="0,10,0,12"
                    Background="{DynamicResource Brush.PreviewCanvasDark}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ClipToBounds="True">
                    <Grid>
                        <Viewbox Stretch="Uniform">
                            <Grid Width="640" Height="360">
                                <Image
                                    Stretch="Uniform"
                                    Source="{Binding SelectedSource.Preview.Frame, Converter={StaticResource PreviewFrameImageConverter}}" />
                                <MediaElement
                                    x:Name="PriorityPlayer"
                                    LoadedBehavior="Manual"
                                    UnloadedBehavior="Manual"
                                    ScrubbingEnabled="True"
                                    Stretch="Uniform"
                                    MediaOpened="PriorityPlayer_MediaOpened"
                                    MediaEnded="PriorityPlayer_MediaEnded"
                                    MediaFailed="PriorityPlayer_MediaFailed" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Move the scrubber to inspect this moment.">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedSource.IsPlaybackOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Border>
                <Grid Grid.Row="2" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Width="36"
                            Height="32"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="Rewind priority preview five seconds"
                            Click="Rewind_Click"
                            Style="{DynamicResource GenerationSetup.SecondaryButton}"
                            ToolTip="Rewind 5 seconds">
                            <controls:IconPath Width="15" Height="15" IconKey="Icon.Rewind" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                        </Button>
                        <Button
                            Width="40"
                            Height="32"
                            MinWidth="0"
                            MinHeight="0"
                            Margin="6,0"
                            Padding="0"
                            AutomationProperties.Name="Play or pause priority preview"
                            Click="PlayPause_Click"
                            Style="{DynamicResource GenerationSetup.PrimaryButton}"
                            ToolTip="Play or pause">
                            <controls:IconPath Width="15" Height="15" IconKey="{Binding SelectedSource.PlayPauseIconKey}" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                        </Button>
                        <Button
                            Width="36"
                            Height="32"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="0"
                            AutomationProperties.Name="Advance priority preview five seconds"
                            Click="Forward_Click"
                            Style="{DynamicResource GenerationSetup.SecondaryButton}"
                            ToolTip="Forward 5 seconds">
                            <controls:IconPath Width="15" Height="15" IconKey="Icon.FastForward" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" StrokeThickness="1.3" />
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding SelectedSource.PlaybackStatus}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectedSource.PlaybackStatus}" />
                </Grid>
                <StackPanel Grid.Row="3">
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    Text="Ticks receive first consideration. Ranges under three minutes reserve one safe candidate search; longer ranges receive priority."
                    TextWrapping="Wrap" />
                <TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Summary}" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding SelectedSource.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource Brush.SurfaceInset}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding Kind}" />
                                        <TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Text="{Binding Timing}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding RemoveCommand}" Content="Remove" Style="{DynamicResource GenerationSetup.SecondaryButton}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
