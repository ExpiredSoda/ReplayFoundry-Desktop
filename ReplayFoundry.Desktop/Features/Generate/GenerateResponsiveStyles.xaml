<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Generate">

    <!--
        This dictionary directly imports the base Generate resources because
        several responsive styles inherit from styles defined there.
    -->
    <ResourceDictionary.MergedDictionaries>

        <ResourceDictionary Source="GenerateStyles.xaml" />

    </ResourceDictionary.MergedDictionaries>

    <!--  The complete Generate content group.  -->
    <Style x:Key="Generate.ResponsiveContentGroup" TargetType="{x:Type Grid}">

        <Setter Property="MaxWidth" Value="1280" />

        <Setter Property="Margin" Value="20,18" />

        <Setter Property="HorizontalAlignment" Value="Stretch" />

        <Setter Property="VerticalAlignment" Value="Center" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="20,8" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Space between the mode selector and source panel.  -->
    <Style x:Key="Generate.ResponsiveModeGap" TargetType="{x:Type Border}">

        <Setter Property="Height" Value="18" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Height" Value="10" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Outer source-selection panel.  -->
    <Style x:Key="Generate.ResponsiveSourcePanel" TargetType="{x:Type Border}">

        <Setter Property="Padding" Value="30" />

        <Setter Property="Background" Value="{DynamicResource Brush.SurfacePanel}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="10" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Padding" Value="18" />

                <Setter Property="CornerRadius" Value="8" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Generate workspace heading.  -->
    <Style x:Key="Generate.ResponsiveHeaderTitle" TargetType="{x:Type TextBlock}">

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="28" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="FontSize" Value="22" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Generate workspace subtitle.  -->
    <Style x:Key="Generate.ResponsiveHeaderSubtitle" TargetType="{x:Type TextBlock}">

        <Setter Property="Margin" Value="0,8,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="15" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />

        <Setter Property="TextAlignment" Value="Center" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Visibility" Value="Collapsed" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Space between the title area and the file drop area.  -->
    <Style x:Key="Generate.ResponsiveHeaderGap" TargetType="{x:Type Border}">

        <Setter Property="Height" Value="20" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Height" Value="10" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Inner file-selection and drop area.  -->
    <Style x:Key="Generate.ResponsiveDropZone" TargetType="{x:Type Border}">

        <Setter Property="MinHeight" Value="260" />

        <Setter Property="Padding" Value="24" />

        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="8" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="MinHeight" Value="185" />

                <Setter Property="Padding" Value="14" />

                <Setter Property="CornerRadius" Value="6" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Single File and Multiple Files buttons.  -->
    <Style
        x:Key="Generate.ResponsiveActionButton"
        BasedOn="{StaticResource Generate.ActionButton}"
        TargetType="{x:Type Button}">

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Width" Value="220" />

                <Setter Property="Height" Value="58" />

                <Setter Property="Margin" Value="6" />

                <Setter Property="Padding" Value="14,8" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Main text inside a file-selection button.  -->
    <Style x:Key="Generate.ResponsiveActionTitle" TargetType="{x:Type TextBlock}">

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="18" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="FontSize" Value="16" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Secondary text inside a file-selection button.  -->
    <Style x:Key="Generate.ResponsiveActionDescription" TargetType="{x:Type TextBlock}">

        <Setter Property="Margin" Value="0,5,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="12" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Visibility" Value="Collapsed" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  The OR separator.  -->
    <Style x:Key="Generate.ResponsiveOrText" TargetType="{x:Type TextBlock}">

        <Setter Property="Margin" Value="0,16,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="13" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="0,7,0,0" />

                <Setter Property="FontSize" Value="11" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Main drag-and-drop instruction.  -->
    <Style x:Key="Generate.ResponsiveDropInstruction" TargetType="{x:Type TextBlock}">

        <Setter Property="Margin" Value="0,12,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="16" />

        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="0,7,0,0" />

                <Setter Property="FontSize" Value="14" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Supported file formats.  -->
    <Style x:Key="Generate.ResponsiveFormatsText" TargetType="{x:Type TextBlock}">

        <Setter Property="Margin" Value="0,7,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Setter Property="FontSize" Value="12" />

        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="0,4,0,0" />

                <Setter Property="FontSize" Value="10" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Internal scrolling for selected files only.  -->
    <Style x:Key="Generate.ResponsiveSelectedList" TargetType="{x:Type ScrollViewer}">

        <Setter Property="MaxHeight" Value="180" />

        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />

        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="MaxHeight" Value="95" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Footer below the selected-file list.  -->
    <Style x:Key="Generate.ResponsiveSelectedFooter" TargetType="{x:Type StackPanel}">

        <Setter Property="Margin" Value="0,12,0,0" />

        <Setter Property="HorizontalAlignment" Value="Center" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="0,7,0,0" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

    <!--  Validation feedback panel.  -->
    <Style x:Key="Generate.ResponsiveValidationPanel" TargetType="{x:Type Border}">

        <Setter Property="Margin" Value="0,16,0,0" />

        <Setter Property="Padding" Value="12,9" />

        <Setter Property="Background" Value="{DynamicResource Brush.StatusError}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.StatusError}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="5" />

        <Setter Property="Visibility" Value="Visible" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HasValidationMessage}" Value="False">

                <Setter Property="Visibility" Value="Collapsed" />

            </DataTrigger>

            <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">

                <Setter Property="Margin" Value="0,8,0,0" />

                <Setter Property="Padding" Value="9,6" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>
