<Window
    x:Class="ReplayFoundry.Desktop.Features.Generate.CompositionReview.CompositionReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Generate.CompositionReview"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Video Layout Review"
    Width="1600"
    Height="900"
    MinWidth="1060"
    MinHeight="650"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">

    <Window.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary
                    Source="/ReplayFoundry.Desktop;component/Features/Generate/GenerationSetup/GenerationSetupStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="CompositionReview.Panel"
                TargetType="{x:Type Border}">

                <Setter Property="Padding" Value="16" />
                <Setter Property="Background" Value="{DynamicResource Brush.CompositionSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />

            </Style>

            <Style
                x:Key="CompositionReview.SmallButton"
                BasedOn="{StaticResource GenerationSetup.SecondaryButton}"
                TargetType="{x:Type Button}">

                <Setter Property="Height" Value="36" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />

            </Style>

            <Style
                x:Key="CompositionReview.IconButton"
                TargetType="{x:Type Button}">

                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="IconSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Brush.InteractiveHover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="IconSurface" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="IconSurface" Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.42" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

            </Style>

        </ResourceDictionary>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar
            Grid.Row="0"
            Subtitle="Video Layout Review"
            Status="{Binding ConfirmationSummary}" />

        <Border
            Grid.Row="1"
            Background="{DynamicResource Brush.WindowFallback}"
            CornerRadius="0,0,14,14">
        <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Video Layout Review" />

                <TextBlock
                    MaxWidth="900"
                    Margin="0,7,0,0"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="13"
                    Text="Replay Foundry needs to know which part is gameplay and where the presenter camera, chat, or overlays appear. Review each source and confirm its regions."
                    TextWrapping="Wrap" />

            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Margin="24,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <TextBlock
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextPrimary}"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="{Binding ConfirmationSummary}" />

                <TextBlock
                    Margin="0,3,0,0"
                    HorizontalAlignment="Right"
                    Foreground="{DynamicResource Brush.TextSecondary}"
                    FontSize="11"
                    Text="Every source must be confirmed before continuing." />

            </StackPanel>

        </Grid>

        <Grid
            Grid.Row="1"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Style="{StaticResource CompositionReview.Panel}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Selected sources" />

                    <ListBox
                        Grid.Row="1"
                        MaxHeight="190"
                        Margin="0,12,0,0"
                        AutomationProperties.Name="Sources to review"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding Sources}"
                        SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,0,0,7"
                                    Padding="10"
                                    AutomationProperties.Name="{Binding FileName}"
                                    Background="{DynamicResource Brush.GenerateSetupHighlight}"
                                    CornerRadius="9">

                                    <StackPanel>

                                        <TextBlock
                                            Foreground="{DynamicResource Brush.TextPrimary}"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{Binding FileName}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding FullPath}" />

                                        <StackPanel
                                            Margin="0,5,0,0"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Foreground="{DynamicResource Brush.CompositionWarning}"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Text="{Binding ReferenceLabel}" />

                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                FontSize="10"
                                                Text="{Binding DurationText}" />

                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Text="{Binding PreviewStatusText}">

                                            <TextBlock.Style>

                                                <Style TargetType="{x:Type TextBlock}">

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{DynamicResource Brush.GenerateAudioWarning}" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding IsConfirmed}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{DynamicResource Brush.CompositionSuccess}" />

                                                        </DataTrigger>

                                                        <DataTrigger
                                                            Binding="{Binding HasPreviewError}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Foreground"
                                                                Value="{DynamicResource Brush.CompositionError}" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <TextBlock
                        Grid.Row="2"
                        Margin="0,14,0,8"
                        Foreground="{DynamicResource Brush.TextPrimary}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Regions in this source" />

                    <ListBox
                        Grid.Row="3"
                        AutomationProperties.Name="Regions in current source"
                        ItemsSource="{Binding SelectedSource.Regions}"
                        SelectedItem="{Binding SelectedSource.SelectedRegion, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="{Binding AutomationName, StringFormat=Remove {0}}"
                                        Command="{Binding RemoveCommand}"
                                        Style="{StaticResource CompositionReview.IconButton}"
                                        ToolTip="Remove region">
                                        <controls:IconPath
                                            Width="13"
                                            Height="13"
                                            IconKey="Icon.Trash"
                                            Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            StrokeThickness="1.2" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>

            </Border>

            <Border
                Grid.Column="2"
                Style="{StaticResource CompositionReview.Panel}">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock
                                Foreground="{DynamicResource Brush.TextPrimary}"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="{Binding SelectedSource.FileName}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding SelectedSource.FullPath}" />

                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{DynamicResource Brush.TextSecondary}"
                                FontSize="11"
                                Text="{Binding SelectedSource.PreviewStatusText}" />

                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="Load representative frame"
                            Command="{Binding RefreshPreviewCommand}"
                            Content="Load Frame"
                            Style="{StaticResource GenerationSetup.SecondaryButton}" />

                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Margin="0,12,0,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="11"
                            Text="Preview time" />

                        <Slider
                            Grid.Column="1"
                            Margin="12,0"
                            AutomationProperties.Name="Representative preview timestamp"
                            Maximum="{Binding SelectedSource.MaximumPreviewTimestampSeconds}"
                            Minimum="0"
                            SmallChange="1"
                            Value="{Binding SelectedSource.RequestedTimestampSeconds, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Column="2"
                            MinWidth="54"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="11"
                            Text="{Binding SelectedSource.RequestedTimestampText}" />

                    </Grid>

                    <local:CompositionRegionEditor
                        Grid.Row="2"
                        AutomationProperties.Name="Composition region editor"
                        DataContext="{Binding SelectedSource}"
                        Focusable="True" />

                    <Border
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource Brush.CompositionErrorSurface}"
                        CornerRadius="8">

                        <Border.Style>

                            <Style TargetType="{x:Type Border}">

                                <Setter
                                    Property="Visibility"
                                    Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger
                                        Binding="{Binding SelectedSource.HasPreviewError}"
                                        Value="True">

                                        <Setter
                                            Property="Visibility"
                                            Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <TextBlock
                            Foreground="{DynamicResource Brush.ValidationErrorText}"
                            FontSize="11"
                            Text="{Binding SelectedSource.PreviewError}"
                            TextWrapping="Wrap" />

                    </Border>

                </Grid>

            </Border>

            <Border
                Grid.Column="4"
                Style="{StaticResource CompositionReview.Panel}">

                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    CanContentScroll="False"
                    PanningMode="VerticalOnly">

                    <StackPanel>

                        <Grid>

                            <Grid.Style>

                                <Style TargetType="{x:Type Grid}">

                                    <Setter
                                        Property="IsEnabled"
                                        Value="True" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding SelectedSource.HasSelectedRegion}"
                                            Value="False">

                                            <Setter
                                                Property="IsEnabled"
                                                Value="False" />

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Grid.Style>

                            <StackPanel>

                                <TextBlock
                                    Foreground="{DynamicResource Brush.TextPrimary}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Selected region" />

                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    FontSize="11"
                                    Text="Change the type of an existing box. Its internal analysis traits follow the selected type automatically."
                                    TextWrapping="Wrap" />

                                <ComboBox
                                    Margin="0,9,0,10"
                                    AutomationProperties.Name="Selected region role"
                                    ItemsSource="{Binding AvailableRoles}"
                                    SelectedItem="{Binding SelectedSource.SelectedRegion.Role, Mode=TwoWay}" />

                                <TextBlock
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    FontSize="10"
                                    Text="Arrow keys move the focused region. Shift+Arrow resizes it. Delete removes it."
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </Grid>

                        <Separator Margin="0,10" />

                        <TextBlock
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Add a region" />

                        <TextBlock
                            Margin="0,4,0,7"
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="10"
                            Text="Choose a starting box, then drag and resize it directly on the preview."
                            TextWrapping="Wrap" />

                        <Button
                            Margin="0,0,0,6"
                            AutomationProperties.Name="Full Frame Gameplay"
                            Command="{Binding FullFrameGameplayCommand}"
                            Content="Full Frame Gameplay"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Gameplay Area"
                            Command="{Binding AddGameplayCommand}"
                            Content="Add Gameplay Area"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Presenter Area"
                            Command="{Binding AddPresenterCommand}"
                            Content="Add Presenter Area"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Chat or Text Area"
                            Command="{Binding AddChatOrTextCommand}"
                            Content="Add Chat/Text Area"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            AutomationProperties.Name="Add Overlay Area"
                            Command="{Binding AddOverlayCommand}"
                            Content="Add Overlay Area"
                            Style="{StaticResource CompositionReview.SmallButton}" />

                        <Button
                            Margin="0,6,0,0"
                            AutomationProperties.Name="Confirm This Source"
                            Command="{Binding ConfirmCurrentSourceCommand}"
                            Content="Confirm This Source"
                            Style="{StaticResource GenerationSetup.PrimaryButton}" />

                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource Brush.CompositionError}"
                            FontSize="10"
                            Text="{Binding SelectedSource.ValidationError}"
                            TextWrapping="Wrap" />

                        <Separator Margin="0,10" />

                        <TextBlock
                            Foreground="{DynamicResource Brush.TextSecondary}"
                            FontSize="10"
                            Text="Use this only when the selected videos share the same layout. This is an explicit copy, not automatic compatibility detection."
                            TextWrapping="Wrap" />

                        <Button
                            Margin="0,9,0,0"
                            AutomationProperties.Name="Apply current layout to all sources"
                            Command="{Binding ApplyCurrentLayoutCommand}"
                            Content="Apply to All"
                            Style="{StaticResource GenerationSetup.SecondaryButton}" />

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

        <Grid
            Grid.Row="2"
            Margin="0,18,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                AutomationProperties.Name="Cancel Video Layout Review"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Style="{StaticResource GenerationSetup.SecondaryButton}" />

            <TextBlock
                Grid.Column="1"
                Margin="18,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource Brush.TextSecondary}"
                FontSize="11"
                Text="Overlapping regions are allowed. At least one Gameplay region is required for every source."
                TextAlignment="Center"
                TextWrapping="Wrap" />

            <Button
                Grid.Column="2"
                AutomationProperties.Name="Continue to Generation"
                Command="{Binding ContinueCommand}"
                Content="Continue to Generation"
                Style="{StaticResource GenerationSetup.PrimaryButton}" />

        </Grid>

        </Grid>
        </Border>
    </Grid>

</Window>
