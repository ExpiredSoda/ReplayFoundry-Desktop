<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style
        x:Key="Generate.ActionButton"
        BasedOn="{StaticResource Control.ThemedButton}"
        TargetType="{x:Type Button}">

        <Setter Property="Width" Value="250" />
        <Setter Property="Height" Value="78" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DockBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border
                        x:Name="Surface"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="7">

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsMouseOver" Value="True">

                            <Setter TargetName="Surface" Property="Opacity" Value="0.88" />

                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">

                            <Setter TargetName="Surface" Property="Opacity" Value="0.72" />

                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">

                            <Setter Property="Opacity" Value="0.45" />

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>

    </Style>

    <Style
        x:Key="Generate.PrimaryButton"
        BasedOn="{StaticResource Generate.ActionButton}"
        TargetType="{x:Type Button}">

        <Setter Property="Width" Value="230" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.BrandCyan}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DockActiveBorder}" />

    </Style>

    <Style
        x:Key="Generate.SecondaryButton"
        BasedOn="{StaticResource Generate.ActionButton}"
        TargetType="{x:Type Button}">

        <Setter Property="Width" Value="170" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Margin" Value="0" />

    </Style>

    <Style x:Key="Generate.FileRow" TargetType="{x:Type Border}">

        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceInset}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="6" />

        <Setter Property="Padding" Value="14,10" />

        <Setter Property="Margin" Value="0,0,0,8" />

    </Style>

    <Style x:Key="Generate.SetupSummary" TargetType="{x:Type Border}">

        <Setter Property="Margin" Value="0,12,0,0" />

        <Setter Property="Padding" Value="12,9" />

        <Setter Property="Background" Value="{DynamicResource Brush.InteractiveSelected}" />

        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />

        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="CornerRadius" Value="5" />

        <Setter Property="Visibility" Value="Visible" />

        <Style.Triggers>

            <DataTrigger Binding="{Binding HasGenerationSetup}" Value="False">

                <Setter Property="Visibility" Value="Collapsed" />

            </DataTrigger>

        </Style.Triggers>

    </Style>

</ResourceDictionary>
