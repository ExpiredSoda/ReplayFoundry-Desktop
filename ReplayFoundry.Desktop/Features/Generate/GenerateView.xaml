<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.GenerateView"
    x:Name="GenerateViewRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:progress="clr-namespace:ReplayFoundry.Desktop.Features.Generate.Progress"
    xmlns:local="clr-namespace:ReplayFoundry.Desktop.Features.Generate"
    xmlns:sourceSelection="clr-namespace:ReplayFoundry.Desktop.Features.Generate.SourceSelection"
    d:DesignHeight="500"
    d:DesignWidth="980"
    Loaded="GenerateView_Loaded"
    SizeChanged="GenerateView_SizeChanged"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <!-- Source-selection workflow state. -->
            <sourceSelection:SourceSelectionView>

            <sourceSelection:SourceSelectionView.Style>

                <Style TargetType="{x:Type sourceSelection:SourceSelectionView}">

                    <Setter Property="Visibility" Value="Visible" />

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsSourceSelectionVisible}" Value="False">

                            <Setter Property="Visibility" Value="Collapsed" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </sourceSelection:SourceSelectionView.Style>

            </sourceSelection:SourceSelectionView>

            <!-- Running, completed, failed, and cancelled workflow states. -->
            <progress:GenerationProgressView
                DataContext="{Binding GenerationProgress}">

            <progress:GenerationProgressView.Style>

                <Style TargetType="{x:Type progress:GenerationProgressView}">

                    <Setter Property="Visibility" Value="Collapsed" />

                    <Style.Triggers>

                        <DataTrigger
                            Binding="{Binding DataContext.IsProgressVisible, ElementName=GenerateViewRoot}"
                            Value="True">

                            <Setter Property="Visibility" Value="Visible" />

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </progress:GenerationProgressView.Style>

            </progress:GenerationProgressView>
        </Grid>

        <Grid
            Grid.Row="1"
            MaxWidth="1280"
            Margin="20,0,20,8"
            HorizontalAlignment="Stretch">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompactLayout, RelativeSource={RelativeSource AncestorType={x:Type local:GenerateView}}}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{DynamicResource Control.SectionCard}" Padding="12,9">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="Recent Projects" />
                            <TextBlock
                                Margin="0,3,120,0"
                                Style="{DynamicResource Text.Meta}"
                                Text="Up to 10 saved Studio projects. Source videos, rendered Library files, and learned preferences stay separate."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            MinWidth="96"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            AutomationProperties.Name="Clear all recent Generate projects"
                            Command="{Binding ClearRecentProjectsCommand}"
                            Content="Clear all"
                            Style="{DynamicResource Control.DestructiveButton}" />
                    </Grid>
                    <TextBlock
                        Margin="0,3,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="Open a saved draft when its source is still available and unchanged. The oldest saved draft is removed when the ten-project limit is reached."
                        TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Text="No recent projects yet.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecentProjects}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="240" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="232"
                                    MinHeight="54"
                                    Margin="0,0,8,8"
                                    Padding="9,5"
                                    HorizontalContentAlignment="Left"
                                    Command="{Binding DataContext.OpenRecentProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource Control.ThemedButton}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="10" Opacity="0.72" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Meta}" Text="{Binding RecentProjectStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</UserControl>
