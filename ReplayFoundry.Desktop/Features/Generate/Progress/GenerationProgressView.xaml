<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Generate.Progress.GenerationProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System.Windows;assembly=PresentationFramework"
    d:DesignHeight="720"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="GenerationProgressStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="GenerationProgress.LogoAssemblyMotion" RepeatBehavior="Forever">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoUpperTransform" Storyboard.TargetProperty="X" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-18" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.55" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.45" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-18" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoUpperTransform" Storyboard.TargetProperty="Y" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-14" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.55" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.45" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-14" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLeftTransform" Storyboard.TargetProperty="X" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.8" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.25" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLowerTransform" Storyboard.TargetProperty="X" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.05" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoLowerTransform" Storyboard.TargetProperty="Y" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="16" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.05" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="16" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoRightTransform" Storyboard.TargetProperty="X" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="20" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.78" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.22" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="20" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoRightTransform" Storyboard.TargetProperty="Y" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-14" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:0.78" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.22" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:4" Value="-14" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LogoSignal" Storyboard.TargetProperty="Opacity" Duration="0:0:4">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:1.05" Value="0" />
                    <SplineDoubleKeyFrame KeySpline="0.2,0.8,0.2,1" KeyTime="0:0:1.32" Value="1" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:3.05" Value="1" />
                    <SplineDoubleKeyFrame KeySpline="0.4,0,0.8,0.2" KeyTime="0:0:3.65" Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="GenerationProgressScrollViewer"
        CanContentScroll="False"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        PanningMode="VerticalOnly"
        VerticalContentAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">

        <Grid MinHeight="{Binding ViewportHeight, ElementName=GenerationProgressScrollViewer}">
            <Grid Margin="20">
                <Border Style="{StaticResource GenerationProgress.AmbientFrame}" />

                <Border Style="{StaticResource GenerationProgress.MainPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="SignalCanvas"
                                Width="220"
                                Height="220"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <Ellipse
                                    Width="196"
                                    Height="196"
                                    Stroke="{DynamicResource Brush.BorderSubtle}"
                                    StrokeThickness="1" />
                                <Ellipse
                                    x:Name="PulseRing"
                                    Width="154"
                                    Height="154"
                                    Opacity="0.72"
                                    Stroke="{DynamicResource Brush.BrandCyan}"
                                    StrokeThickness="1.5"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRunning}" Value="True" />
                                                        <Condition Binding="{Binding Source={x:Static system:SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="PulseMotion">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.72" To="0.14" AutoReverse="True" Duration="0:0:1.4" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.84" To="1.08" AutoReverse="True" Duration="0:0:1.4" />
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.84" To="1.08" AutoReverse="True" Duration="0:0:1.4" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseMotion" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="PulseScale" ScaleX="0.84" ScaleY="0.84" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    Width="178"
                                    Height="178"
                                    Stroke="{DynamicResource Brush.BrandCyan}"
                                    StrokeDashArray="2 9"
                                    StrokeThickness="3"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRunning}" Value="True" />
                                                        <Condition Binding="{Binding Source={x:Static system:SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="OrbitMotion">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="OrbitMotion" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="OrbitTransform" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse
                                    x:Name="CoreGlow"
                                    Width="106"
                                    Height="106"
                                    Fill="{StaticResource Brush.GenerationProgressSignalGlow}"
                                    Opacity="0.4">
                                    <Ellipse.Style>
                                        <Style TargetType="{x:Type Ellipse}">
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRunning}" Value="True" />
                                                        <Condition Binding="{Binding Source={x:Static system:SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard x:Name="GlowMotion">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.38" To="0.86" AutoReverse="True" Duration="0:0:0.9" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="GlowMotion" />
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Border
                                    Width="90"
                                    Height="90"
                                    Background="{StaticResource Brush.GenerationProgressCore}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1.5"
                                    CornerRadius="22">
                                    <Canvas
                                        Width="56"
                                        Height="56"
                                        AutomationProperties.Name="Replay Foundry logo assembling">
                                        <Border
                                            Width="25"
                                            Height="25"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoUpperTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="25"
                                            Height="24"
                                            Canvas.Left="0"
                                            Canvas.Top="32"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoLeftTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="24"
                                            Height="32"
                                            Canvas.Left="32"
                                            Canvas.Top="24"
                                            Background="{DynamicResource Brush.BrandCyan}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoLowerTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            Width="24"
                                            Height="18"
                                            Canvas.Left="32"
                                            Canvas.Top="0"
                                            Background="{DynamicResource Brush.BrandBlue}"
                                            CornerRadius="2"
                                            RenderOptions.EdgeMode="Aliased">
                                            <Border.RenderTransform>
                                                <TranslateTransform x:Name="LogoRightTransform" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border
                                            x:Name="LogoSignal"
                                            Width="9"
                                            Height="9"
                                            Canvas.Left="9"
                                            Canvas.Top="9"
                                            Background="{DynamicResource Brush.BrandYellow}"
                                            CornerRadius="1"
                                            RenderOptions.EdgeMode="Aliased" />
                                    </Canvas>
                                </Border>
                            </Grid>

                            <Border Grid.Column="1" Style="{StaticResource GenerationProgress.StagePanel}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.BrandCyan}"
                                        Text="LOCAL CREATIVE PASS"
                                        TextOptions.TextFormattingMode="Display" />
                                    <TextBlock
                                        Margin="0,10,0,0"
                                        FontSize="32"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Brush.TextPrimary}"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        MaxWidth="590"
                                        Margin="0,12,0,0"
                                        FontSize="15"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        LineHeight="23"
                                        Text="{Binding Detail}"
                                        TextWrapping="Wrap" />
                                    <Border Margin="0,20,0,0" Style="{StaticResource GenerationProgress.LocalStatus}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.BrandGreen}" />
                                            <TextBlock
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                Text="Working locally · your source video stays on this device" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,26,0,0" Style="{StaticResource GenerationProgress.InfoCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GenerationProgress.MetaLabel}" Text="CREATING" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource GenerationProgress.MetaValue}" Text="{Binding ModeDisplayName}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource GenerationProgress.MetaLabel}" Text="FROM" />
                                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right" Style="{StaticResource GenerationProgress.MetaValue}" Text="{Binding SourceSummary}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,22,0,0">
                            <ProgressBar
                                IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}"
                                Style="{StaticResource GenerationProgress.ProgressBar}"
                                Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <Grid Margin="0,10,0,0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    FontSize="12"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="{Binding SourceProgressText}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSourceProgress}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <Border Grid.Row="3">
                            <Border.Style>
                                <Style BasedOn="{StaticResource GenerationProgress.ErrorPanel}" TargetType="{x:Type Border}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ValidationErrorText}" Text="What happened" />
                                <TextBlock Margin="0,7,0,0" FontSize="13" Foreground="{DynamicResource Brush.ValidationErrorText}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                                <Expander Margin="0,11,0,0" Foreground="{DynamicResource Brush.TextSecondary}" Header="Technical details" Style="{DynamicResource Control.DisclosureExpander}">
                                    <TextBox
                                        MaxHeight="170"
                                        Margin="0,8,0,0"
                                        Padding="10"
                                        Background="{DynamicResource Brush.SurfaceCanvas}"
                                        BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        Foreground="{DynamicResource Brush.TextSecondary}"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsReadOnly="True"
                                        Text="{Binding TechnicalDetails, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        VerticalScrollBarVisibility="Auto" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4" Margin="0,25,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" HorizontalAlignment="Stretch">
                                <Border.Style>
                                    <Style BasedOn="{StaticResource GenerationProgress.CompletionCard}" TargetType="{x:Type Border}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock HorizontalAlignment="Center" FontSize="14" Foreground="{DynamicResource Brush.TextPrimary}" Text="{Binding CompletionSummary}" TextAlignment="Center" TextWrapping="Wrap" />
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                <Button Command="{Binding CancelCommand}" Content="{Binding CancelButtonLabel}">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource GenerationProgress.SecondaryButton}" TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Margin="0,0,10,0" Command="{Binding OpenStudioCommand}" Content="Open in Studio">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource GenerationProgress.PrimaryButton}" TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanOpenStudio}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding ReturnToSourceSelectionCommand}" Content="Back to Source Selection">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource GenerationProgress.SecondaryButton}" TargetType="{x:Type Button}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanReturnToSourceSelection}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
