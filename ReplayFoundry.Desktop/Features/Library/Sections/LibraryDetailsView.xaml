<UserControl
    x:Class="ReplayFoundry.Desktop.Features.Library.Sections.LibraryDetailsView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    Focusable="True"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    IsVisibleChanged="OnIsVisibleChanged"
    DataContextChanged="OnDataContextChanged"
    PreviewMouseDown="OnPreviewMouseDown">
    <UserControl.InputBindings>
        <KeyBinding Key="Space" Command="{Binding Playback.PlayPauseCommand}" />
        <KeyBinding Key="Left" Command="{Binding Playback.RewindCommand}" />
        <KeyBinding Key="Right" Command="{Binding Playback.ForwardCommand}" />
    </UserControl.InputBindings>
    <Border Style="{DynamicResource Control.CanvasPane}" AutomationProperties.Name="Library details and video preview">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Style="{DynamicResource Text.SectionTitle}" Text="PREVIEW &amp; DETAILS" />
            <Grid Grid.Row="1" Margin="0,12,0,0">
                <ScrollViewer
                    x:Name="DetailsScrollViewer"
                    CanContentScroll="False"
                    HorizontalScrollBarVisibility="Disabled"
                    PanningMode="VerticalOnly"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,0,8,0">
                    <Border
                        MinHeight="168"
                        MaxWidth="460"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource Brush.CompositionCanvas}"
                        BorderBrush="Transparent"
                        BorderThickness="0"
                        CornerRadius="{DynamicResource Radius.OrganicCard}">
                        <Grid>
                            <MediaElement
                                x:Name="PreviewPlayer"
                                AutomationProperties.Name="Selected Library video preview"
                                LoadedBehavior="Manual"
                                MediaEnded="PreviewPlayer_OnMediaEnded"
                                MediaFailed="PreviewPlayer_OnMediaFailed"
                                MediaOpened="PreviewPlayer_OnMediaOpened"
                                ScrubbingEnabled="True"
                                Stretch="Uniform"
                                UnloadedBehavior="Manual" />
                            <StackPanel
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Playback.IsAvailable, Converter={StaticResource InverseBoolToVisibility}}">
                                <controls:IconPath
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    IconKey="Icon.Media"
                                    Stroke="{DynamicResource Brush.TextMuted}" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{DynamicResource Brush.TextSecondary}"
                                    Text="Preview unavailable"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid
                        Margin="0,10,0,0"
                        Visibility="{Binding Playback.IsAvailable, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Slider
                            x:Name="PreviewPositionSlider"
                            AutomationProperties.Name="Library video timeline"
                            Maximum="{Binding Playback.DurationSeconds}"
                            Minimum="0"
                            PreviewMouseLeftButtonDown="PreviewPosition_OnPreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="PreviewPosition_OnPreviewMouseLeftButtonUp"
                            LostMouseCapture="PreviewPosition_OnLostMouseCapture"
                            Value="{Binding Playback.PositionSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="32"
                                    Height="32"
                                    AutomationProperties.Name="Rewind Library video five seconds"
                                    Command="{Binding Playback.RewindCommand}"
                                    Content="Icon.Rewind"
                                    ContentTemplate="{StaticResource IconButtonContentTemplate}"
                                    Style="{DynamicResource Control.IconButton}"
                                    ToolTip="Back 5 seconds" />
                                <Button
                                    Width="36"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="{Binding Playback.PlayPauseText}"
                                    Command="{Binding Playback.PlayPauseCommand}"
                                    Content="{Binding Playback.PlayPauseIconKey}"
                                    ContentTemplate="{StaticResource IconButtonContentTemplate}"
                                    Style="{DynamicResource Control.IconButton}"
                                    ToolTip="{Binding Playback.PlayPauseText}" />
                                <Button
                                    Width="32"
                                    Height="32"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Forward Library video five seconds"
                                    Command="{Binding Playback.ForwardCommand}"
                                    Content="Icon.FastForward"
                                    ContentTemplate="{StaticResource IconButtonContentTemplate}"
                                    Style="{DynamicResource Control.IconButton}"
                                    ToolTip="Forward 5 seconds" />
                            </StackPanel>
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                Foreground="{DynamicResource Brush.TextPrimary}">
                                <Run Text="{Binding Playback.PositionText, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding Playback.DurationText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{DynamicResource Text.Meta}"
                        Text="{Binding Playback.StatusText}"
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,14,0,0" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="{Binding SelectedItem.Title}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" Style="{DynamicResource Text.Body}" Text="{Binding SelectedItem.Detail}" TextWrapping="Wrap" />
                    <Border Margin="0,12,0,0" Style="{DynamicResource Control.CanvasFilterPane}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Text.Meta}"><Run Text="Status: " /><Run x:Name="SelectedStatusRun" Text="{Binding SelectedItem.Status, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}"><Run Text="Aspect: " /><Run x:Name="SelectedAspectRatioRun" Text="{Binding SelectedItem.AspectRatio, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}"><Run Text="Duration: " /><Run x:Name="SelectedDurationRun" Text="{Binding SelectedItem.Duration, Mode=OneWay}" /></TextBlock>
                            <TextBlock Margin="0,4,0,0" Style="{DynamicResource Text.Meta}"><Run Text="Modified: " /><Run x:Name="SelectedModifiedRun" Text="{Binding SelectedItem.Modified, Mode=OneWay}" /></TextBlock>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button
                            Margin="0,0,8,8"
                            AutomationProperties.Name="Open selected clip folder"
                            Command="{Binding OpenSelectedFolderCommand}"
                            Content="Open folder"
                            Style="{DynamicResource Control.PrimaryButton}" />
                        <Button
                            Margin="0,0,0,8"
                            AutomationProperties.Name="Relink missing rendered clip"
                            Command="{Binding RelinkMissingFileCommand}"
                            Content="Relink moved file"
                            Visibility="{Binding CanRelinkSelected, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                    <Border
                        Margin="0,4,0,0"
                        Style="{DynamicResource Control.InsetCard}"
                        Visibility="{Binding HasLibraryNotice, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            Style="{DynamicResource Text.Body}"
                            Text="{Binding LibraryNotice}"
                            TextWrapping="Wrap" />
                    </Border>
                    </StackPanel>
                </ScrollViewer>
                <controls:EmptyState
                    Title="Select an item"
                    Description="Choose a finished video to preview, inspect, or open its local folder."
                    Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
