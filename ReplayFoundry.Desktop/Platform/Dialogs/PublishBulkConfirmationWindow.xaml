<Window
    x:Class="ReplayFoundry.Desktop.Platform.Dialogs.PublishBulkConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Publish all now" Width="540" Height="320" ResizeMode="NoResize"
    ShowInTaskbar="False" WindowStartupLocation="CenterOwner" WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <controls:WindowTitleBar Subtitle="YouTube" Status="Public upload confirmation" />
        <Border Grid.Row="1" Padding="24" Background="{DynamicResource Brush.WindowFallback}" CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Text.DialogTitle}" Text="Publish every saved draft now?" />
                <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{DynamicResource Text.Body}" Text="{Binding Summary}" TextWrapping="Wrap" />
                <Border Grid.Row="2" Margin="0,16,0,0" Style="{DynamicResource Control.InsetCard}"><TextBlock Style="{DynamicResource Text.Body}" Text="This ignores each saved release date, changes visibility to Public, and uploads one video at a time. You can cancel the active upload." TextWrapping="Wrap" /></Border>
                <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="100" Click="Cancel_Click" Content="Keep schedule" Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button MinWidth="140" Margin="10,0,0,0" Click="Confirm_Click" Content="Publish all now" Style="{DynamicResource Control.PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
