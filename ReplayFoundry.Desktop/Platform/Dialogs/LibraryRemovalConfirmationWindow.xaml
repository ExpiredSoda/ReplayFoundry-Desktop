<Window
    x:Class="ReplayFoundry.Desktop.Platform.Dialogs.LibraryRemovalConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Remove from Library"
    Width="520"
    Height="300"
    MinWidth="460"
    MinHeight="280"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowTitleBar Subtitle="Library" Status="Safe removal" />
        <Border Grid.Row="1" Padding="24" Background="{DynamicResource Brush.WindowFallback}" CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Text.DialogTitle}" Text="Remove from Library?" />
                <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{DynamicResource Text.Body}" Text="{Binding Summary}" TextWrapping="Wrap" />
                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,12" Style="{DynamicResource Control.InsetCard}">
                    <StackPanel Orientation="Horizontal">
                        <controls:IconPath Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" IconKey="Icon.Info" Stroke="{DynamicResource Brush.StatusInfo}" />
                        <TextBlock VerticalAlignment="Center" Style="{DynamicResource Text.Body}" Text="Only the Library record will be removed. Your rendered video files will stay on disk." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="112" Click="Cancel_Click" Content="Keep videos" Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button MinWidth="150" Margin="10,0,0,0" Click="Remove_Click" Content="Remove from Library" Style="{DynamicResource Control.DestructiveButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
