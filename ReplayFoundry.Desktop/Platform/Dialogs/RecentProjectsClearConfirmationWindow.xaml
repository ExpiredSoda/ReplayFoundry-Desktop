<Window
    x:Class="ReplayFoundry.Desktop.Platform.Dialogs.RecentProjectsClearConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Clear recent projects"
    Width="580"
    Height="360"
    MinWidth="520"
    MinHeight="330"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowTitleBar Subtitle="Generate" Status="Recent projects" />
        <Border Grid.Row="1" Padding="24" Background="{DynamicResource Brush.WindowFallback}" CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Text.DialogTitle}" Text="Clear all recent projects?" />
                <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{DynamicResource Text.Body}" Text="{Binding Summary}" TextWrapping="Wrap" />
                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,12" Style="{DynamicResource Control.InsetCard}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="What this removes" />
                        <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Body}" Text="Recent-project shortcuts and their saved Studio drafts, including draft titles, descriptions, captions, and edits." TextWrapping="Wrap" />
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.StatusInfo}" Style="{DynamicResource Text.Meta}" Text="Source videos, completed Library renders, installed models, and learned feedback preferences from like, neutral, or dislike choices are not removed." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="112" Click="Cancel_Click" Content="Keep projects" Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button MinWidth="150" Margin="10,0,0,0" Click="Clear_Click" Content="Clear recent projects" Style="{DynamicResource Control.DestructiveButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
