<Window
    x:Class="ReplayFoundry.Desktop.Platform.Dialogs.LocalDataCleanupConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Remove local Replay Foundry data"
    Width="600"
    Height="410"
    MinWidth="520"
    MinHeight="360"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:WindowTitleBar Subtitle="Settings" Status="Local data" />
        <Border Grid.Row="1" Padding="24" Background="{DynamicResource Brush.WindowFallback}" CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{DynamicResource Text.DialogTitle}" Text="Remove the selected local data?" />
                <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{DynamicResource Text.Body}" Text="Nothing is removed yet. Replay Foundry will delete the items below the next time it starts." TextWrapping="Wrap" />
                <Border Grid.Row="2" Margin="0,16,0,0" Padding="14,12" Style="{DynamicResource Control.InsetCard}">
                    <StackPanel>
                        <TextBlock Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Text="Data that will be deleted" />
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,3,0,0" Style="{DynamicResource Text.Body}" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource Brush.StatusInfo}" Style="{DynamicResource Text.Meta}" Text="Rendered video files and installed tools/models are never deleted. Library records and Studio projects are kept unless they are explicitly listed above." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="112" Click="Cancel_Click" Content="Cancel" Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button MinWidth="150" Margin="10,0,0,0" Click="Schedule_Click" Content="Delete on next start" Style="{DynamicResource Control.DestructiveButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
