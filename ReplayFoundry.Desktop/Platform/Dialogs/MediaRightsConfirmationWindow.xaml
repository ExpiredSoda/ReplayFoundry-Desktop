<Window
    x:Class="ReplayFoundry.Desktop.Platform.Dialogs.MediaRightsConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ReplayFoundry.Desktop.Presentation.Controls"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:windowing="clr-namespace:ReplayFoundry.Desktop.Shell.Windowing"
    Title="Confirm media rights"
    Width="620"
    Height="440"
    MinWidth="560"
    MinHeight="420"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    Background="{DynamicResource Brush.WindowFallback}"
    Icon="pack://application:,,,/Assets/Icons/Application/ReplayFoundry.ico"
    shell:WindowChrome.WindowChrome="{DynamicResource ReplayFoundry.WindowChrome}"
    windowing:WindowChromeInteraction.Attach="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:WindowTitleBar Subtitle="Generate" Status="Media rights confirmation" />

        <Border
            Grid.Row="1"
            Padding="26,22,26,24"
            Background="{DynamicResource Brush.WindowFallback}"
            CornerRadius="0,0,14,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="42"
                        Height="42"
                        Margin="0,0,12,0"
                        Background="{DynamicResource Brush.InteractiveSelected}"
                        BorderBrush="{DynamicResource Brush.StatusInfo}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <controls:IconPath
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IconKey="Icon.Lock"
                            Stroke="{DynamicResource Brush.StatusInfo}"
                            StrokeThickness="1.25"
                            Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            Style="{DynamicResource Text.DialogTitle}"
                            Text="Confirm your right to use this media" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{DynamicResource Text.Body}"
                            Text="Continue only with recordings you own or have permission to edit and republish."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="0,18,0,0"
                    Padding="14,12"
                    Style="{DynamicResource Control.InsetCard}">
                    <StackPanel>
                        <TextBlock
                            Foreground="{DynamicResource Brush.TextPrimary}"
                            FontWeight="SemiBold"
                            Text="{Binding SelectionSummary}" />
                        <ScrollViewer
                            MaxHeight="58"
                            Margin="0,5,0,0"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SourceNames}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{DynamicResource Text.Meta}"
                                            Text="{Binding StringFormat=•  {0}}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="2"
                    Margin="0,14,0,0"
                    Padding="14,12"
                    Background="{DynamicResource Brush.SurfacePanel}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <StackPanel>
                        <TextBlock Style="{DynamicResource Text.Meta}" Text="What this confirmation means" FontWeight="SemiBold" />
                        <TextBlock Margin="0,7,0,0" Style="{DynamicResource Text.Body}" Text="•  The selected files stay on this PC while Replay Foundry processes them." TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Body}" Text="•  You are responsible for having permission to edit and publish the media." TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0" Style="{DynamicResource Text.Body}" Text="•  YouTube and other destination-platform terms still apply." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel
                    Grid.Row="3"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        MinWidth="100"
                        Click="Cancel_Click"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{DynamicResource Control.WorkspaceButton}" />
                    <Button
                        MinWidth="185"
                        Margin="10,0,0,0"
                        Click="Confirm_Click"
                        Content="Confirm and continue"
                        IsDefault="True"
                        Style="{DynamicResource Control.PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
